{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "safewebhook",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },

  // ─── Custom Domain Routes for Production ─────────────────────────────────────
  "routes": [
    {
      "pattern": "safewebhook.com",
      "custom_domain": true
    },
    {
      "pattern": "www.safewebhook.com",
      "custom_domain": true
    }
  ],

  // ─── Cloudflare D1 SQLite Database ──────────────────────────────────────────
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "safewebhook-db",
      "database_id": "<YOUR_D1_DATABASE_ID>"
    }
  ],

  // ─── Cloudflare KV Namespace ─────────────────────────────────────────────────
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "<YOUR_KV_NAMESPACE_ID>"
    }
  ],

  // ─── Environment Variables ───────────────────────────────────────────────────
  "vars": {
    "APP_ENV": "production",
    "APP_VERSION": "1.0.0"
  }
}

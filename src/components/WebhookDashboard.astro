        title="View integration guides and docs"
      >
        <span>Docs</span>
      </a>

      <!-- FAQ Shortcut Link -->
      <a
        href="/faq"
        class="h-8 sm:h-9 px-2 rounded-lg bg-slate-800/50 hover:bg-slate-800 text-slate-400 hover:text-cyan-300 border border-slate-700/60 text-xs font-medium inline-flex items-center gap-1 transition-colors"
        title="Frequently asked questions"

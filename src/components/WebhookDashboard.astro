<!-- ========================================================================= -->
<!-- COMPREHENSIVE CLIENT-SIDE JAVASCRIPT LOGIC ENGINE                         -->
<!-- ========================================================================= -->
<script is:inline>
  (function () {
    // ═══════════════════════════════════════════
    // SHARED STATE OBJECT (avoids TDZ with let)
    // ═══════════════════════════════════════════
    var _state = {
      webhooks: [],
      selectedWebhookId: null,
      eventSource: null,
      activeFilter: 'ALL',
      currentTab: 'body',
      activeCodeLang: 'curl',
      pollInterval: null
    };

    // ═══════════════════════════════════════════
    // HOISTED GLOBAL FUNCTIONS (available everywhere)
    // ═══════════════════════════════════════════

    function switchInspectorTab(tabId) {
      _state.currentTab = tabId;
      document.querySelectorAll('.tab-btn').forEach(function(btn) {
        if (btn.getAttribute('data-tab') === tabId) {
          btn.className = 'tab-btn py-3 border-b-2 border-cyan-400 text-cyan-300 font-semibold active-tab flex items-center gap-1.5 cursor-pointer';
        } else {
          btn.className = 'tab-btn py-3 border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition-colors flex items-center gap-1.5 cursor-pointer';
        }
      });
      document.querySelectorAll('.tab-panel').forEach(function(panel) { panel.classList.add('hidden'); });
      var activePanel = document.getElementById('tab-panel-' + tabId);
      if (activePanel) activePanel.classList.remove('hidden');
    }
    window.switchInspectorTab = switchInspectorTab;

    function openAppModal(modalId) {
      var modalEl = document.getElementById(modalId);
      if (modalEl) modalEl.classList.remove('hidden');
      if (modalId === 'code-modal' && typeof renderExportCode === 'function') renderExportCode();
    }
    window.openAppModal = openAppModal;

    function closeAppModal(modalId) {
      var modalEl = document.getElementById(modalId);
      if (modalEl) modalEl.classList.add('hidden');
    }
    window.closeAppModal = closeAppModal;

    // ═══════════════════════════════════════════
    // 1. Session Endpoint Identifier Resolution
    // ═══════════════════════════════════════════
    const STORAGE_KEY_ENDPOINT = 'wh_active_endpoint_id';
    const STORAGE_KEY_PAYLOADS = 'wh_captured_payloads_';

    const urlParams = new URLSearchParams(window.location.search);
    let activeEndpointId = urlParams.get('ep') || localStorage.getItem(STORAGE_KEY_ENDPOINT);
    if (!activeEndpointId || activeEndpointId.length < 4) {
      activeEndpointId = 'ep_' + Math.random().toString(36).substring(2, 9);
    }
    localStorage.setItem(STORAGE_KEY_ENDPOINT, activeEndpointId);

    // State Variables (aliases for _state - backwards compat with rest of code)
    let webhooks = _state.webhooks;
    let selectedWebhookId = _state.selectedWebhookId;
    let eventSource = _state.eventSource;
    let activeFilter = _state.activeFilter;
    let currentTab = _state.currentTab;
    let activeCodeLang = _state.activeCodeLang;
    let pollInterval = _state.pollInterval;

    // DOM Elements
    const endpointUrlInput = document.getElementById('endpoint-url-input');
    const endpointEmailInput = document.getElementById('endpoint-email-input');
    const copyLinkBtn = document.getElementById('copy-link-btn');
    const copyEmailBtn = document.getElementById('copy-email-btn');
    const webhookCountBadge = document.getElementById('webhook-count-badge');
    const searchInput = document.getElementById('search-input');
    const timelineList = document.getElementById('timeline-list');
    const timelineEmptyState = document.getElementById('timeline-empty-state');
    const inspectorZeroState = document.getElementById('inspector-zero-state');
    const inspectorHeaderBar = document.getElementById('inspector-header-bar');
    const inspectorTabsNav = document.getElementById('inspector-tabs-nav');
    const clearLogsBtn = document.getElementById('clear-logs-btn');
    const exportSessionBtn = document.getElementById('export-session-btn');
    const copyCurlBtn = document.getElementById('copy-curl-btn');
    const copyBodyBtn = document.getElementById('copy-body-btn');

    // Modals
    const configModal = document.getElementById('config-modal');
    const workflowModal = document.getElementById('workflow-modal');
    const monitorModal = document.getElementById('monitor-modal');
    const domainModal = document.getElementById('domain-modal');
    const replayModal = document.getElementById('replay-modal');
    const codeModal = document.getElementById('code-modal');
    const mockModal = document.getElementById('mock-modal');

    // Configure URLs in UI
    const origin = window.location.origin;
    const fullWebhookUrl = `${origin}/api/r/${activeEndpointId}`;
    const fullEmailAddress = `${activeEndpointId}@safewebhook.com`;
    if (endpointUrlInput) endpointUrlInput.value = fullWebhookUrl;
    if (endpointEmailInput) endpointEmailInput.value = fullEmailAddress;

    const zeroStateUrlInput = document.getElementById('zero-state-url-input');
    if (zeroStateUrlInput) zeroStateUrlInput.value = fullWebhookUrl;

    const sampleCurlCommand = `curl -X POST ${fullWebhookUrl} \\\n  -H "Content-Type: application/json" \\\n  -H "Stripe-Signature: t=${Math.floor(Date.now() / 1000)},v1=98a3c4f912e742c..." \\\n  -d '{"event": "payment_intent.succeeded", "amount": 4900, "currency": "usd"}'`;

    const zeroStateCurlCode = document.getElementById('zero-state-curl-code');
    if (zeroStateCurlCode) zeroStateCurlCode.textContent = sampleCurlCommand;

    // Clipboard Copy Helper with Visual Feedback
    async function copyToClipboard(text, labelElement, originalText = 'Copy') {
      try {
        await navigator.clipboard.writeText(text);
        if (labelElement) {
          labelElement.textContent = 'Copied!';
          setTimeout(() => {
            labelElement.textContent = originalText;
          }, 2000);
        }
      } catch (err) {
        const input = document.createElement('input');
        input.value = text;
        document.body.appendChild(input);
        input.select();
        document.execCommand('copy');
        document.body.removeChild(input);
        if (labelElement) {
          labelElement.textContent = 'Copied!';
          setTimeout(() => {
            labelElement.textContent = originalText;
          }, 2000);
        }
      }
    }

    const copyLinkText = document.getElementById('copy-link-text');
    if (copyLinkBtn) {
      copyLinkBtn.addEventListener('click', () => copyToClipboard(fullWebhookUrl, copyLinkText, 'Copy'));
    }

    const copyEmailText = copyEmailBtn?.querySelector('span');
    if (copyEmailBtn) {
      copyEmailBtn.addEventListener('click', () => copyToClipboard(fullEmailAddress, copyEmailText, 'Email'));
    }

    const zeroCopyText = document.getElementById('zero-copy-text');
    const zeroStateCopyUrlBtn = document.getElementById('zero-state-copy-url-btn');
    if (zeroStateCopyUrlBtn) {
      zeroStateCopyUrlBtn.addEventListener('click', () => copyToClipboard(fullWebhookUrl, zeroCopyText, 'Copy URL'));
    }

    const zeroCurlCopyText = document.getElementById('zero-curl-copy-text');
    const zeroStateCopyCurlBtn = document.getElementById('zero-state-copy-curl-btn');
    if (zeroStateCopyCurlBtn) {
      zeroStateCopyCurlBtn.addEventListener('click', () => copyToClipboard(sampleCurlCommand, zeroCurlCopyText, 'Copy cURL'));
    }

    // Direct Quick Mock Triggers (Instant Optimistic UI)
    function dispatchMockLocallyAndRemotely(type = 'stripe-pay') {
      let body = {};
      let headers = {
        'content-type': 'application/json',
        'user-agent': 'SafeWebhook-MockEngine/2.0'
      };
      let signatureProvider = null;

      if (type === 'stripe-pay' || type === 'stripe-sub') {
        signatureProvider = 'Stripe';
        headers['stripe-signature'] = 't=' + Math.floor(Date.now() / 1000) + ',v1=mock_sig_99a8b';
        body = {
          id: 'evt_stripe_' + Math.random().toString(36).substring(2, 8),
          object: 'event',
          type: type === 'stripe-sub' ? 'customer.subscription.created' : 'payment_intent.succeeded',
          data: { object: { id: 'pi_live_' + Math.random().toString(36).substring(2, 6), amount: 4900, currency: 'usd', status: 'succeeded' } }
        };
      } else if (type === 'github-push') {
        signatureProvider = 'GitHub';
        headers['x-hub-signature-256'] = 'sha256=mock_hub_sig_334';
        body = {
          ref: 'refs/heads/main',
          repository: { name: 'safewebhook', full_name: 'safewebhook/app' },
          pusher: { name: 'alex-developer', email: 'alex@safewebhook.com' }
        };
      } else if (type === 'shopify-order') {
        signatureProvider = 'Shopify';
        headers['x-shopify-hmac-sha256'] = 'mock_shopify_hmac_66';
        body = {
          id: 10928374,
          email: 'buyer@store.com',
          total_price: '149.00',
          currency: 'USD'
        };
      } else if (type === 'slack-action') {
        signatureProvider = 'Slack';
        headers['x-slack-signature'] = 'v0=mock_slack_sig_44';
        body = {
          type: 'block_actions',
          user: { id: 'U123456', username: 'alex' },
          actions: [{ action_id: 'approve_button', value: 'approved' }]
        };
      }

      const bodyStr = JSON.stringify(body, null, 2);
      const newEntry = {
        id: 'evt_' + Math.random().toString(36).substring(2, 9),
        endpoint_id: activeEndpointId,
        timestamp: new Date().toISOString(),
        method: 'POST',
        query_params: {},
        headers,
        body: bodyStr,
        size_bytes: bodyStr.length,
        format: 'json',
        signature_provider: signatureProvider,
        is_email: false,
        email: null
      };

      // 1. Instant local render
      webhooks.unshift(newEntry);
      saveToLocalStorage();
      renderTimeline();
      selectWebhook(newEntry.id);

      // 2. Fire across edge network in background
      fetch(fullWebhookUrl, {
        method: 'POST',
        headers,
        body: bodyStr
      }).catch(() => {});
    }

    const zeroStateMockBtn = document.getElementById('zero-state-mock-btn');
    if (zeroStateMockBtn) {
      zeroStateMockBtn.addEventListener('click', () => dispatchMockLocallyAndRemotely('stripe-pay'));
    }

    const emptyMockTrigger = document.getElementById('empty-mock-trigger');
    if (emptyMockTrigger) {
      emptyMockTrigger.addEventListener('click', () => dispatchMockLocallyAndRemotely('stripe-pay'));
    }

    // Load Local Storage Payloads
    try {
      const stored = localStorage.getItem(STORAGE_KEY_PAYLOADS + activeEndpointId);
      if (stored) {
        webhooks = JSON.parse(stored);
      }
    } catch (e) {
      webhooks = [];
    }

    // Initialize UI
    renderTimeline();
    if (webhooks.length > 0) {
      selectWebhook(webhooks[0].id);
    }

    // Polling & Syncing Definitions
    async function initialSync() {
      try {
        const res = await fetch(`/api/poll/${activeEndpointId}`);
        if (!res.ok) return;
        const data = await res.json();
        if (data.events && Array.isArray(data.events) && data.events.length > 0) {
          let changed = false;
          for (let i = data.events.length - 1; i >= 0; i--) {
            const ev = data.events[i];
            if (!webhooks.some((w) => w.id === ev.id)) {
              webhooks.unshift(ev);
              changed = true;
            }
          }
          if (changed) {
            saveToLocalStorage();
            renderTimeline();
            if (!selectedWebhookId && webhooks.length > 0) {
              selectWebhook(webhooks[0].id);
            }
          }
        }
      } catch (e) {}
    }

    function startPolling() {
      if (pollInterval) clearInterval(pollInterval);
      pollInterval = setInterval(async () => {
        try {
          const res = await fetch(`/api/poll/${activeEndpointId}`);
          if (!res.ok) return;
          const data = await res.json();
          if (data.events && Array.isArray(data.events) && data.events.length > 0) {
            let changed = false;
            for (let i = data.events.length - 1; i >= 0; i--) {
              const ev = data.events[i];
              if (!webhooks.some((w) => w.id === ev.id)) {
                webhooks.unshift(ev);
                changed = true;
              }
            }
            if (changed) {
              saveToLocalStorage();
              renderTimeline();
              if (!selectedWebhookId && webhooks.length > 0) {
                selectWebhook(webhooks[0].id);
              }
            }
          }
        } catch (e) {}
      }, 1500);
    }

    // Connect SSE Stream & Resilient Edge Poller
    connectEventSource();
    startPolling();
    initialSync();

    function connectEventSource() {
      if (eventSource) {
        eventSource.close();
      }

      eventSource = new EventSource(`/api/stream/${activeEndpointId}`);

      eventSource.onopen = () => {
        const ping = document.getElementById('conn-ping');
        const dot = document.getElementById('conn-dot');
        const text = document.getElementById('conn-text');
        if (ping) ping.className = 'animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75';
        if (dot) dot.className = 'relative inline-flex rounded-full h-2 w-2 bg-emerald-500';
        if (text) text.textContent = 'Live SSE Stream';
      };

      eventSource.onmessage = (event) => {
        try {
          const data = JSON.parse(event.data);
          if (data.type === 'connected' || data.type === 'ping') return;

          // Ingest new payload
          const newEntry = {
            id: data.id || 'evt_' + Math.random().toString(36).substring(2, 9),
            endpoint_id: activeEndpointId,
            timestamp: data.timestamp || new Date().toISOString(),
            method: data.method || 'POST',
            query_params: data.query_params || {},
            headers: data.headers || {},
            body: data.body || '',
            size_bytes: data.size_bytes || (data.body ? data.body.length : 0),
            format: data.format || 'json',
            signature_provider: data.signature_provider || null,
            is_email: data.is_email || false,
            email: data.email || null,
          };

          webhooks.unshift(newEntry);
          saveToLocalStorage();
          renderTimeline();

          // If first item or none selected, select it
          if (!selectedWebhookId || webhooks.length === 1) {
            selectWebhook(newEntry.id);
          }
        } catch (err) {
          console.error('Failed to parse SSE chunk:', err);
        }
      };

      eventSource.onerror = () => {
        const dot = document.getElementById('conn-dot');
        const text = document.getElementById('conn-text');
        if (dot) dot.className = 'relative inline-flex rounded-full h-2 w-2 bg-amber-500';
        if (text) text.textContent = 'Reconnecting...';
      };
    }

    function saveToLocalStorage() {
      try {
        localStorage.setItem(STORAGE_KEY_PAYLOADS + activeEndpointId, JSON.stringify(webhooks.slice(0, 100)));
      } catch (e) {}
    }

    function renderTimeline() {
      if (webhookCountBadge) webhookCountBadge.textContent = webhooks.length;

      const searchTerm = (searchInput?.value || '').toLowerCase().trim();

      const filtered = webhooks.filter((wh) => {
        if (activeFilter === 'EMAIL' && !wh.is_email) return false;
        if (activeFilter !== 'ALL' && activeFilter !== 'EMAIL' && wh.method !== activeFilter) return false;
        if (!searchTerm) return true;

        const bodyStr = String(wh.body || '').toLowerCase();
        const headerStr = JSON.stringify(wh.headers || {}).toLowerCase();
        const methodStr = String(wh.method || '').toLowerCase();
        return bodyStr.includes(searchTerm) || headerStr.includes(searchTerm) || methodStr.includes(searchTerm);
      });

      if (filtered.length === 0) {
        if (timelineEmptyState) timelineEmptyState.classList.remove('hidden');
        if (timelineList) timelineList.innerHTML = '';
        return;
      }

      if (timelineEmptyState) timelineEmptyState.classList.add('hidden');

      if (!timelineList) return;
      timelineList.innerHTML = filtered
        .map((wh) => {
          const isSelected = wh.id === selectedWebhookId;
          const time = new Date(wh.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
          const sizeKb = (wh.size_bytes / 1024).toFixed(1);

          let methodColor = 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20';
          if (wh.is_email || wh.method === 'EMAIL') methodColor = 'text-purple-400 bg-purple-500/10 border-purple-500/20';
          else if (wh.method === 'GET') methodColor = 'text-sky-400 bg-sky-500/10 border-sky-500/20';
          else if (wh.method === 'PUT') methodColor = 'text-amber-400 bg-amber-500/10 border-amber-500/20';
          else if (wh.method === 'DELETE') methodColor = 'text-rose-400 bg-rose-500/10 border-rose-500/20';
          else if (wh.method === 'PATCH') methodColor = 'text-purple-400 bg-purple-500/10 border-purple-500/20';

          let summary = wh.is_email ? (wh.email?.subject || 'Inbound Email') : 'Request';
          if (!wh.is_email && wh.body) {
            try {
              const parsed = JSON.parse(wh.body);
              if (parsed.type) summary = parsed.type;
              else if (parsed.event) summary = parsed.event;
              else if (parsed.topic) summary = parsed.topic;
            } catch (e) {}
          }

          return `
            <li class="timeline-item p-3 cursor-pointer transition-colors ${isSelected ? 'bg-slate-850/90 border-l-2 border-cyan-400' : 'hover:bg-slate-850/40'}" data-id="${wh.id}">
              <div class="flex items-center justify-between text-xs font-mono mb-1">
                <span class="px-2 py-0.5 rounded font-bold border ${methodColor}">${wh.method}</span>
                <span class="text-[10px] text-slate-400">${time}</span>
              </div>
              <div class="text-xs font-medium text-slate-200 truncate font-mono">${summary}</div>
              <div class="flex items-center justify-between text-[10px] text-slate-500 font-mono mt-1">
                <span>${sizeKb} KB</span>
                <span>${wh.signature_provider ? '🛡️ ' + wh.signature_provider : 'Raw'}</span>
              </div>
            </li>
          `;
        })
        .join('');

      // Add click listeners to items
      document.querySelectorAll('.timeline-item').forEach((item) => {
        item.addEventListener('click', () => {
          const id = item.getAttribute('data-id');
          if (id) selectWebhook(id);
        });
      });
    }

    function selectWebhook(id) {
      selectedWebhookId = id;
      renderTimeline();

      const wh = webhooks.find((w) => w.id === id);
      if (!wh) return;

      if (inspectorZeroState) inspectorZeroState.classList.add('hidden');
      if (inspectorHeaderBar) inspectorHeaderBar.classList.remove('hidden');
      if (inspectorTabsNav) inspectorTabsNav.classList.remove('hidden');

      // Update Header Bar
      const methodBadge = document.getElementById('ins-method-badge');
      const summaryText = document.getElementById('ins-summary-text');
      const metaText = document.getElementById('ins-meta-text');

      if (methodBadge) {
        methodBadge.textContent = wh.method;
        methodBadge.className = wh.is_email ? 'px-2.5 py-1 rounded text-xs font-mono font-bold bg-purple-500/10 text-purple-400 border border-purple-500/20' : 'px-2.5 py-1 rounded text-xs font-mono font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20';
      }

      let summary = wh.is_email ? (wh.email?.subject || 'Inbound Email') : 'Request';
      if (!wh.is_email && wh.body) {
        try {
          const parsed = JSON.parse(wh.body);
          if (parsed.type) summary = parsed.type;
          else if (parsed.event) summary = parsed.event;
        } catch (e) {}
      }
      if (summaryText) summaryText.textContent = summary;
      if (metaText) metaText.textContent = `${(wh.size_bytes / 1024).toFixed(1)} KB • ${wh.headers['cf-connecting-ip'] || '127.0.0.1'} • ${new Date(wh.timestamp).toLocaleTimeString()}`;

      // Email panel
      const emailPreview = document.getElementById('email-preview-container');
      if (wh.is_email && wh.email) {
        if (emailPreview) emailPreview.classList.remove('hidden');
        const fromVal = document.getElementById('email-from-val');
        const toVal = document.getElementById('email-to-val');
        const subjVal = document.getElementById('email-subject-badge');
        const bodyVal = document.getElementById('email-body-text');
        if (fromVal) fromVal.textContent = wh.email.from;
        if (toVal) toVal.textContent = wh.email.to;
        if (subjVal) subjVal.textContent = wh.email.subject;
        if (bodyVal) bodyVal.textContent = wh.email.text || wh.email.html || '(No content)';
      } else {
        if (emailPreview) emailPreview.classList.add('hidden');
      }

      // Format Body Code
      const bodyCode = document.getElementById('formatted-body-code');
      const rawBodyCode = document.getElementById('raw-body-code');
      const rawByteCounter = document.getElementById('raw-byte-counter');

      if (rawByteCounter) rawByteCounter.textContent = `${wh.size_bytes} Bytes`;
      if (rawBodyCode) rawBodyCode.textContent = wh.body || '(Empty body)';

      if (bodyCode) {
        try {
          const parsed = JSON.parse(wh.body);
          bodyCode.textContent = JSON.stringify(parsed, null, 2);
        } catch (e) {
          bodyCode.textContent = wh.body || '(Empty body)';
        }
      }

      // Populate Headers Table
      const headersTableBody = document.getElementById('headers-table-body');
      const headersCountPill = document.getElementById('headers-count-pill');
      const headerKeys = Object.keys(wh.headers || {});
      if (headersCountPill) headersCountPill.textContent = headerKeys.length;

      if (headersTableBody) {
        headersTableBody.innerHTML = headerKeys
          .map((k) => `<tr><td class="px-4 py-2 text-cyan-300 font-semibold truncate">${k}</td><td class="px-4 py-2 text-slate-300 break-all select-all">${wh.headers[k]}</td></tr>`)
          .join('');
      }

      // Populate Query Params Table
      const queryTableBody = document.getElementById('query-table-body');
      const queryCountPill = document.getElementById('query-count-pill');
      const queryKeys = Object.keys(wh.query_params || {});
      if (queryCountPill) queryCountPill.textContent = queryKeys.length;

      if (queryTableBody) {
        if (queryKeys.length === 0) {
          queryTableBody.innerHTML = `<tr><td colspan="2" class="px-4 py-3 text-slate-500 italic">No query parameters in this request</td></tr>`;
        } else {
          queryTableBody.innerHTML = queryKeys
            .map((k) => `<tr><td class="px-4 py-2 text-cyan-300 font-semibold">${k}</td><td class="px-4 py-2 text-slate-300 break-all select-all">${wh.query_params[k]}</td></tr>`)
            .join('');
        }
      }

      // Security Tab
      const sigBadge = document.getElementById('detected-provider-badge');
      const sigCode = document.getElementById('signature-recipe-code');
      const sigDot = document.getElementById('signature-indicator-dot');

      if (wh.signature_provider) {
        if (sigBadge) sigBadge.textContent = `${wh.signature_provider} Signature Detected`;
        if (sigDot) sigDot.classList.remove('hidden');
        if (sigCode) {
          sigCode.textContent = `// ${wh.signature_provider} Verification Recipe (Node.js)\nconst crypto = require('crypto');\nconst sig = headers['${wh.signature_provider.toLowerCase()}-signature'];\nconst expected = crypto.createHmac('sha256', SECRET).update(rawBody).digest('hex');\nconst isValid = crypto.timingSafeEqual(Buffer.from(sig), Buffer.from(expected));`;
        }
      } else {
        if (sigBadge) sigBadge.textContent = 'No Signature Header';
        if (sigDot) sigDot.classList.add('hidden');
        if (sigCode) sigCode.textContent = `// Standard HMAC-SHA256 Recipe\nconst crypto = require('crypto');\nconst hash = crypto.createHmac('sha256', SECRET).update(rawBody).digest('hex');`;
      }

      currentTab = window.__appState ? window.__appState.currentTab : currentTab;
      window.switchInspectorTab(currentTab);
    }

    // Tab buttons event listeners (addEventListener fallback on top of onclick)
    document.querySelectorAll('.tab-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        var targetBtn = e.target.closest('.tab-btn') || btn;
        var tab = targetBtn.getAttribute('data-tab');
        if (tab) switchInspectorTab(tab);
      });
    });

    // Method Filter Buttons
    document.querySelectorAll('.method-filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeFilter = btn.getAttribute('data-filter') || 'ALL';
        document.querySelectorAll('.method-filter-btn').forEach((b) => {
          b.className = 'method-filter-btn px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700';
        });
        btn.className = 'method-filter-btn px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 font-bold active-filter';
        renderTimeline();
      });
    });

    // Copy URL
    if (copyLinkBtn) {
      copyLinkBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(fullWebhookUrl);
        const linkText = document.getElementById('copy-link-text');
        if (linkText) linkText.textContent = 'Copied!';
        setTimeout(() => { if (linkText) linkText.textContent = 'URL'; }, 2000);
      });
    }

    // Copy Email
    if (copyEmailBtn) {
      copyEmailBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(fullEmailAddress);
        const btnSpan = copyEmailBtn.querySelector('span');
        if (btnSpan) btnSpan.textContent = 'Copied!';
        setTimeout(() => { if (btnSpan) btnSpan.textContent = 'Email'; }, 2000);
      });
    }

    // Copy Body
    if (copyBodyBtn) {
      copyBodyBtn.addEventListener('click', () => {
        const wh = webhooks.find((w) => w.id === selectedWebhookId);
        if (wh) {
          navigator.clipboard.writeText(wh.body || '');
          copyBodyBtn.textContent = 'Copied!';
          setTimeout(() => { copyBodyBtn.textContent = 'Copy Body'; }, 2000);
        }
      });
    }

    // Copy cURL
    if (copyCurlBtn) {
      copyCurlBtn.addEventListener('click', () => {
        const wh = webhooks.find((w) => w.id === selectedWebhookId);
        if (!wh) return;
        const curlCmd = `curl -X ${wh.method} "${fullWebhookUrl}" \\\n  -H "Content-Type: application/json" \\\n  -d '${(wh.body || '').replace(/'/g, "'\\''")}'`;
        navigator.clipboard.writeText(curlCmd);
        const curlBtnText = document.getElementById('curl-btn-text');
        if (curlBtnText) curlBtnText.textContent = 'Copied!';
        setTimeout(() => { if (curlBtnText) curlBtnText.textContent = 'Copy cURL'; }, 2000);
      });
    }

    // Export Session
    if (exportSessionBtn) {
      exportSessionBtn.addEventListener('click', () => {
        const blob = new Blob([JSON.stringify(webhooks, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `webhooks-${activeEndpointId}-${new Date().toISOString().slice(0, 10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
      });
    }

    // Clear Logs
    if (clearLogsBtn) {
      clearLogsBtn.addEventListener('click', () => {
        if (confirm('Clear all captured webhook logs from browser memory?')) {
          webhooks = [];
          selectedWebhookId = null;
          saveToLocalStorage();
          renderTimeline();
          if (inspectorZeroState) inspectorZeroState.classList.remove('hidden');
          if (inspectorHeaderBar) inspectorHeaderBar.classList.add('hidden');
          if (inspectorTabsNav) inspectorTabsNav.classList.add('hidden');
          document.querySelectorAll('.tab-panel').forEach((p) => p.classList.add('hidden'));
        }
      });
    }

    // Search Input
    if (searchInput) {
      searchInput.addEventListener('input', () => renderTimeline());
    }

    // Global Modal Functions (also exposed as window functions above via hoisting)
    // setupModal keeps addEventListener-based bindings as a belt-and-suspenders approach
    function setupModal(triggerId, modalEl, closeBtnId, cancelBtnId) {
      var trigger = document.getElementById(triggerId);
      var closeBtn = document.getElementById(closeBtnId);
      var cancelBtn = document.getElementById(cancelBtnId);

      if (trigger && modalEl) {
        trigger.addEventListener('click', function() {
          modalEl.classList.remove('hidden');
          if (modalEl === codeModal) renderExportCode();
        });
      }
      if (closeBtn && modalEl) {
        closeBtn.addEventListener('click', function() { modalEl.classList.add('hidden'); });
      }
      if (cancelBtn && modalEl) {
        cancelBtn.addEventListener('click', function() { modalEl.classList.add('hidden'); });
      }
    }

    setupModal('open-config-btn', configModal, 'close-config-modal-btn', 'cancel-config-btn');
    setupModal('open-workflow-btn', workflowModal, 'close-workflow-modal-btn', 'cancel-workflow-btn');
    setupModal('open-monitor-btn', monitorModal, 'close-monitor-modal-btn', 'close-monitor-btn');
    setupModal('open-domain-btn', domainModal, 'close-domain-modal-btn', 'close-domain-btn');
    setupModal('open-mock-btn', mockModal, 'close-mock-modal-btn', null);
    setupModal('replay-drawer-btn', replayModal, 'close-replay-modal-btn', 'close-replay-drawer-btn');
    setupModal('open-code-modal-btn', codeModal, 'close-code-modal-btn', null);

    // Save Custom Response Config
    const saveConfigBtn = document.getElementById('save-config-btn');
    if (saveConfigBtn) {
      saveConfigBtn.addEventListener('click', async () => {
        const statusCode = parseInt(document.getElementById('cfg-status-code')?.value || '200', 10);
        const contentType = document.getElementById('cfg-content-type')?.value || 'application/json';
        const delayMs = parseInt(document.getElementById('cfg-delay-slider')?.value || '0', 10);
        const responseBody = document.getElementById('cfg-response-body')?.value || '{"success": true}';

        await fetch(`/api/config/${activeEndpointId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ statusCode, contentType, delayMs, responseBody })
        });

        const statusBadge = document.getElementById('config-status-badge');
        if (statusBadge) statusBadge.textContent = statusCode;
        configModal?.classList.add('hidden');
      });
    }

    // Delay slider label
    const delaySlider = document.getElementById('cfg-delay-slider');
    const delayVal = document.getElementById('cfg-delay-val');
    if (delaySlider && delayVal) {
      delaySlider.addEventListener('input', () => {
        delayVal.textContent = `${delaySlider.value} ms`;
      });
    }

    // Save Workflow Config
    const saveWorkflowBtn = document.getElementById('save-workflow-btn');
    if (saveWorkflowBtn) {
      saveWorkflowBtn.addEventListener('click', async () => {
        const enabled = document.getElementById('wf-enabled')?.checked || false;
        const autoForwardUrl = document.getElementById('wf-forward-url')?.value || '';
        const notifyWebhookUrl = document.getElementById('wf-notify-url')?.value || '';
        const jsTransformCode = document.getElementById('wf-js-code')?.value || '';

        await fetch(`/api/workflow/${activeEndpointId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ enabled, autoForwardUrl, notifyWebhookUrl, jsTransformCode })
        });

        workflowModal?.classList.add('hidden');
      });
    }

    // Uptime Monitor Ping Handler
    const monRunPingBtn = document.getElementById('mon-run-ping-btn');
    if (monRunPingBtn) {
      monRunPingBtn.addEventListener('click', async () => {
        const targetUrl = document.getElementById('mon-target-url')?.value || '';
        if (!targetUrl) return;

        monRunPingBtn.textContent = 'Pinging...';
        try {
          const res = await fetch('/api/monitor', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ url: targetUrl })
          });
          const data = await res.json();
          const card = document.getElementById('mon-results-card');
          const badge = document.getElementById('mon-status-badge');
          const latVal = document.getElementById('mon-latency-val');
          const sslVal = document.getElementById('mon-ssl-val');

          if (card) card.classList.remove('hidden');
          if (badge) {
            badge.textContent = `${data.status || 'ERR'} ${data.status_text || ''}`;
            badge.className = data.healthy ? 'px-2 py-0.5 rounded text-[11px] bg-emerald-500/20 text-emerald-400 font-bold' : 'px-2 py-0.5 rounded text-[11px] bg-rose-500/20 text-rose-400 font-bold';
          }
          if (latVal) latVal.textContent = `${data.response_time_ms} ms`;
          if (sslVal) sslVal.textContent = data.ssl?.protocol || 'HTTP';
        } catch (e) {
          alert('Monitor check failed: ' + e.message);
        } finally {
          monRunPingBtn.textContent = 'Run Ping';
        }
      });
    }

    // Dispatch Replay Handler
    const dispatchReplayBtn = document.getElementById('dispatch-replay-btn');
    if (dispatchReplayBtn) {
      dispatchReplayBtn.addEventListener('click', async () => {
        const wh = webhooks.find((w) => w.id === selectedWebhookId);
        if (!wh) return;

        const targetUrl = document.getElementById('rep-target-url')?.value || '';
        if (!targetUrl) return;

        dispatchReplayBtn.textContent = 'Sending...';
        try {
          const res = await fetch('/api/replay', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              target_url: targetUrl,
              method: wh.method,
              headers: wh.headers,
              body: wh.body
            })
          });
          const data = await res.json();
          const card = document.getElementById('rep-result-container');
          const badge = document.getElementById('rep-status-badge');
          const lat = document.getElementById('rep-latency-badge');
          const bodyCode = document.getElementById('rep-body-code');

          if (card) card.classList.remove('hidden');
          if (badge) badge.textContent = `${data.status || 500} ${data.status_text || ''}`;
          if (lat) lat.textContent = `${data.duration_ms} ms`;
          if (bodyCode) bodyCode.textContent = data.body || '(No response body)';
        } catch (e) {
          alert('Replay error: ' + e.message);
        } finally {
          dispatchReplayBtn.textContent = 'Dispatch Replay';
        }
      });
    }

    // Code Generator Languages
    document.querySelectorAll('.code-lang-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCodeLang = btn.getAttribute('data-lang') || 'curl';
        document.querySelectorAll('.code-lang-btn').forEach((b) => {
          b.className = 'code-lang-btn px-2.5 py-1 rounded bg-slate-800 text-slate-400 border border-slate-700';
        });
        btn.className = 'code-lang-btn px-2.5 py-1 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 font-bold active-lang';
        renderExportCode();
      });
    });

    function renderExportCode() {
      const wh = webhooks.find((w) => w.id === selectedWebhookId) || { method: 'POST', headers: {}, body: '{"test": true}' };
      const display = document.getElementById('export-code-display');
      if (!display) return;

      const bodyEsc = (wh.body || '').replace(/'/g, "\\'");
      if (activeCodeLang === 'curl') {
        display.textContent = `curl -X ${wh.method} "${fullWebhookUrl}" \\\n  -H "Content-Type: application/json" \\\n  -d '${bodyEsc}'`;
      } else if (activeCodeLang === 'js') {
        display.textContent = `await fetch("${fullWebhookUrl}", {\n  method: "${wh.method}",\n  headers: { "Content-Type": "application/json" },\n  body: JSON.stringify(${wh.body || '{}'})\n});`;
      } else if (activeCodeLang === 'python') {
        display.textContent = `import requests\n\nres = requests.${wh.method.toLowerCase()}("${fullWebhookUrl}", json=${wh.body || '{}'})\nprint(res.status_code, res.text)`;
      } else if (activeCodeLang === 'go') {
        display.textContent = `package main\n\nimport (\n  "bytes"\n  "net/http"\n)\n\nfunc main() {\n  http.Post("${fullWebhookUrl}", "application/json", bytes.NewBuffer([]byte(\`${wh.body || ''}\`)))\n}`;
      } else if (activeCodeLang === 'php') {
        display.textContent = `<?php\n$ch = curl_init("${fullWebhookUrl}");\ncurl_setopt($ch, CURLOPT_POSTFIELDS, '${bodyEsc}');\ncurl_exec($ch);\ncurl_close($ch);`;
      } else if (activeCodeLang === 'rust') {
        display.textContent = `let client = reqwest::Client::new();\nlet res = client.post("${fullWebhookUrl}")\n    .body(r#"${wh.body || ''}"#)\n    .send()\n    .await?;`;
      }
    }
    // Expose to early-script openAppModal
    window.__renderExportCode = renderExportCode;

    // Mock Dispatcher Handlers
    document.querySelectorAll('.mock-dispatch-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const type = btn.getAttribute('data-mock');
        mockModal?.classList.add('hidden');

        if (type === 'inbound-email') {
          await fetch(`/api/email/${activeEndpointId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              from: 'alex.developer@example.com',
              to: `${activeEndpointId}@inbound.tester`,
              subject: 'Invoice Receipt for Plan Pro #1042',
              text: 'Hi Team,\n\nHere is your receipt for the Pro plan subscription. Thank you for your business!\n\nBest,\nBilling Team',
            })
          });
          return;
        }

        let body = {};
        let headers = { 'Content-Type': 'application/json' };

        if (type === 'stripe-sub') {
          headers['Stripe-Signature'] = 't=' + Math.floor(Date.now() / 1000) + ',v1=mock_sig_99a8b';
          body = {
            id: 'evt_stripe_' + Math.random().toString(36).substring(2, 8),
            object: 'event',
            type: 'customer.subscription.created',
            data: { object: { id: 'sub_8923a', customer: 'cus_99182', status: 'active' } }
          };
        } else if (type === 'stripe-pay') {
          headers['Stripe-Signature'] = 't=' + Math.floor(Date.now() / 1000) + ',v1=mock_sig_pay77';
          body = {
            id: 'evt_stripe_' + Math.random().toString(36).substring(2, 8),
            type: 'payment_intent.succeeded',
            data: { object: { amount: 8900, currency: 'usd', status: 'succeeded' } }
          };
        } else if (type === 'github-push') {
          headers['X-Hub-Signature-256'] = 'sha256=mock_hub_sig_334';
          body = {
            ref: 'refs/heads/main',
            repository: { name: 'mitool', full_name: 'org/mitool' },
            pusher: { name: 'developer', email: 'dev@github.com' }
          };
        } else if (type === 'shopify-order') {
          headers['X-Shopify-Hmac-Sha256'] = 'mock_shopify_hmac_66';
          body = {
            id: 10928374,
            email: 'buyer@store.com',
            total_price: '149.00',
            currency: 'USD'
          };
        } else if (type === 'slack-action') {
          headers['X-Slack-Signature'] = 'v0=mock_slack_sig_44';
          body = {
            type: 'block_actions',
            user: { id: 'U123456', username: 'alex' },
            actions: [{ action_id: 'approve_button', value: 'approved' }]
          };
        }

        await fetch(fullWebhookUrl, {
          method: 'POST',
          headers,
          body: JSON.stringify(body)
        });
      });
    });

  })();
</script>

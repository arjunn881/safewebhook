    // Multi-Language Code Generator
    document.querySelectorAll('.code-lang-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCodeLang = btn.getAttribute('data-lang') || 'curl';
        document.querySelectorAll('.code-lang-btn').forEach((b) => {
          b.className = 'code-lang-btn px-2.5 py-1 rounded bg-slate-800 text-slate-400 border border-slate-700 cursor-pointer';
        });
        btn.className = 'code-lang-btn px-2.5 py-1 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 font-bold active-lang cursor-pointer';
        renderExportCode();
      });
    });

    function renderExportCode() {
      const wh = webhooks.find((w) => w.id === selectedWebhookId) || { method: 'POST', headers: {}, body: '{"test": true}' };
      const display = document.getElementById('export-code-display');
      if (!display) return;

      const bodyEsc = (wh.body || '').replace(/'/g, "\\'");
      if (activeCodeLang === 'curl') {
        display.textContent = `curl -X ${wh.method} "${fullWebhookUrl}" \\\n  -H "Content-Type: application/json" \\\n  -d '${bodyEsc}'`;
      } else if (activeCodeLang === 'js') {
        display.textContent = `await fetch("${fullWebhookUrl}", {\n  method: "${wh.method}",\n  headers: { "Content-Type": "application/json" },\n  body: JSON.stringify(${wh.body || '{}'})\n});`;
      } else if (activeCodeLang === 'python') {
        display.textContent = `import requests\n\nres = requests.${wh.method.toLowerCase()}("${fullWebhookUrl}", json=${wh.body || '{}'})\nprint(res.status_code, res.text)`;
      } else if (activeCodeLang === 'go') {
        display.textContent = `package main\n\nimport (\n  "bytes"\n  "net/http"\n)\n\nfunc main() {\n  http.Post("${fullWebhookUrl}", "application/json", bytes.NewBuffer([]byte(\`${wh.body || ''}\`)))\n}`;
      } else if (activeCodeLang === 'php') {
        display.textContent = `<?php\n$ch = curl_init("${fullWebhookUrl}");\ncurl_setopt($ch, CURLOPT_POSTFIELDS, '${bodyEsc}');\ncurl_exec($ch);\ncurl_close($ch);`;
      } else if (activeCodeLang === 'rust') {
        display.textContent = `let client = reqwest::Client::new();\nlet res = client.post("${fullWebhookUrl}")\n    .body(r#"${wh.body || ''}"#)\n    .send()\n    .await?;`;
      } else if (activeCodeLang === 'ruby') {
        display.textContent = `require 'net/http'\nrequire 'uri'\n\nuri = URI.parse("${fullWebhookUrl}")\nres = Net::HTTP.post(uri, '${bodyEsc}', { "Content-Type" => "application/json" })\nputs res.body`;
      } else if (activeCodeLang === 'csharp') {
        display.textContent = `using var client = new HttpClient();\nvar content = new StringContent(@"${wh.body || ''}", System.Text.Encoding.UTF8, "application/json");\nvar res = await client.PostAsync("${fullWebhookUrl}", content);`;
      }
    }
    window.__renderExportCode = renderExportCode;

    const copyLangCodeBtn = document.getElementById('copy-lang-code-btn');
    if (copyLangCodeBtn) {
      copyLangCodeBtn.addEventListener('click', () => {
        const display = document.getElementById('export-code-display');
        if (display) copyToClipboard(display.textContent, copyLangCodeBtn, 'Copy');
      });
    }

    // Interactive HMAC Signature Verification (SubtleCrypto)
    const runSigVerifyBtn = document.getElementById('run-sig-verify-btn');
    if (runSigVerifyBtn) {
      runSigVerifyBtn.addEventListener('click', async () => {
        const wh = webhooks.find((w) => w.id === selectedWebhookId);
        if (!wh) return;

        const secret = document.getElementById('sig-secret-input')?.value || '';
        const provider = document.getElementById('sig-provider-select')?.value || 'auto';
        const resultBadge = document.getElementById('sig-verify-result-badge');
        const debugDetails = document.getElementById('sig-debug-details');
        const extractedSpan = document.getElementById('sig-extracted-val');
        const computedSpan = document.getElementById('sig-computed-val');

        if (!secret) {
          alert('Please enter your webhook secret key');
          return;
        }

        try {
          let expectedSig = '';
          let receivedSig = '';
          let dataToSign = wh.body || '';

          // Stripe
          if (provider === 'stripe' || (provider === 'auto' && wh.headers['stripe-signature'])) {
            const rawHeader = wh.headers['stripe-signature'] || '';
            const tMatch = rawHeader.match(/t=([0-9]+)/);
            const v1Match = rawHeader.match(/v1=([a-f0-9]+)/);
            if (tMatch && v1Match) {
              receivedSig = v1Match[1];
              dataToSign = `${tMatch[1]}.${wh.body || ''}`;
            }
          }
          // GitHub
          else if (provider === 'github' || (provider === 'auto' && (wh.headers['x-hub-signature-256'] || wh.headers['x-hub-signature']))) {
            const rawHeader = wh.headers['x-hub-signature-256'] || wh.headers['x-hub-signature'] || '';
            receivedSig = rawHeader.replace(/^sha256=/, '');
          }
          // Shopify
          else if (provider === 'shopify' || (provider === 'auto' && wh.headers['x-shopify-hmac-sha256'])) {
            receivedSig = wh.headers['x-shopify-hmac-sha256'] || '';
          }
          // Slack
          else if (provider === 'slack' || (provider === 'auto' && wh.headers['x-slack-signature'])) {
            const ts = wh.headers['x-slack-request-timestamp'] || '';
            receivedSig = (wh.headers['x-slack-signature'] || '').replace(/^v0=/, '');
            dataToSign = `v0:${ts}:${wh.body || ''}`;
          }

          // Compute HMAC-SHA256 via WebCrypto
          const enc = new TextEncoder();
          const keyData = enc.encode(secret);
          const cryptoKey = await window.crypto.subtle.importKey(
            'raw',
            keyData,
            { name: 'HMAC', hash: { name: 'SHA-256' } },
            false,
            ['sign']
          );
          const sigBuffer = await window.crypto.subtle.sign('HMAC', cryptoKey, enc.encode(dataToSign));
          const hex = Array.from(new Uint8Array(sigBuffer)).map(b => b.toString(16).padStart(2, '0')).join('');
          const b64 = btoa(String.fromCharCode(...new Uint8Array(sigBuffer)));

          expectedSig = provider === 'shopify' ? b64 : hex;

          const isMatch = receivedSig && (receivedSig.toLowerCase() === expectedSig.toLowerCase() || receivedSig === b64);

          if (resultBadge) {
            resultBadge.classList.remove('hidden');
            if (isMatch) {
              resultBadge.textContent = '✅ Valid Signature — Authenticity Confirmed';
              resultBadge.className = 'px-3 py-1.5 rounded-lg text-xs font-bold font-mono bg-emerald-500/20 text-emerald-400 border border-emerald-500/30';
            } else {
              resultBadge.textContent = '❌ Signature Mismatch';
              resultBadge.className = 'px-3 py-1.5 rounded-lg text-xs font-bold font-mono bg-rose-500/20 text-rose-400 border border-rose-500/30';
            }
          }

          if (debugDetails) debugDetails.classList.remove('hidden');
          if (extractedSpan) extractedSpan.textContent = receivedSig || '(No header signature found)';
          if (computedSpan) computedSpan.textContent = expectedSig;
        } catch (e) {
          alert('Crypto error: ' + e.message);
        }
      });
    }

    // Endpoint Manager: Render list & creation
    function renderEndpointList() {
      const listEl = document.getElementById('saved-endpoints-list');
      if (!listEl) return;
      try {
        const list = JSON.parse(localStorage.getItem(STORAGE_KEY_ENDPOINTS_LIST) || '[]');
        if (list.length === 0) {
          listEl.innerHTML = `<li class="p-3 text-slate-500 italic">No saved endpoints yet.</li>`;
          return;
        }
        listEl.innerHTML = list.map(item => `
          <li class="p-3 flex items-center justify-between hover:bg-slate-900 transition-colors">
            <div class="flex flex-col">
              <span class="font-bold text-cyan-300">${item.label || item.id}</span>
              <span class="text-[10px] text-slate-500">ID: ${item.id}</span>
            </div>
            <div class="flex items-center gap-1.5">
              ${item.id === activeEndpointId ? `<span class="px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-400 text-[10px] font-bold">Active</span>` : `<button data-switch-ep="${item.id}" class="switch-ep-btn px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-[10px] font-bold transition-all cursor-pointer">Switch</button>`}
            </div>
          </li>
        `).join('');

        document.querySelectorAll('.switch-ep-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const ep = btn.getAttribute('data-switch-ep');
            if (ep) {
              window.location.search = `?ep=${encodeURIComponent(ep)}`;
            }
          });
        });
      } catch (e) {}
    }
    window.__renderEndpointList = renderEndpointList;

    const createEpBtn = document.getElementById('create-ep-btn');
    if (createEpBtn) {
      createEpBtn.addEventListener('click', () => {
        const input = document.getElementById('new-ep-slug-input');
        let slug = (input?.value || '').trim();
        if (!slug) {
          slug = 'ep_' + Math.random().toString(36).substring(2, 9);
        }
        slug = slug.replace(/[^a-zA-Z0-9_-]/g, '_');
        saveEndpointToRecentList(slug, slug);
        window.location.search = `?ep=${encodeURIComponent(slug)}`;
      });
    }

    // Request Composer Presets
    const compPresetSelect = document.getElementById('comp-preset-select');
    if (compPresetSelect) {
      compPresetSelect.addEventListener('change', () => {
        const val = compPresetSelect.value;
        const bodyInput = document.getElementById('comp-body-input');
        const headersInput = document.getElementById('comp-headers-input');
        if (!bodyInput) return;

        if (val === 'stripe_payment') {
          headersInput.value = JSON.stringify({ "Content-Type": "application/json", "Stripe-Signature": `t=${Math.floor(Date.now()/1000)},v1=mock_v1_sig` }, null, 2);
          bodyInput.value = JSON.stringify({ id: "evt_stripe_102", type: "payment_intent.succeeded", data: { object: { amount: 5000, currency: "usd" } } }, null, 2);
        } else if (val === 'github_push') {
          headersInput.value = JSON.stringify({ "Content-Type": "application/json", "X-GitHub-Event": "push", "X-Hub-Signature-256": "sha256=mock_sha256" }, null, 2);
          bodyInput.value = JSON.stringify({ ref: "refs/heads/main", repository: { full_name: "org/repo" }, pusher: { name: "developer" } }, null, 2);
        } else if (val === 'shopify_order') {
          headersInput.value = JSON.stringify({ "Content-Type": "application/json", "X-Shopify-Topic": "orders/create" }, null, 2);
          bodyInput.value = JSON.stringify({ id: 109283, email: "customer@example.com", total_price: "99.00" }, null, 2);
        }
      });
    }

    const dispatchComposerBtn = document.getElementById('dispatch-composer-btn');
    if (dispatchComposerBtn) {
      dispatchComposerBtn.addEventListener('click', async () => {
        const method = document.getElementById('comp-method-select')?.value || 'POST';
        const targetUrl = document.getElementById('comp-target-url')?.value || fullWebhookUrl;
        const bodyText = document.getElementById('comp-body-input')?.value || '';
        let headers = { 'Content-Type': 'application/json' };
        try {
          headers = JSON.parse(document.getElementById('comp-headers-input')?.value || '{}');
        } catch (e) {}

        dispatchComposerBtn.textContent = 'Sending...';
        try {
          await fetch(targetUrl, {
            method,
            headers,
            body: ['GET', 'HEAD'].includes(method) ? undefined : bodyText
          });
          const msg = document.getElementById('comp-feedback-msg');
          if (msg) {
            msg.textContent = 'Dispatched successfully!';
            setTimeout(() => { msg.textContent = ''; }, 3000);
          }
          window.closeAppModal('composer-modal');
        } catch (e) {
          alert('Dispatch failed: ' + e.message);
        } finally {
          dispatchComposerBtn.textContent = 'Send Webhook';
        }
      });
    }

    // Import Session JSON
    const submitImportBtn = document.getElementById('submit-import-btn');
    if (submitImportBtn) {
      submitImportBtn.addEventListener('click', () => {
        const raw = document.getElementById('import-json-textarea')?.value || '';
        try {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed) && parsed.length > 0) {
            webhooks = parsed;
            selectedWebhookId = webhooks[0].id;
            saveToLocalStorage();
            renderTimeline();
            selectWebhook(selectedWebhookId);
            window.closeAppModal('import-modal');
          } else {
            alert('Invalid JSON: Must be an array of webhook objects');
          }
        } catch (e) {
          alert('JSON syntax error: ' + e.message);
        }
      });
    }

    // Mock Dispatcher Handlers
    document.querySelectorAll('.mock-dispatch-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const type = btn.getAttribute('data-mock');
        mockModal?.classList.add('hidden');

        if (type === 'inbound-email') {
          await fetch(`/api/email/${activeEndpointId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              from: 'alex.developer@example.com',
              to: `${activeEndpointId}@safewebhook.com`,
              subject: 'Invoice Receipt for Plan Pro #1042',
              text: 'Hi Team,\n\nHere is your receipt for the Pro plan subscription. Thank you for your business!\n\nBest,\nBilling Team',
            })
          });
          return;
        }

        let body = {};
        let headers = { 'Content-Type': 'application/json' };

        if (type === 'stripe-sub') {
          headers['Stripe-Signature'] = 't=' + Math.floor(Date.now() / 1000) + ',v1=mock_sig_99a8b';
          body = {
            id: 'evt_stripe_' + Math.random().toString(36).substring(2, 8),
            object: 'event',
            type: 'customer.subscription.created',
            data: { object: { id: 'sub_8923a', customer: 'cus_99182', status: 'active' } }
          };
        } else if (type === 'stripe-pay') {
          headers['Stripe-Signature'] = 't=' + Math.floor(Date.now() / 1000) + ',v1=mock_sig_pay77';
          body = {
            id: 'evt_stripe_' + Math.random().toString(36).substring(2, 8),
            type: 'payment_intent.succeeded',
            data: { object: { amount: 8900, currency: 'usd', status: 'succeeded' } }
          };
        } else if (type === 'github-push') {
          headers['X-Hub-Signature-256'] = 'sha256=mock_hub_sig_334';
          body = {
            ref: 'refs/heads/main',
            repository: { name: 'safewebhook', full_name: 'safewebhook/app' },
            pusher: { name: 'developer', email: 'dev@github.com' }
          };
        } else if (type === 'shopify-order') {
          headers['X-Shopify-Hmac-Sha256'] = 'mock_shopify_hmac_66';
          body = {
            id: 10928374,
            email: 'buyer@store.com',
            total_price: '149.00',
            currency: 'USD'
          };
        } else if (type === 'slack-action') {
          headers['X-Slack-Signature'] = 'v0=mock_slack_sig_44';
          body = {
            type: 'block_actions',
            user: { id: 'U123456', username: 'alex' },
            actions: [{ action_id: 'approve_button', value: 'approved' }]
          };
        }

        await fetch(fullWebhookUrl, {
          method: 'POST',
          headers,
          body: JSON.stringify(body)
        });
      });
    });

    const zeroStateMockBtn = document.getElementById('zero-state-mock-btn');
    if (zeroStateMockBtn) {
      zeroStateMockBtn.addEventListener('click', () => {
        fetch(fullWebhookUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Stripe-Signature': `t=${Math.floor(Date.now()/1000)},v1=mock_sig` },
          body: JSON.stringify({ id: 'evt_stripe_quick', type: 'payment_intent.succeeded', data: { object: { amount: 4900, currency: 'usd' } } })
        });
      });
    }

    const emptyMockTrigger = document.getElementById('empty-mock-trigger');
    if (emptyMockTrigger) {
      emptyMockTrigger.addEventListener('click', () => {
        fetch(fullWebhookUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Stripe-Signature': `t=${Math.floor(Date.now()/1000)},v1=mock_sig` },
          body: JSON.stringify({ id: 'evt_stripe_quick', type: 'payment_intent.succeeded', data: { object: { amount: 4900, currency: 'usd' } } })
        });
      });
    }

  })();
</script>

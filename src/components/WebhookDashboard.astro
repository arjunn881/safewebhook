    // Dispatch Replay Handler
    const dispatchReplayBtn = document.getElementById('dispatch-replay-btn');
    if (dispatchReplayBtn) {
      dispatchReplayBtn.addEventListener('click', async () => {
        const wh = webhooks.find((w) => w.id === selectedWebhookId);
        if (!wh) return;

        const targetUrl = document.getElementById('rep-target-url')?.value || '';
        if (!targetUrl) return;

        dispatchReplayBtn.textContent = 'Sending...';
        try {
          const res = await fetch('/api/replay', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              target_url: targetUrl,
              method: wh.method,
              headers: wh.headers,
              body: wh.body
            })
          });
          const data = await res.json();
          const card = document.getElementById('rep-result-container');
          const badge = document.getElementById('rep-status-badge');
          const lat = document.getElementById('rep-latency-badge');
          const bodyCode = document.getElementById('rep-body-code');

          if (card) card.classList.remove('hidden');
          if (badge) badge.textContent = `${data.status || 500} ${data.status_text || ''}`;
          if (lat) lat.textContent = `${data.duration_ms} ms`;
          if (bodyCode) bodyCode.textContent = data.body || '(No response body)';
        } catch (e) {

    // Modal Triggers
    function setupModal(triggerId, modalEl, closeBtnId, cancelBtnId) {
      var trigger = document.getElementById(triggerId);
      var closeBtn = document.getElementById(closeBtnId);
      var cancelBtn = document.getElementById(cancelBtnId);

      if (trigger && modalEl) {
        trigger.addEventListener('click', function() {
          modalEl.classList.remove('hidden');
          if (modalEl === codeModal) renderExportCode();
        });
      }
      if (closeBtn && modalEl) {
        closeBtn.addEventListener('click', function() { modalEl.classList.add('hidden'); });
      }
      if (cancelBtn && modalEl) {
        cancelBtn.addEventListener('click', function() { modalEl.classList.add('hidden'); });
      }
    }

    setupModal('open-config-btn', configModal, 'close-config-modal-btn', 'cancel-config-btn');
    setupModal('open-workflow-btn', workflowModal, 'close-workflow-modal-btn', 'cancel-workflow-btn');
    setupModal('open-monitor-btn', monitorModal, 'close-monitor-modal-btn', 'close-monitor-btn');
    setupModal('open-mock-btn', mockModal, 'close-mock-modal-btn', null);
    setupModal('replay-drawer-btn', replayModal, 'close-replay-modal-btn', 'close-replay-drawer-btn');
    setupModal('open-code-modal-btn', codeModal, 'close-code-modal-btn', null);

    // Save Custom Response Config
    const saveConfigBtn = document.getElementById('save-config-btn');
    if (saveConfigBtn) {
      saveConfigBtn.addEventListener('click', async () => {
        const statusCode = parseInt(document.getElementById('cfg-status-code')?.value || '200', 10);
        const contentType = document.getElementById('cfg-content-type')?.value || 'application/json';
        const delayMs = parseInt(document.getElementById('cfg-delay-slider')?.value || '0', 10);
        const responseBody = document.getElementById('cfg-response-body')?.value || '{"success": true}';

        await fetch(`/api/config/${activeEndpointId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ statusCode, contentType, delayMs, responseBody })
        });

        const statusBadge = document.getElementById('config-status-badge');
        if (statusBadge) statusBadge.textContent = statusCode;
        configModal?.classList.add('hidden');
      });
    }

    const delaySlider = document.getElementById('cfg-delay-slider');
    const delayVal = document.getElementById('cfg-delay-val');
    if (delaySlider && delayVal) {
      delaySlider.addEventListener('input', () => {
        delayVal.textContent = `${delaySlider.value} ms`;
      });
    }

    // Save Workflow Config
    const saveWorkflowBtn = document.getElementById('save-workflow-btn');
    if (saveWorkflowBtn) {
      saveWorkflowBtn.addEventListener('click', async () => {
        const enabled = document.getElementById('wf-enabled')?.checked || false;
        const autoForwardUrl = document.getElementById('wf-forward-url')?.value || '';
        const notifyWebhookUrl = document.getElementById('wf-notify-url')?.value || '';
        const jsTransformCode = document.getElementById('wf-js-code')?.value || '';

        await fetch(`/api/workflow/${activeEndpointId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ enabled, autoForwardUrl, notifyWebhookUrl, jsTransformCode })
        });

        workflowModal?.classList.add('hidden');
      });
    }

    // Uptime Monitor Ping Handler
    const monRunPingBtn = document.getElementById('mon-run-ping-btn');
    if (monRunPingBtn) {
      monRunPingBtn.addEventListener('click', async () => {
        const targetUrl = document.getElementById('mon-target-url')?.value || '';
        if (!targetUrl) return;

        monRunPingBtn.textContent = 'Pinging...';
        try {
          const res = await fetch('/api/monitor', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ url: targetUrl })
          });
          const data = await res.json();
          const card = document.getElementById('mon-results-card');
          const badge = document.getElementById('mon-status-badge');
          const latVal = document.getElementById('mon-latency-val');
          const sslVal = document.getElementById('mon-ssl-val');

          if (card) card.classList.remove('hidden');
          if (badge) {
            badge.textContent = `${data.status || 'ERR'} ${data.status_text || ''}`;
            badge.className = data.healthy ? 'px-2 py-0.5 rounded text-[11px] bg-emerald-500/20 text-emerald-400 font-bold' : 'px-2 py-0.5 rounded text-[11px] bg-rose-500/20 text-rose-400 font-bold';
          }
          if (latVal) latVal.textContent = `${data.response_time_ms} ms`;
          if (sslVal) sslVal.textContent = data.ssl?.protocol || 'HTTP';
        } catch (e) {
          alert('Monitor check failed: ' + e.message);
        } finally {
          monRunPingBtn.textContent = 'Run Ping';
        }

<!-- ========================================================================= -->
<!-- COMPREHENSIVE CLIENT-SIDE JAVASCRIPT LOGIC ENGINE                         -->
<!-- ========================================================================= -->
<script is:inline>
  (function () {
    // ═══════════════════════════════════════════
    // SHARED STATE OBJECT
    // ═══════════════════════════════════════════
    var _state = {
      webhooks: [],
      selectedWebhookId: null,
      eventSource: null,
      activeFilter: 'ALL',
      currentTab: 'body',
      activeCodeLang: 'curl',
      pollInterval: null,
      isStreamPaused: false,
    };

    const STORAGE_KEY_ENDPOINT = 'wh_active_endpoint_id';
    const STORAGE_KEY_PAYLOADS = 'wh_captured_payloads_';
    const STORAGE_KEY_ENDPOINTS_LIST = 'wh_saved_endpoints_list';

    // 1. Resolve Active Endpoint
    const urlParams = new URLSearchParams(window.location.search);
    let activeEndpointId = urlParams.get('ep') || localStorage.getItem(STORAGE_KEY_ENDPOINT);
    if (!activeEndpointId || activeEndpointId.length < 3) {
      activeEndpointId = 'ep_dev_' + Math.random().toString(36).substring(2, 8);
    }
    localStorage.setItem(STORAGE_KEY_ENDPOINT, activeEndpointId);

    // Save active endpoint into recent list
    saveEndpointToRecentList(activeEndpointId);

    function saveEndpointToRecentList(epId, label) {
      try {
        let list = JSON.parse(localStorage.getItem(STORAGE_KEY_ENDPOINTS_LIST) || '[]');
        const existingIdx = list.findIndex(item => item.id === epId);
        if (existingIdx >= 0) {
          if (label) list[existingIdx].label = label;
          list[existingIdx].lastUsed = Date.now();
        } else {
          list.unshift({ id: epId, label: label || 'Session ' + epId, lastUsed: Date.now() });
        }
        localStorage.setItem(STORAGE_KEY_ENDPOINTS_LIST, JSON.stringify(list.slice(0, 15)));
      } catch (e) {}
    }

    // State Variables
    let webhooks = _state.webhooks;
    let selectedWebhookId = _state.selectedWebhookId;
    let eventSource = _state.eventSource;
    let activeFilter = _state.activeFilter;
    let currentTab = _state.currentTab;
    let activeCodeLang = _state.activeCodeLang;
    let pollInterval = _state.pollInterval;

    // DOM Elements
    const endpointUrlInput = document.getElementById('endpoint-url-input');
    const endpointEmailInput = document.getElementById('endpoint-email-input');
    const copyLinkBtn = document.getElementById('copy-link-btn');
    const copyEmailBtn = document.getElementById('copy-email-btn');
    const webhookCountBadge = document.getElementById('webhook-count-badge');
    const searchInput = document.getElementById('search-input');
    const timelineList = document.getElementById('timeline-list');
    const timelineEmptyState = document.getElementById('timeline-empty-state');
    const inspectorZeroState = document.getElementById('inspector-zero-state');
    const inspectorHeaderBar = document.getElementById('inspector-header-bar');
    const inspectorTabsNav = document.getElementById('inspector-tabs-nav');
    const clearLogsBtn = document.getElementById('clear-logs-btn');
    const exportSessionBtn = document.getElementById('export-session-btn');
    const copyCurlBtn = document.getElementById('copy-curl-btn');
    const copyBodyBtn = document.getElementById('copy-body-btn');

    // Modals
    const configModal = document.getElementById('config-modal');
    const workflowModal = document.getElementById('workflow-modal');
    const monitorModal = document.getElementById('monitor-modal');
    const replayModal = document.getElementById('replay-modal');
    const codeModal = document.getElementById('code-modal');
    const mockModal = document.getElementById('mock-modal');

    // Configure URLs in UI
    const origin = window.location.origin;
    const fullWebhookUrl = `${origin}/api/r/${activeEndpointId}`;
    const fullEmailAddress = `${activeEndpointId}@safewebhook.com`;
    if (endpointUrlInput) endpointUrlInput.value = fullWebhookUrl;
    if (endpointEmailInput) endpointEmailInput.value = fullEmailAddress;

    const zeroStateUrlInput = document.getElementById('zero-state-url-input');
    if (zeroStateUrlInput) zeroStateUrlInput.value = fullWebhookUrl;

    const compTargetUrl = document.getElementById('comp-target-url');
    if (compTargetUrl) compTargetUrl.value = fullWebhookUrl;

    const sampleCurlCommand = `curl -X POST ${fullWebhookUrl} \\\n  -H "Content-Type: application/json" \\\n  -H "Stripe-Signature: t=${Math.floor(Date.now() / 1000)},v1=98a3c4f912e742c..." \\\n  -d '{"event": "payment_intent.succeeded", "amount": 4900, "currency": "usd"}'`;

    const zeroStateCurlCode = document.getElementById('zero-state-curl-code');
    if (zeroStateCurlCode) zeroStateCurlCode.textContent = sampleCurlCommand;

    // Node forwarder sample script
    const forwarderNodeCode = document.getElementById('forwarder-node-code');
    if (forwarderNodeCode) {
      forwarderNodeCode.textContent = `// node-forwarder.js\nconst es = new EventSource('${origin}/api/stream/${activeEndpointId}');\nes.onmessage = async (e) => {\n  const ev = JSON.parse(e.data);\n  if (ev.type === 'connected' || ev.type === 'ping') return;\n  console.log('Forwarding webhook:', ev.method, ev.id);\n  await fetch('http://localhost:3000/api/webhook', {\n    method: ev.method,\n    headers: ev.headers,\n    body: ['GET','HEAD'].includes(ev.method) ? undefined : ev.body\n  });\n};`;
    }

    // Clipboard Copy Helper
    async function copyToClipboard(text, labelElement, originalText = 'Copy') {
      try {
        await navigator.clipboard.writeText(text);
        if (labelElement) {
          labelElement.textContent = 'Copied!';
          setTimeout(() => { labelElement.textContent = originalText; }, 2000);
        }
      } catch (err) {
        const input = document.createElement('input');
        input.value = text;
        document.body.appendChild(input);
        input.select();
        try { document.execCommand('copy'); } catch(e){}
        document.body.removeChild(input);
        if (labelElement) {
          labelElement.textContent = 'Copied!';
          setTimeout(() => { labelElement.textContent = originalText; }, 2000);
        }
      }
    }

    if (copyLinkBtn) {
      copyLinkBtn.addEventListener('click', () => copyToClipboard(fullWebhookUrl, document.getElementById('copy-link-text'), 'Copy'));
    }
    if (copyEmailBtn) {
      copyEmailBtn.addEventListener('click', () => copyToClipboard(fullEmailAddress, copyEmailBtn.querySelector('span'), 'Email'));
    }
    const zeroStateCopyUrlBtn = document.getElementById('zero-state-copy-url-btn');
    if (zeroStateCopyUrlBtn) {
      zeroStateCopyUrlBtn.addEventListener('click', () => copyToClipboard(fullWebhookUrl, document.getElementById('zero-copy-text'), 'Copy URL'));
    }
    const zeroStateCopyCurlBtn = document.getElementById('zero-state-copy-curl-btn');
    if (zeroStateCopyCurlBtn) {
      zeroStateCopyCurlBtn.addEventListener('click', () => copyToClipboard(sampleCurlCommand, document.getElementById('zero-curl-copy-text'), 'Copy cURL'));
    }

    const copyForwarderBtn = document.getElementById('copy-forwarder-script-btn');
    if (copyForwarderBtn && forwarderNodeCode) {
      copyForwarderBtn.addEventListener('click', () => copyToClipboard(forwarderNodeCode.textContent, copyForwarderBtn, 'Copy'));
    }

    // Toggle Stream Pause
    const togglePauseBtn = document.getElementById('toggle-pause-stream-btn');
    if (togglePauseBtn) {
      togglePauseBtn.addEventListener('click', () => {
        _state.isStreamPaused = !_state.isStreamPaused;
        const icon = document.getElementById('stream-pause-icon');
        const txt = document.getElementById('stream-pause-text');
        const ping = document.getElementById('conn-ping');
        const dot = document.getElementById('conn-dot');
        const connTxt = document.getElementById('conn-text');

        if (_state.isStreamPaused) {
          if (icon) icon.textContent = '▶';
          if (txt) txt.textContent = 'Resume';
          if (ping) ping.className = 'hidden';
          if (dot) dot.className = 'relative inline-flex rounded-full h-2 w-2 bg-amber-400';
          if (connTxt) connTxt.textContent = 'Stream Paused';
          togglePauseBtn.className = 'h-7 px-2 rounded-md bg-amber-500/20 text-amber-300 border border-amber-500/40 text-[10px] font-mono flex items-center gap-1 transition-colors cursor-pointer';
        } else {
          if (icon) icon.textContent = '⏸';
          if (txt) txt.textContent = 'Pause';
          if (ping) ping.className = 'animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75';
          if (dot) dot.className = 'relative inline-flex rounded-full h-2 w-2 bg-emerald-500';
          if (connTxt) connTxt.textContent = 'Live SSE Stream';
          togglePauseBtn.className = 'h-7 px-2 rounded-md bg-slate-800/80 hover:bg-slate-700 text-slate-400 hover:text-cyan-300 border border-slate-700/80 text-[10px] font-mono flex items-center gap-1 transition-colors cursor-pointer';
        }
      });
    }

    // Load Local Storage Payloads
    try {
      const stored = localStorage.getItem(STORAGE_KEY_PAYLOADS + activeEndpointId);
      if (stored) {
        webhooks = JSON.parse(stored);
      }
    } catch (e) {
      webhooks = [];
    }

    // Initialize UI
    renderTimeline();
    if (webhooks.length > 0) {
      selectWebhook(webhooks[0].id);
    }

    // Polling & Syncing Definitions
    async function initialSync() {
      try {
        const res = await fetch(`/api/poll/${activeEndpointId}`);
        if (!res.ok) return;
        const data = await res.json();
        if (data.events && Array.isArray(data.events) && data.events.length > 0) {
          let changed = false;
          for (let i = data.events.length - 1; i >= 0; i--) {
            const ev = data.events[i];
            if (!webhooks.some((w) => w.id === ev.id)) {
              webhooks.unshift(ev);
              changed = true;
            }
          }
          if (changed) {
            saveToLocalStorage();
            renderTimeline();
            if (!selectedWebhookId && webhooks.length > 0) {
              selectWebhook(webhooks[0].id);
            }
          }
        }
      } catch (e) {}
    }

    function startPolling() {
      if (pollInterval) clearInterval(pollInterval);
      pollInterval = setInterval(async () => {
        if (_state.isStreamPaused) return;
        try {
          const res = await fetch(`/api/poll/${activeEndpointId}`);
          if (!res.ok) return;
          const data = await res.json();
          if (data.events && Array.isArray(data.events) && data.events.length > 0) {
            let changed = false;
            for (let i = data.events.length - 1; i >= 0; i--) {
              const ev = data.events[i];
              if (!webhooks.some((w) => w.id === ev.id)) {
                webhooks.unshift(ev);
                changed = true;
              }
            }
            if (changed) {
              saveToLocalStorage();
              renderTimeline();
              if (!selectedWebhookId && webhooks.length > 0) {
                selectWebhook(webhooks[0].id);
              }
            }
          }
        } catch (e) {}
      }, 1500);
    }

    // Connect SSE Stream & Resilient Edge Poller
    connectEventSource();
    startPolling();
    initialSync();

    function connectEventSource() {
      if (eventSource) {
        eventSource.close();
      }

      eventSource = new EventSource(`/api/stream/${activeEndpointId}`);

      eventSource.onopen = () => {
        const ping = document.getElementById('conn-ping');
        const dot = document.getElementById('conn-dot');
        const text = document.getElementById('conn-text');
        if (ping && !_state.isStreamPaused) ping.className = 'animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75';
        if (dot && !_state.isStreamPaused) dot.className = 'relative inline-flex rounded-full h-2 w-2 bg-emerald-500';
        if (text && !_state.isStreamPaused) text.textContent = 'Live SSE Stream';
      };

      eventSource.onmessage = (event) => {
        if (_state.isStreamPaused) return;
        try {
          const data = JSON.parse(event.data);
          if (data.type === 'connected' || data.type === 'ping') return;

          // Ingest new payload
          const newEntry = {
            id: data.id || 'evt_' + Math.random().toString(36).substring(2, 9),
            endpoint_id: activeEndpointId,
            timestamp: data.timestamp || new Date().toISOString(),
            method: data.method || 'POST',
            query_params: data.query_params || {},
            headers: data.headers || {},
            body: data.body || '',
            size_bytes: data.size_bytes || (data.body ? data.body.length : 0),
            format: data.format || 'json',
            signature_provider: data.signature_provider || null,
            client_ip: data.client_ip || '127.0.0.1',
            is_email: data.is_email || false,
            email: data.email || null,
          };

          webhooks.unshift(newEntry);
          saveToLocalStorage();
          renderTimeline();

          if (!selectedWebhookId || webhooks.length === 1) {
            selectWebhook(newEntry.id);
          }
        } catch (err) {
          console.error('Failed to parse SSE chunk:', err);
        }
      };

      eventSource.onerror = () => {
        const dot = document.getElementById('conn-dot');
        const text = document.getElementById('conn-text');
        if (dot && !_state.isStreamPaused) dot.className = 'relative inline-flex rounded-full h-2 w-2 bg-amber-500';
        if (text && !_state.isStreamPaused) text.textContent = 'Reconnecting...';
      };
    }

    function saveToLocalStorage() {
      try {
        localStorage.setItem(STORAGE_KEY_PAYLOADS + activeEndpointId, JSON.stringify(webhooks.slice(0, 100)));
      } catch (e) {}
    }

    function renderTimeline() {
      if (webhookCountBadge) webhookCountBadge.textContent = webhooks.length;

      const searchTerm = (searchInput?.value || '').toLowerCase().trim();

      const filtered = webhooks.filter((wh) => {
        if (activeFilter === 'EMAIL' && !wh.is_email) return false;
        if (activeFilter !== 'ALL' && activeFilter !== 'EMAIL' && wh.method !== activeFilter) return false;
        if (!searchTerm) return true;

        const bodyStr = String(wh.body || '').toLowerCase();
        const headerStr = JSON.stringify(wh.headers || {}).toLowerCase();
        const methodStr = String(wh.method || '').toLowerCase();
        const ipStr = String(wh.client_ip || '').toLowerCase();
        return bodyStr.includes(searchTerm) || headerStr.includes(searchTerm) || methodStr.includes(searchTerm) || ipStr.includes(searchTerm);
      });

      if (filtered.length === 0) {
        if (timelineEmptyState) timelineEmptyState.classList.remove('hidden');
        if (timelineList) timelineList.innerHTML = '';
        return;
      }

      if (timelineEmptyState) timelineEmptyState.classList.add('hidden');

      if (!timelineList) return;
      timelineList.innerHTML = filtered
        .map((wh) => {
          const isSelected = wh.id === selectedWebhookId;
          const time = new Date(wh.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
          const sizeKb = (wh.size_bytes / 1024).toFixed(1);

          let methodColor = 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20';
          if (wh.is_email || wh.method === 'EMAIL') methodColor = 'text-purple-400 bg-purple-500/10 border-purple-500/20';
          else if (wh.method === 'GET') methodColor = 'text-sky-400 bg-sky-500/10 border-sky-500/20';
          else if (wh.method === 'PUT') methodColor = 'text-amber-400 bg-amber-500/10 border-amber-500/20';
          else if (wh.method === 'DELETE') methodColor = 'text-rose-400 bg-rose-500/10 border-rose-500/20';
          else if (wh.method === 'PATCH') methodColor = 'text-purple-400 bg-purple-500/10 border-purple-500/20';

          let summary = wh.is_email ? (wh.email?.subject || 'Inbound Email') : 'Request';
          if (!wh.is_email && wh.body) {
            try {
              const parsed = JSON.parse(wh.body);
              if (parsed.type) summary = parsed.type;
              else if (parsed.event) summary = parsed.event;
              else if (parsed.topic) summary = parsed.topic;
              else if (parsed.action) summary = parsed.action;
            } catch (e) {}
          }

          return `
            <li class="timeline-item p-3 cursor-pointer transition-colors ${isSelected ? 'bg-slate-850/90 border-l-2 border-cyan-400' : 'hover:bg-slate-850/40'}" data-id="${wh.id}">
              <div class="flex items-center justify-between text-xs font-mono mb-1">
                <span class="px-2 py-0.5 rounded font-bold border ${methodColor}">${wh.method}</span>
                <span class="text-[10px] text-slate-400">${time}</span>
              </div>
              <div class="text-xs font-medium text-slate-200 truncate font-mono">${summary}</div>
              <div class="flex items-center justify-between text-[10px] text-slate-500 font-mono mt-1">
                <span>${sizeKb} KB</span>
                <span>${wh.signature_provider ? '🛡️ ' + wh.signature_provider : 'Raw'}</span>
              </div>
            </li>
          `;
        })
        .join('');

      document.querySelectorAll('.timeline-item').forEach((item) => {
        item.addEventListener('click', () => {
          const id = item.getAttribute('data-id');
          if (id) selectWebhook(id);
        });
      });
    }

    function selectWebhook(id) {
      selectedWebhookId = id;
      renderTimeline();

      const wh = webhooks.find((w) => w.id === id);
      if (!wh) return;

      if (inspectorZeroState) inspectorZeroState.classList.add('hidden');
      if (inspectorHeaderBar) inspectorHeaderBar.classList.remove('hidden');
      if (inspectorTabsNav) inspectorTabsNav.classList.remove('hidden');

      // Update Header Bar
      const methodBadge = document.getElementById('ins-method-badge');
      const summaryText = document.getElementById('ins-summary-text');
      const metaText = document.getElementById('ins-meta-text');

      if (methodBadge) {
        methodBadge.textContent = wh.method;
        methodBadge.className = wh.is_email ? 'px-2.5 py-1 rounded text-xs font-mono font-bold bg-purple-500/10 text-purple-400 border border-purple-500/20' : 'px-2.5 py-1 rounded text-xs font-mono font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20';
      }

      let summary = wh.is_email ? (wh.email?.subject || 'Inbound Email') : 'Request';
      if (!wh.is_email && wh.body) {
        try {
          const parsed = JSON.parse(wh.body);
          if (parsed.type) summary = parsed.type;
          else if (parsed.event) summary = parsed.event;
          else if (parsed.topic) summary = parsed.topic;
          else if (parsed.action) summary = parsed.action;
        } catch (e) {}
      }
      if (summaryText) summaryText.textContent = summary;
      if (metaText) metaText.textContent = `${(wh.size_bytes / 1024).toFixed(1)} KB • ${wh.client_ip || wh.headers['cf-connecting-ip'] || '127.0.0.1'} • ${new Date(wh.timestamp).toLocaleTimeString()}`;

      // Email panel
      const emailPreview = document.getElementById('email-preview-container');
      if (wh.is_email && wh.email) {
        if (emailPreview) emailPreview.classList.remove('hidden');
        const fromVal = document.getElementById('email-from-val');
        const toVal = document.getElementById('email-to-val');
        const subjVal = document.getElementById('email-subject-badge');
        const bodyVal = document.getElementById('email-body-text');
        if (fromVal) fromVal.textContent = wh.email.from;
        if (toVal) toVal.textContent = wh.email.to;
        if (subjVal) subjVal.textContent = wh.email.subject;
        if (bodyVal) bodyVal.textContent = wh.email.text || wh.email.html || '(No content)';
      } else {
        if (emailPreview) emailPreview.classList.add('hidden');
      }

      // Format Body Code
      const bodyCode = document.getElementById('formatted-body-code');
      const rawBodyCode = document.getElementById('raw-body-code');
      const rawByteCounter = document.getElementById('raw-byte-counter');

      if (rawByteCounter) rawByteCounter.textContent = `${wh.size_bytes} Bytes`;
      if (rawBodyCode) rawBodyCode.textContent = wh.body || '(Empty body)';

      if (bodyCode) {
        try {
          const parsed = JSON.parse(wh.body);
          bodyCode.textContent = JSON.stringify(parsed, null, 2);
        } catch (e) {
          bodyCode.textContent = wh.body || '(Empty body)';
        }
      }

      // Populate Headers Table
      const headersTableBody = document.getElementById('headers-table-body');
      const headersCountPill = document.getElementById('headers-count-pill');
      const headerKeys = Object.keys(wh.headers || {});
      if (headersCountPill) headersCountPill.textContent = headerKeys.length;

      if (headersTableBody) {
        headersTableBody.innerHTML = headerKeys
          .map((k) => `<tr><td class="px-4 py-2 text-cyan-300 font-semibold truncate">${k}</td><td class="px-4 py-2 text-slate-300 break-all select-all">${wh.headers[k]}</td></tr>`)
          .join('');
      }

      // Populate Query Params Table
      const queryTableBody = document.getElementById('query-table-body');
      const queryCountPill = document.getElementById('query-count-pill');
      const queryKeys = Object.keys(wh.query_params || {});
      if (queryCountPill) queryCountPill.textContent = queryKeys.length;

      if (queryTableBody) {
        if (queryKeys.length === 0) {
          queryTableBody.innerHTML = `<tr><td colspan="2" class="px-4 py-3 text-slate-500 italic">No query parameters in this request</td></tr>`;
        } else {
          queryTableBody.innerHTML = queryKeys
            .map((k) => `<tr><td class="px-4 py-2 text-cyan-300 font-semibold">${k}</td><td class="px-4 py-2 text-slate-300 break-all select-all">${wh.query_params[k]}</td></tr>`)
            .join('');
        }
      }

      // Telemetry Tab
      const teleIp = document.getElementById('telemetry-ip');
      const teleSize = document.getElementById('telemetry-size');
      const teleFormat = document.getElementById('telemetry-format');
      if (teleIp) teleIp.textContent = wh.client_ip || wh.headers['cf-connecting-ip'] || '127.0.0.1';
      if (teleSize) teleSize.textContent = `${wh.size_bytes} Bytes`;
      if (teleFormat) teleFormat.textContent = (wh.format || 'json').toUpperCase();

      // Security Tab setup
      const sigBadge = document.getElementById('detected-provider-badge');
      const sigCode = document.getElementById('signature-recipe-code');
      const sigDot = document.getElementById('signature-indicator-dot');
      const sigProviderSelect = document.getElementById('sig-provider-select');

      if (wh.signature_provider) {
        if (sigBadge) sigBadge.textContent = `${wh.signature_provider} Signature Detected`;
        if (sigDot) sigDot.classList.remove('hidden');
        if (sigProviderSelect) {
          const lower = wh.signature_provider.toLowerCase();
          if (['stripe', 'github', 'shopify', 'slack', 'svix', 'lemonsqueezy'].includes(lower)) {
            sigProviderSelect.value = lower;
          }
        }
        if (sigCode) {
          sigCode.textContent = `// ${wh.signature_provider} Verification Recipe (Node.js)\nconst crypto = require('crypto');\nconst sig = headers['${wh.signature_provider.toLowerCase()}-signature'];\nconst expected = crypto.createHmac('sha256', SECRET).update(rawBody).digest('hex');\nconst isValid = crypto.timingSafeEqual(Buffer.from(sig), Buffer.from(expected));`;
        }
      } else {
        if (sigBadge) sigBadge.textContent = 'No Signature Header';
        if (sigDot) sigDot.classList.add('hidden');
        if (sigCode) sigCode.textContent = `// Standard HMAC-SHA256 Recipe\nconst crypto = require('crypto');\nconst hash = crypto.createHmac('sha256', SECRET).update(rawBody).digest('hex');`;
      }

      currentTab = window.__appState ? window.__appState.currentTab : currentTab;
      window.switchInspectorTab(currentTab);
    }

    // Delete single webhook
    const deleteSingleBtn = document.getElementById('delete-single-wh-btn');
    if (deleteSingleBtn) {
      deleteSingleBtn.addEventListener('click', () => {
        if (!selectedWebhookId) return;
        webhooks = webhooks.filter(w => w.id !== selectedWebhookId);
        selectedWebhookId = webhooks.length > 0 ? webhooks[0].id : null;
        saveToLocalStorage();
        renderTimeline();
        if (selectedWebhookId) {
          selectWebhook(selectedWebhookId);
        } else {
          if (inspectorZeroState) inspectorZeroState.classList.remove('hidden');
          if (inspectorHeaderBar) inspectorHeaderBar.classList.add('hidden');
          if (inspectorTabsNav) inspectorTabsNav.classList.add('hidden');
          document.querySelectorAll('.tab-panel').forEach((p) => p.classList.add('hidden'));
        }
      });
    }

    // Method Filter Buttons
    document.querySelectorAll('.method-filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeFilter = btn.getAttribute('data-filter') || 'ALL';
        document.querySelectorAll('.method-filter-btn').forEach((b) => {
          b.className = 'method-filter-btn px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700 cursor-pointer';
        });
        btn.className = 'method-filter-btn px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 font-bold active-filter cursor-pointer';
        renderTimeline();
      });
    });

    // Copy Body
    if (copyBodyBtn) {
      copyBodyBtn.addEventListener('click', () => {
        const wh = webhooks.find((w) => w.id === selectedWebhookId);
        if (wh) {
          copyToClipboard(wh.body || '', copyBodyBtn, 'Copy Body');
        }
      });
    }

    // Copy cURL
    if (copyCurlBtn) {
      copyCurlBtn.addEventListener('click', () => {
        const wh = webhooks.find((w) => w.id === selectedWebhookId);
        if (!wh) return;
        const curlCmd = `curl -X ${wh.method} "${fullWebhookUrl}" \\\n  -H "Content-Type: application/json" \\\n  -d '${(wh.body || '').replace(/'/g, "'\\''")}'`;
        copyToClipboard(curlCmd, document.getElementById('curl-btn-text'), 'Copy cURL');
      });
    }

    // Export Session
    if (exportSessionBtn) {
      exportSessionBtn.addEventListener('click', () => {
        const blob = new Blob([JSON.stringify(webhooks, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `webhooks-${activeEndpointId}-${new Date().toISOString().slice(0, 10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
      });
    }

    // Clear Logs
    if (clearLogsBtn) {
      clearLogsBtn.addEventListener('click', async () => {
        if (confirm('Clear all captured webhook logs for this endpoint?')) {
          webhooks = [];
          selectedWebhookId = null;
          saveToLocalStorage();
          fetch(`/api/poll/${activeEndpointId}`, { method: 'DELETE' }).catch(() => {});
          renderTimeline();
          if (inspectorZeroState) inspectorZeroState.classList.remove('hidden');
          if (inspectorHeaderBar) inspectorHeaderBar.classList.add('hidden');
          if (inspectorTabsNav) inspectorTabsNav.classList.add('hidden');
          document.querySelectorAll('.tab-panel').forEach((p) => p.classList.add('hidden'));
        }
      });
    }

    // Search Input
    if (searchInput) {
      searchInput.addEventListener('input', () => renderTimeline());

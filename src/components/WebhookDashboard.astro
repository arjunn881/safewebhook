---
// Static template for empty cURL test command
const defaultEmptyCurl = `curl -X POST https://safewebhook.com/api/r/ep_dev_9a7d3b \\
  -H "Content-Type: application/json" \\
  -H "Stripe-Signature: t=1755541200,v1=98a3c4f912e742c..." \\
  -d '{"event": "payment_intent.succeeded", "amount": 4900, "currency": "usd"}'`;
---

<!-- Strict robot crawler prevention inside dashboard view -->
<meta name="robots" content="noindex, nofollow" />

<!-- ============================================================ -->
<!-- CRITICAL: Global Functions - must run BEFORE any onclick attr -->
<!-- ============================================================ -->
<script is:inline>
  window.switchInspectorTab = function(tabId) {
    document.querySelectorAll('.tab-btn').forEach(function(btn) {
      if (btn.getAttribute('data-tab') === tabId) {
        btn.className = 'tab-btn py-3 border-b-2 border-cyan-400 text-cyan-300 font-semibold active-tab flex items-center gap-1.5 cursor-pointer flex-shrink-0';
      } else {
        btn.className = 'tab-btn py-3 border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition-colors flex items-center gap-1.5 cursor-pointer flex-shrink-0';
      }
    });
    document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.add('hidden'); });
    var panel = document.getElementById('tab-panel-' + tabId);
    if (panel) panel.classList.remove('hidden');
    if (window.__appState) window.__appState.currentTab = tabId;
  };

  window.openAppModal = function(modalId) {
    var el = document.getElementById(modalId);
    if (el) el.classList.remove('hidden');
    if (modalId === 'code-modal' && typeof window.__renderExportCode === 'function') {
      window.__renderExportCode();
    }
    if (modalId === 'endpoint-modal' && typeof window.__renderEndpointList === 'function') {
      window.__renderEndpointList();
    }
  };

  window.closeAppModal = function(modalId) {
    var el = document.getElementById(modalId);
    if (el) el.classList.add('hidden');
  };

  window.__appState = { currentTab: 'body' };
</script>

<div class="flex flex-col h-screen bg-slate-950 text-slate-100 overflow-hidden select-none font-sans" id="app-root">
  
  <!-- TOP UTILITY BAR: Brand, SSE Telemetry, Endpoint URL, Inbound Email, Workflows, Monitors -->
  <header class="flex-shrink-0 h-16 border-b border-slate-800 bg-slate-900/95 px-3 sm:px-5 flex items-center justify-between gap-3 z-20 backdrop-blur-md">
    
    <!-- Brand Title & Connection Status -->
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-2 text-slate-200 hover:text-white transition-colors group">
        <div class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 group-hover:border-cyan-400 transition-colors shadow-sm shadow-cyan-500/10">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-bold text-sm tracking-tight hidden sm:inline">Safe<span class="text-cyan-400">Webhook</span></span>
          <span class="text-[10px] text-slate-400 -mt-1 font-mono hidden sm:inline">safewebhook.com</span>
        </div>
      </a>

      <div class="h-4 w-px bg-slate-800 hidden sm:block"></div>

      <!-- Live Stream SSE Connection Badge & Stream Pause Control -->
      <div class="flex items-center gap-1.5">
        <div id="connection-status-badge" class="flex items-center gap-2 px-2.5 py-1 rounded-full bg-slate-950/80 border border-slate-800 text-xs font-mono">
          <span class="relative flex h-2 w-2">
            <span id="conn-ping" class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span id="conn-dot" class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span id="conn-text" class="text-slate-300 text-[11px] font-medium hidden lg:inline">Live SSE Stream</span>
          <span id="conn-text-mobile" class="text-slate-300 text-[11px] font-medium lg:hidden">Live</span>
        </div>

        <button
          id="toggle-pause-stream-btn"
          type="button"
          class="h-7 px-2 rounded-md bg-slate-800/80 hover:bg-slate-700 text-slate-400 hover:text-cyan-300 border border-slate-700/80 text-[10px] font-mono flex items-center gap-1 transition-colors cursor-pointer"
          title="Pause or resume live incoming requests"
        >
          <span id="stream-pause-icon">⏸</span>
          <span id="stream-pause-text" class="hidden md:inline">Pause</span>
        </button>
      </div>
    </div>

    <!-- Center & Right: Webhook Tracking URL String, Inbound Email & Tools -->
    <div class="flex items-center gap-2 flex-1 max-w-4xl justify-end">
      
      <!-- Generated Tracking URL Field -->
      <div class="relative flex items-center flex-1 min-w-[180px] max-w-sm group">
        <span class="absolute left-2.5 text-cyan-400 font-bold text-[10px] font-mono pointer-events-none hidden sm:inline">URL</span>
        <input
          id="endpoint-url-input"
          type="text"
          readonly
          value="https://safewebhook.com/api/r/ep_dev_9a7d3b"
          class="w-full h-8 sm:h-9 pl-2 sm:pl-10 pr-16 sm:pr-20 rounded-lg bg-slate-950 border border-cyan-500/40 focus:border-cyan-400 text-xs font-mono text-cyan-300 select-all outline-none transition-all shadow-inner"
        />

        <!-- "Copy URL" Action Button -->
        <button
          id="copy-link-btn"
          type="button"
          class="absolute right-1 px-2.5 h-6 sm:h-7 rounded-md bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-bold text-xs flex items-center gap-1 transition-all active:scale-95 shadow-sm cursor-pointer"
          title="Copy webhook tracking URL"
        >
          <svg id="copy-icon" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span id="copy-link-text">Copy</span>
        </button>
      </div>

      <!-- Inbound Email Address Pill & Copy -->
      <div class="relative hidden 2xl:flex items-center max-w-xs group">
        <input
          id="endpoint-email-input"
          type="text"
          readonly
          value="ep_dev_9a7d3b@safewebhook.com"
          class="w-full h-8 sm:h-9 pl-3 pr-16 rounded-lg bg-slate-950 border border-slate-700/80 text-xs font-mono text-purple-300 select-all outline-none"
        />
        <button
          id="copy-email-btn"
          type="button"
          class="absolute right-1 px-2 h-6 sm:h-7 rounded-md bg-purple-500/10 hover:bg-purple-500/20 text-purple-400 border border-purple-500/30 text-xs font-medium flex items-center gap-1 transition-all active:scale-95 cursor-pointer"
          title="Copy matching Inbound Email Address"
        >
          <span>Email</span>
        </button>
      </div>

      <!-- Endpoints Switcher / Manager Trigger -->
      <button
        id="open-endpoint-mgr-btn"
        type="button"
        onclick="window.openAppModal('endpoint-modal')"
        class="h-8 sm:h-9 px-2 sm:px-2.5 rounded-lg bg-slate-800/80 hover:bg-slate-750 text-cyan-300 border border-slate-700 text-xs font-medium flex items-center gap-1 transition-colors cursor-pointer"
        title="Manage endpoints, switch sessions, or create custom slugs"
      >
        <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        <span class="hidden md:inline font-mono">Endpoints</span>
      </button>

      <!-- Custom Request Composer Trigger -->
      <button
        id="open-composer-btn"
        type="button"
        onclick="window.openAppModal('composer-modal')"
        class="h-8 sm:h-9 px-2 sm:px-2.5 rounded-lg bg-gradient-to-r from-cyan-500/20 to-blue-500/20 hover:from-cyan-500/30 hover:to-blue-500/30 text-cyan-300 border border-cyan-500/30 text-xs font-medium flex items-center gap-1 transition-colors cursor-pointer"
        title="Compose and dispatch custom HTTP webhooks"
      >
        <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
        </svg>
        <span class="hidden sm:inline font-mono">Compose</span>
      </button>

      <!-- Localhost Forwarder Helper Trigger -->
      <button
        id="open-forwarder-btn"
        type="button"
        onclick="window.openAppModal('forwarder-modal')"
        class="h-8 sm:h-9 px-2 sm:px-2.5 rounded-lg bg-slate-800/80 hover:bg-slate-750 text-amber-300 border border-amber-500/30 text-xs font-medium hidden lg:flex items-center gap-1 transition-colors cursor-pointer"
        title="Forward webhooks directly to http://localhost without ngrok"
      >
        <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>Localhost</span>
      </button>

      <!-- Custom Response Configurator Trigger Button -->
      <button
        id="open-config-btn"
        type="button"
        onclick="window.openAppModal('config-modal')"
        class="h-8 sm:h-9 px-2 sm:px-2.5 rounded-lg bg-slate-800/80 hover:bg-slate-750 text-cyan-300 border border-cyan-500/30 text-xs font-medium flex items-center gap-1 transition-colors shadow-sm cursor-pointer"
        title="Customize HTTP status code, custom headers, body and latency delay"
      >
        <span class="hidden sm:inline font-mono">Response</span>
        <span id="config-status-badge" class="px-1 py-0.2 rounded text-[10px] font-mono bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">200</span>
      </button>

      <!-- Workflows Studio Trigger -->
      <button
        id="open-workflow-btn"
        type="button"
        onclick="window.openAppModal('workflow-modal')"
        class="h-8 sm:h-9 px-2 sm:px-2.5 rounded-lg bg-slate-800/80 hover:bg-slate-750 text-purple-300 border border-purple-500/30 text-xs font-medium hidden sm:flex items-center gap-1 transition-colors cursor-pointer"
        title="Configure Custom Workflows, JS Transformers, Auto-Forwarding Rules & Alerts"
      >
        <svg class="w-3.5 h-3.5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
        </svg>
        <span class="hidden xl:inline">Workflows</span>
      </button>

      <!-- Uptime / SSL Monitor Trigger -->
      <button
        id="open-monitor-btn"
        type="button"
        onclick="window.openAppModal('monitor-modal')"
        class="h-8 sm:h-9 px-2 sm:px-2.5 rounded-lg bg-slate-800/80 hover:bg-slate-750 text-emerald-300 border border-emerald-500/30 text-xs font-medium hidden md:flex items-center gap-1 transition-colors cursor-pointer"
        title="Schedule automated uptime pings, SSL certificate checks & cron monitors"
      >
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        <span class="hidden xl:inline">Monitors</span>
      </button>

      <!-- Mock Event Generator Trigger -->
      <button
        id="open-mock-btn"
        type="button"
        onclick="window.openAppModal('mock-modal')"
        class="h-8 sm:h-9 px-2 rounded-lg bg-slate-800/80 hover:bg-slate-750 text-slate-300 hover:text-white border border-slate-700 text-xs font-medium flex items-center gap-1 transition-colors cursor-pointer"
        title="Simulate realistic Stripe, GitHub, Shopify, or Slack webhooks"
      >
        <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span class="hidden lg:inline">Mock</span>
      </button>

      <!-- Documentation Link -->
      <a
        href="/docs"
        class="h-8 sm:h-9 px-2 rounded-lg bg-slate-800/50 hover:bg-slate-800 text-slate-400 hover:text-cyan-300 border border-slate-700/60 text-xs font-medium inline-flex items-center gap-1 transition-colors"
        title="View integration guides and docs"
      >
        <span>Docs</span>
      </a>
    </div>
  </header>

  <!-- TWO-COLUMN WORKSPACE: Timeline Side-Panel (Left) & Inspection Workspace (Right) -->
  <main class="flex-1 flex overflow-hidden">
    
    <!-- LEFT COLUMN (Narrow): Captured Webhook Timeline Inbox with Search & Filters -->
    <aside class="w-full md:w-80 lg:w-96 flex-shrink-0 border-r border-slate-800 bg-slate-900/50 flex flex-col h-full overflow-hidden">
      
      <!-- Timeline Header: Counter & Action Tools (Filter, Clear, Export, Import) -->
      <div class="p-3 border-b border-slate-800 bg-slate-900/90 space-y-2.5">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-300 font-mono">Requests</span>
            <span id="webhook-count-badge" class="px-2 py-0.5 rounded-full text-[11px] font-mono bg-cyan-500/10 text-cyan-400 border border-cyan-500/30">0</span>
          </div>
          
          <div class="flex items-center gap-1">
            <button
              id="export-session-btn"
              type="button"
              class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] font-medium border border-slate-700 transition-colors cursor-pointer"
              title="Export captured requests as JSON"
            >
              Export
            </button>
            <button
              id="import-session-trigger"
              type="button"
              onclick="window.openAppModal('import-modal')"
              class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] font-medium border border-slate-700 transition-colors cursor-pointer"
              title="Import previously exported session JSON"
            >
              Import
            </button>
            <button
              id="clear-logs-btn"
              type="button"
              class="px-2 py-1 rounded bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 hover:text-rose-300 text-[11px] font-medium border border-rose-500/30 transition-colors cursor-pointer"
              title="Clear all logs for active endpoint"
            >
              Clear
            </button>
          </div>
        </div>

        <!-- Real-Time Substring Search Input -->
        <div class="relative">
          <svg class="w-3.5 h-3.5 absolute left-2.5 top-2.5 text-slate-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            id="search-input"
            type="text"
            placeholder="Search headers, body, method, IP..."
            class="w-full h-8 pl-8 pr-3 rounded-lg bg-slate-950 border border-slate-800 focus:border-cyan-500/60 text-xs font-mono text-slate-200 placeholder-slate-500 outline-none transition-all"
          />
        </div>

        <!-- HTTP Method Filter Pills -->
        <div class="flex items-center gap-1 overflow-x-auto pb-1 text-[10px] font-mono scrollbar-none" id="method-filters">
          <button data-filter="ALL" class="method-filter-btn px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 font-bold active-filter cursor-pointer">ALL</button>
          <button data-filter="POST" class="method-filter-btn px-2 py-0.5 rounded bg-slate-800 text-slate-400 hover:text-emerald-400 hover:bg-emerald-500/10 border border-slate-700 cursor-pointer">POST</button>
          <button data-filter="GET" class="method-filter-btn px-2 py-0.5 rounded bg-slate-800 text-slate-400 hover:text-sky-400 hover:bg-sky-500/10 border border-slate-700 cursor-pointer">GET</button>
          <button data-filter="PUT" class="method-filter-btn px-2 py-0.5 rounded bg-slate-800 text-slate-400 hover:text-amber-400 hover:bg-amber-500/10 border border-slate-700 cursor-pointer">PUT</button>
          <button data-filter="DELETE" class="method-filter-btn px-2 py-0.5 rounded bg-slate-800 text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 border border-slate-700 cursor-pointer">DEL</button>
          <button data-filter="PATCH" class="method-filter-btn px-2 py-0.5 rounded bg-slate-800 text-slate-400 hover:text-purple-400 hover:bg-purple-500/10 border border-slate-700 cursor-pointer">PATCH</button>
          <button data-filter="EMAIL" class="method-filter-btn px-2 py-0.5 rounded bg-slate-800 text-slate-400 hover:text-fuchsia-400 hover:bg-fuchsia-500/10 border border-slate-700 cursor-pointer">EMAIL</button>
        </div>
      </div>

      <!-- Timeline List: Scrollable Container -->
      <div id="timeline-container" class="flex-1 overflow-y-auto divide-y divide-slate-800/60 focus:outline-none">
        
        <!-- Empty State in Timeline -->
        <div id="timeline-empty-state" class="p-8 text-center space-y-3 my-auto">
          <div class="w-12 h-12 rounded-full bg-slate-800/80 border border-slate-700 flex items-center justify-center mx-auto text-slate-500">
            <svg class="w-6 h-6 animate-pulse text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div class="space-y-1">
            <h4 class="text-sm font-semibold text-slate-300">Listening for Webhooks &amp; Emails</h4>
            <p class="text-xs text-slate-400 leading-relaxed max-w-xs mx-auto">
              Send a request to your endpoint URL or compose a custom webhook. Events will appear here in real-time.
            </p>
          </div>
          <div class="flex flex-col gap-2 pt-1">
            <button
              id="empty-mock-trigger"
              type="button"
              class="px-3 py-1.5 rounded-lg bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-xs font-mono transition-colors cursor-pointer"
            >
              ⚡ Dispatch Mock Event
            </button>
            <button
              type="button"
              onclick="window.openAppModal('composer-modal')"
              class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-mono transition-colors cursor-pointer"
            >
              📝 Open Request Composer
            </button>
          </div>
        </div>

        <!-- Dynamic List Elements Injected by Client JS -->
        <ul id="timeline-list" class="divide-y divide-slate-800/50"></ul>
      </div>

    </aside>

    <!-- RIGHT COLUMN (Wide): Webhook Inspection Workspace -->
    <section class="flex-1 flex flex-col h-full bg-slate-950 overflow-hidden" id="inspector-workspace">
      
      <!-- Selected Webhook Header Summary Bar -->
      <div id="inspector-header-bar" class="flex-shrink-0 h-16 border-b border-slate-800 bg-slate-900/80 px-4 sm:px-6 flex items-center justify-between gap-4 hidden">
        <div class="flex items-center gap-3 min-w-0">
          <span id="ins-method-badge" class="px-2.5 py-1 rounded text-xs font-mono font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">POST</span>
          <div class="flex flex-col min-w-0">
            <span id="ins-summary-text" class="text-sm font-semibold text-white font-mono truncate">payment_intent.succeeded</span>
            <span id="ins-meta-text" class="text-[11px] text-slate-400 font-mono">1.4 KB • 127.0.0.1 • 12:45:02</span>
          </div>
        </div>

        <!-- Top Right Action Controls (Replay, Code Export, Copy cURL, Delete Single) -->
        <div class="flex items-center gap-2">
          <!-- Replay Button -->
          <button
            id="replay-drawer-btn"
            type="button"
            onclick="window.openAppModal('replay-modal')"
            class="px-3 py-1.5 rounded-lg bg-gradient-to-r from-cyan-500/20 to-teal-500/20 hover:from-cyan-500/30 hover:to-teal-500/30 text-cyan-300 border border-cyan-500/40 text-xs font-mono font-semibold flex items-center gap-1.5 transition-all shadow-sm active:scale-95 cursor-pointer"
            title="Replay this request to localhost or remote API"
          >
            <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span>Replay</span>
          </button>

          <!-- Export Code Button -->
          <button
            id="open-code-modal-btn"
            type="button"
            onclick="window.openAppModal('code-modal')"
            class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-750 text-slate-300 hover:text-white border border-slate-700 text-xs font-mono flex items-center gap-1.5 transition-colors cursor-pointer"
            title="Export request code in 9+ programming languages"
          >
            <svg class="w-3.5 h-3.5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
            <span class="hidden sm:inline">Export Code</span>
          </button>

          <!-- Copy as cURL Button -->
          <button

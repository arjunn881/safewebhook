      >
        <svg class="w-3.5 h-3.5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
        </svg>
        <span class="hidden md:inline">Workflows</span>
      </button>

      <!-- Uptime / SSL Monitor Trigger -->
      <button
        id="open-monitor-btn"
        type="button"
        onclick="window.openAppModal('monitor-modal')"
        class="h-8 sm:h-9 px-2 sm:px-2.5 rounded-lg bg-slate-800/80 hover:bg-slate-750 text-emerald-300 border border-emerald-500/30 text-xs font-medium flex items-center gap-1 transition-colors cursor-pointer"
        title="Schedule automated uptime pings, SSL certificate checks & cron monitors"
      >
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        <span class="hidden md:inline">Monitors</span>
      </button>

      <!-- Custom Domain Trigger -->
      <button
        id="open-domain-btn"
        type="button"
        onclick="window.openAppModal('domain-modal')"
        class="h-8 sm:h-9 px-2 rounded-lg bg-slate-800/80 hover:bg-slate-750 text-slate-300 border border-slate-700 text-xs font-medium hidden lg:flex items-center gap-1 transition-colors cursor-pointer"
        title="Configure branded custom domain CNAME"
      >
        <svg class="w-3.5 h-3.5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
        </svg>
        <span>Domain</span>
      </button>

      <!-- Mock Event Generator Trigger -->
      <button
        id="open-mock-btn"
        type="button"
        onclick="window.openAppModal('mock-modal')"
        class="h-8 sm:h-9 px-2 rounded-lg bg-slate-800/80 hover:bg-slate-750 text-slate-300 hover:text-white border border-slate-700 text-xs font-medium flex items-center gap-1 transition-colors cursor-pointer"
        title="Simulate realistic Stripe, GitHub, Shopify, or Slack webhooks"
      >
        <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span class="hidden lg:inline">Mock</span>
      </button>

      <!-- Documentation Shortcut Link -->
      <a
        href="/docs"

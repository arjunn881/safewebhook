---
/**
 * SafeWebhook Workspace — the /app debugging surface.
 *
 * Shell only: the header, the resizable request list, the inspector, the modal
 * layer and the client runtime. Every style lives in ../styles/app.css and all
 * behaviour in ../scripts/app/*, so nothing here touches the marketing pages.
 */
import '../styles/app.css';
import AppHeader from './app/AppHeader.astro';
import RequestList from './app/RequestList.astro';
import Inspector from './app/Inspector.astro';
import AppModals from './app/AppModals.astro';
---

<div id="swh">
  <AppHeader />

  <div id="swh-main" data-view="list">
    <RequestList />
    <div id="swh-grip" role="separator" aria-orientation="vertical" aria-label="Resize the request list" tabindex="0"></div>
    <Inspector />
  </div>

  <footer id="swh-status">
    <span class="swh-st" title="Active endpoint"><b id="swh-st-ep">…</b></span>
    <span class="swh-st" title="Requests held in this browser"><b id="swh-st-total">0</b> captured</span>
    <span class="swh-st" title="Live delivery channel"><b id="swh-st-sse">connecting</b></span>
    <span class="swh-st swh-hide-lg" title="Local storage used by this endpoint"><b id="swh-st-store">0 KB</b></span>
    <span class="swh-st" title="Most recent request"><b id="swh-st-last">no traffic yet</b></span>
    <span class="swh-st swh-mla swh-hide-md">Press <kbd>?</kbd> for shortcuts</span>
  </footer>

  <div id="swh-toasts" aria-live="polite" aria-atomic="false"></div>

  <AppModals />
</div>

<script>
  import { boot } from '../scripts/app/main.js';
  boot();
</script>

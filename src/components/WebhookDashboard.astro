        <span>FAQ</span>
      </a>
    </div>
  </header>

  <!-- TWO-COLUMN WORKSPACE: Timeline Side-Panel (Left) & Inspection Workspace (Right) -->
  <main class="flex-1 flex overflow-hidden">
    
    <!-- LEFT COLUMN (Narrow): Captured Webhook Timeline Inbox with Search & Filters -->
    <aside class="w-full md:w-80 lg:w-96 flex-shrink-0 border-r border-slate-800 bg-slate-900/50 flex flex-col h-full overflow-hidden">
      
      <!-- Timeline Header: Counter & Action Tools (Filter, Clear, Export) -->
      <div class="p-3 border-b border-slate-800 bg-slate-900/90 space-y-2.5">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-300 font-mono">Requests</span>
            <span id="webhook-count-badge" class="px-2 py-0.5 rounded-full text-[11px] font-mono bg-cyan-500/10 text-cyan-400 border border-cyan-500/30">0</span>
          </div>
          
          <div class="flex items-center gap-1.5">
            <button
              id="export-session-btn"
              type="button"
              class="px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] font-medium border border-slate-700 transition-colors"
              title="Export captured requests as JSON"
            >
              Export
            </button>
            <button
              id="clear-logs-btn"
              type="button"
              class="px-2 py-1 rounded bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 hover:text-rose-300 text-[11px] font-medium border border-rose-500/30 transition-colors"
              title="Clear all local logs"
            >
              Clear
            </button>
          </div>
        </div>

        <!-- Real-Time Substring Search Input -->
        <div class="relative">
          <svg class="w-3.5 h-3.5 absolute left-2.5 top-2.5 text-slate-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            id="search-input"
            type="text"
            placeholder="Search headers, body, method, IP..."
            class="w-full h-8 pl-8 pr-3 rounded-lg bg-slate-950 border border-slate-800 focus:border-cyan-500/60 text-xs font-mono text-slate-200 placeholder-slate-500 outline-none transition-all"
          />
        </div>

        <!-- HTTP Method Filter Pills -->
        <div class="flex items-center gap-1 overflow-x-auto pb-1 text-[10px] font-mono scrollbar-none" id="method-filters">
          <button data-filter="ALL" class="method-filter-btn px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 font-bold active-filter">ALL</button>
          <button data-filter="POST" class="method-filter-btn px-2 py-0.5 rounded bg-slate-800 text-slate-400 hover:text-emerald-400 hover:bg-emerald-500/10 border border-slate-700">POST</button>
          <button data-filter="GET" class="method-filter-btn px-2 py-0.5 rounded bg-slate-800 text-slate-400 hover:text-sky-400 hover:bg-sky-500/10 border border-slate-700">GET</button>
          <button data-filter="PUT" class="method-filter-btn px-2 py-0.5 rounded bg-slate-800 text-slate-400 hover:text-amber-400 hover:bg-amber-500/10 border border-slate-700">PUT</button>
          <button data-filter="DELETE" class="method-filter-btn px-2 py-0.5 rounded bg-slate-800 text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 border border-slate-700">DEL</button>
          <button data-filter="PATCH" class="method-filter-btn px-2 py-0.5 rounded bg-slate-800 text-slate-400 hover:text-purple-400 hover:bg-purple-500/10 border border-slate-700">PATCH</button>
          <button data-filter="EMAIL" class="method-filter-btn px-2 py-0.5 rounded bg-slate-800 text-slate-400 hover:text-fuchsia-400 hover:bg-fuchsia-500/10 border border-slate-700">EMAIL</button>
        </div>
      </div>

      <!-- Timeline List: Scrollable Container -->
      <div id="timeline-container" class="flex-1 overflow-y-auto divide-y divide-slate-800/60 focus:outline-none">
        
        <!-- Empty State in Timeline -->
        <div id="timeline-empty-state" class="p-8 text-center space-y-3 my-auto">
          <div class="w-12 h-12 rounded-full bg-slate-800/80 border border-slate-700 flex items-center justify-center mx-auto text-slate-500">
            <svg class="w-6 h-6 animate-pulse text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div class="space-y-1">
            <h4 class="text-sm font-semibold text-slate-300">Listening for Webhooks &amp; Emails</h4>
            <p class="text-xs text-slate-400 leading-relaxed max-w-xs mx-auto">
              Send a request to your unique endpoint URL or email address. New events will appear here in real-time.
            </p>
          </div>
          <button
            id="empty-mock-trigger"
            type="button"
            class="mt-2 px-3 py-1.5 rounded-lg bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-xs font-mono transition-colors"
          >
            Dispatch Mock Event &rarr;
          </button>
        </div>

        <!-- Dynamic List Elements Injected by Client JS -->
        <ul id="timeline-list" class="divide-y divide-slate-800/50"></ul>
      </div>

    </aside>

    <!-- RIGHT COLUMN (Wide): Webhook Inspection Workspace -->
    <section class="flex-1 flex flex-col h-full bg-slate-950 overflow-hidden" id="inspector-workspace">
      
      <!-- Selected Webhook Header Summary Bar -->
      <div id="inspector-header-bar" class="flex-shrink-0 h-16 border-b border-slate-800 bg-slate-900/80 px-6 flex items-center justify-between gap-4 hidden">
        <div class="flex items-center gap-3 min-w-0">
          <span id="ins-method-badge" class="px-2.5 py-1 rounded text-xs font-mono font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">POST</span>
          <div class="flex flex-col min-w-0">
            <span id="ins-summary-text" class="text-sm font-semibold text-white font-mono truncate">customer.subscription.created</span>
            <span id="ins-meta-text" class="text-[11px] text-slate-400 font-mono">1.4 KB • 127.0.0.1 • 12:45:02</span>
          </div>
        </div>

        <!-- Top Right Action Controls (Replay, Code Export, Copy cURL) -->
        <div class="flex items-center gap-2">
          <!-- Replay Button -->
          <button
            id="replay-drawer-btn"
            type="button"
            onclick="window.openAppModal('replay-modal')"
            class="px-3 py-1.5 rounded-lg bg-gradient-to-r from-cyan-500/20 to-teal-500/20 hover:from-cyan-500/30 hover:to-teal-500/30 text-cyan-300 border border-cyan-500/40 text-xs font-mono font-semibold flex items-center gap-1.5 transition-all shadow-sm active:scale-95 cursor-pointer"
            title="Replay this request to localhost or remote API"
          >
            <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span>Replay</span>
          </button>

          <!-- Export Code Button -->
          <button
            id="open-code-modal-btn"
            type="button"
            onclick="window.openAppModal('code-modal')"
            class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-750 text-slate-300 hover:text-white border border-slate-700 text-xs font-mono flex items-center gap-1.5 transition-colors cursor-pointer"
            title="Export request code in 8+ programming languages"
          >
            <svg class="w-3.5 h-3.5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
            <span>Export Code</span>
          </button>

          <!-- Copy as cURL Button -->
          <button
            id="copy-curl-btn"
            type="button"
            class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-750 text-slate-300 hover:text-white border border-slate-700 text-xs font-mono flex items-center gap-1.5 transition-colors active:scale-95"
            title="Copy as bash cURL command"
          >
            <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span id="curl-btn-text">Copy cURL</span>
          </button>
        </div>
      </div>

      <!-- Super-Tabs Navigation Bar -->
      <div id="inspector-tabs-nav" class="flex-shrink-0 px-6 border-b border-slate-800 bg-slate-950 flex items-center gap-6 text-xs font-mono hidden">
        <button type="button" onclick="window.switchInspectorTab('body')" data-tab="body" class="tab-btn py-3 border-b-2 border-cyan-400 text-cyan-300 font-semibold active-tab flex items-center gap-1.5 cursor-pointer">
          <span>Structured Body</span>
        </button>
        <button type="button" onclick="window.switchInspectorTab('headers')" data-tab="headers" class="tab-btn py-3 border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition-colors flex items-center gap-1.5 cursor-pointer">
          <span>Parsed Headers</span>
          <span id="headers-count-pill" class="px-1.5 py-0.2 rounded-full text-[10px] bg-slate-800 text-slate-300">0</span>
        </button>
        <button type="button" onclick="window.switchInspectorTab('query')" data-tab="query" class="tab-btn py-3 border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition-colors flex items-center gap-1.5 cursor-pointer">
          <span>Query Params</span>
          <span id="query-count-pill" class="px-1.5 py-0.2 rounded-full text-[10px] bg-slate-800 text-slate-300">0</span>
        </button>
        <button type="button" onclick="window.switchInspectorTab('security')" data-tab="security" class="tab-btn py-3 border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition-colors flex items-center gap-1.5 cursor-pointer">
          <span>Security &amp; Signature</span>
          <span id="signature-indicator-dot" class="w-2 h-2 rounded-full bg-emerald-400 hidden"></span>
        </button>
        <button type="button" onclick="window.switchInspectorTab('telemetry')" data-tab="telemetry" class="tab-btn py-3 border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition-colors flex items-center gap-1.5 cursor-pointer">
          <span>Geo &amp; TLS</span>
        </button>
        <button type="button" onclick="window.switchInspectorTab('raw')" data-tab="raw" class="tab-btn py-3 border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition-colors cursor-pointer">
          <span>Raw Payload</span>
        </button>

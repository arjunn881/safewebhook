---
export interface Props {
  activeNav?: 'integrations' | 'tools' | 'vs' | 'errors' | 'guides' | 'docs' | 'faq' | 'home';
  subTitle?: string;
  transparent?: boolean;
}

const { activeNav = 'home', subTitle, transparent = false } = Astro.props;

const headerClasses = transparent
  ? "sticky top-0 z-50 w-full border-b border-transparent bg-gradient-to-b from-sky-500/10 dark:from-sky-500/15 via-transparent to-transparent transition-colors duration-200"
  : "sticky top-0 z-50 w-full border-b border-slate-200 dark:border-zinc-800 bg-white/90 dark:bg-[#070a12]/90 backdrop-blur-md transition-colors duration-200";
---

<header class={headerClasses} id="global-site-header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between gap-3">
    
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group flex-shrink-0" title="SafeWebhook Home">
      <div class="w-7 h-7 rounded-[7px] bg-gradient-to-br from-indigo-600 to-violet-600 flex items-center justify-center text-white font-sans font-black text-[10px] tracking-tight border border-indigo-400/30 group-hover:from-indigo-500 group-hover:to-violet-500 group-hover:scale-105 transition-all shadow-sm shadow-indigo-500/20 flex-shrink-0">
        SWH
      </div>
      <div class="flex items-center gap-2">
        <span class="font-bold tracking-tight text-slate-900 dark:text-white text-sm font-sans">
          Safe<span class="text-indigo-600 dark:text-indigo-400">Webhook</span>
        </span>
        {subTitle ? (
          <span class="text-[10px] text-slate-500 dark:text-zinc-400 font-mono hidden sm:inline">{subTitle}</span>
        ) : (
          <span class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-slate-100 dark:bg-zinc-900 text-slate-600 dark:text-zinc-400 border border-slate-200 dark:border-zinc-800 hidden sm:inline">v1.0</span>
        )}
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-5 text-xs font-medium text-slate-600 dark:text-zinc-400" aria-label="Main navigation">
      <a
        href="/integrations"
        class={`hover:text-slate-900 dark:hover:text-white transition-colors ${activeNav === 'integrations' ? 'text-indigo-600 dark:text-indigo-400 font-semibold' : ''}`}
      >
        Integrations
      </a>
      <a
        href="/tools"
        class={`hover:text-slate-900 dark:hover:text-white transition-colors ${activeNav === 'tools' ? 'text-indigo-600 dark:text-indigo-400 font-semibold' : ''}`}
      >
        Tools
      </a>
      <a
        href="/vs"
        class={`hover:text-slate-900 dark:hover:text-white transition-colors ${activeNav === 'vs' ? 'text-indigo-600 dark:text-indigo-400 font-semibold' : ''}`}
      >
        Compare
      </a>
      <a
        href="/errors"
        class={`hover:text-slate-900 dark:hover:text-white transition-colors ${activeNav === 'errors' ? 'text-indigo-600 dark:text-indigo-400 font-semibold' : ''}`}
      >
        Errors
      </a>
      <a
        href="/guides"
        class={`hover:text-slate-900 dark:hover:text-white transition-colors ${activeNav === 'guides' ? 'text-indigo-600 dark:text-indigo-400 font-semibold' : ''}`}
      >
        Guides
      </a>
      <a
        href="/faq"
        class={`hover:text-slate-900 dark:hover:text-white transition-colors ${activeNav === 'faq' ? 'text-indigo-600 dark:text-indigo-400 font-semibold' : ''}`}
      >
        FAQ
      </a>
      <a
        href="/docs"
        class={`hover:text-slate-900 dark:hover:text-white transition-colors ${activeNav === 'docs' ? 'text-indigo-600 dark:text-indigo-400 font-semibold' : ''}`}
      >
        Docs
      </a>
    </nav>


    <!-- Right Controls: Sleek Expert Segmented Theme Switcher + CTA -->
    <div class="flex items-center gap-2 sm:gap-3">
      
      <!-- DESKTOP SEGMENTED THEME TOGGLE (1-Click Switcher with Tooltip & ARIA) -->
      <div 
        class="hidden sm:inline-flex items-center p-0.5 rounded-lg bg-slate-100 dark:bg-zinc-900/90 border border-slate-200 dark:border-zinc-800 shadow-inner relative"
        role="radiogroup" 
        aria-label="Theme selector"
      >
        <!-- Bright (Light) Segment -->
        <button
          type="button"
          data-theme-choice="bright"
          role="radio"
          aria-checked="false"
          aria-label="Switch to Bright Light mode"
          title="Bright Mode (Clean Slate)"
          class="theme-seg-btn relative flex items-center justify-center p-1.5 rounded-md text-slate-500 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-all duration-150 cursor-pointer focus:outline-none focus-visible:ring-1 focus-visible:ring-indigo-500"
        >
          <svg class="w-3.5 h-3.5 transition-transform duration-200 hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4" stroke-width="2" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
          </svg>
          <span class="sr-only">Bright</span>
        </button>

        <!-- Obsidian (Dark) Segment -->
        <button
          type="button"
          data-theme-choice="obsidian"
          role="radio"
          aria-checked="true"
          aria-label="Switch to Dark Obsidian mode"
          title="Dark Mode (Obsidian)"
          class="theme-seg-btn relative flex items-center justify-center p-1.5 rounded-md text-slate-500 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-all duration-150 cursor-pointer focus:outline-none focus-visible:ring-1 focus-visible:ring-indigo-400"
        >
          <svg class="w-3.5 h-3.5 transition-transform duration-200 hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <span class="sr-only">Dark</span>
        </button>

        <!-- Midnight (Deep Blue) Segment -->
        <button
          type="button"
          data-theme-choice="midnight"
          role="radio"
          aria-checked="false"
          aria-label="Switch to Midnight mode"
          title="Midnight Mode (Deep Indigo & Violet)"
          class="theme-seg-btn relative flex items-center justify-center p-1.5 rounded-md text-slate-500 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-all duration-150 cursor-pointer focus:outline-none focus-visible:ring-1 focus-visible:ring-violet-400"
        >
          <svg class="w-3.5 h-3.5 transition-transform duration-200 hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
          </svg>
          <span class="sr-only">Midnight</span>
        </button>
      </div>

      <!-- MOBILE QUICK TOGGLE (Compact 1-Tap Morphing Button) -->
      <button
        type="button"
        id="mobile-quick-theme-toggle"
        class="sm:hidden p-2 rounded-lg border border-slate-200 dark:border-zinc-800 bg-slate-100 dark:bg-zinc-900 text-slate-700 dark:text-zinc-300 hover:bg-slate-200 dark:hover:bg-zinc-800 transition-all cursor-pointer flex items-center justify-center active:scale-95"
        aria-label="Cycle theme mode"
        title="Tap to toggle theme"
      >
        <svg id="mobile-theme-icon-sun" class="w-4 h-4 hidden text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4" stroke-width="2" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
        <svg id="mobile-theme-icon-moon" class="w-4 h-4 hidden text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <svg id="mobile-theme-icon-stars" class="w-4 h-4 hidden text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
        </svg>
      </button>

      <!-- Launch Workbench CTA -->
      <a
        href="/app"
        class="inline-flex items-center justify-center px-3.5 py-1.5 rounded-lg text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-500 transition-all shadow-sm shadow-indigo-500/25 flex-shrink-0 active:scale-95"
      >
        <span>Open App</span>
        <svg class="w-3.5 h-3.5 ml-1 hidden sm:inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>


      <!-- Mobile Hamburger Menu Button -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="lg:hidden p-1.5 rounded-lg text-slate-600 dark:text-zinc-400 hover:bg-slate-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer"
        aria-label="Open mobile menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu-drawer" class="hidden lg:hidden border-t border-slate-200 dark:border-zinc-800 bg-white dark:bg-[#070a12] px-4 py-4 space-y-4 shadow-xl">
    
    <!-- Mobile Full Theme Selector -->
    <div class="space-y-1.5">
      <div class="text-[11px] font-mono text-slate-500 dark:text-zinc-400 uppercase font-semibold">Theme Mode</div>
      <div class="grid grid-cols-3 gap-2">
        <button
          type="button"
          data-mobile-theme="bright"
          class="mobile-theme-opt px-3 py-2 rounded-lg border text-xs font-mono font-medium flex items-center justify-center gap-1.5 transition-all cursor-pointer border-slate-200 dark:border-zinc-800 text-slate-700 dark:text-zinc-300 hover:bg-slate-50 dark:hover:bg-zinc-900"
        >
          <span>☀️ Bright</span>
        </button>
        <button
          type="button"
          data-mobile-theme="obsidian"
          class="mobile-theme-opt px-3 py-2 rounded-lg border text-xs font-mono font-medium flex items-center justify-center gap-1.5 transition-all cursor-pointer border-slate-200 dark:border-zinc-800 text-slate-700 dark:text-zinc-300 hover:bg-slate-50 dark:hover:bg-zinc-900"
        >
          <span>🌑 Dark</span>
        </button>
        <button
          type="button"
          data-mobile-theme="midnight"
          class="mobile-theme-opt px-3 py-2 rounded-lg border text-xs font-mono font-medium flex items-center justify-center gap-1.5 transition-all cursor-pointer border-slate-200 dark:border-zinc-800 text-slate-700 dark:text-zinc-300 hover:bg-slate-50 dark:hover:bg-zinc-900"
        >
          <span>🌌 Midnight</span>
        </button>
      </div>
    </div>

    <!-- Navigation Hub Links -->
    <div class="grid grid-cols-2 gap-2 text-xs font-medium pt-2 border-t border-slate-100 dark:border-zinc-800/80">
      <a href="/integrations" class="p-2 rounded-lg bg-slate-50 dark:bg-zinc-900 text-slate-700 dark:text-zinc-300 hover:bg-slate-100 dark:hover:bg-zinc-800 transition-colors">Integrations (24+)</a>
      <a href="/tools" class="p-2 rounded-lg bg-slate-50 dark:bg-zinc-900 text-slate-700 dark:text-zinc-300 hover:bg-slate-100 dark:hover:bg-zinc-800 transition-colors">Developer Tools (12+)</a>
      <a href="/vs" class="p-2 rounded-lg bg-slate-50 dark:bg-zinc-900 text-slate-700 dark:text-zinc-300 hover:bg-slate-100 dark:hover:bg-zinc-800 transition-colors">Compare Alternatives</a>
      <a href="/errors" class="p-2 rounded-lg bg-slate-50 dark:bg-zinc-900 text-slate-700 dark:text-zinc-300 hover:bg-slate-100 dark:hover:bg-zinc-800 transition-colors">Error Diagnostics</a>
      <a href="/guides" class="p-2 rounded-lg bg-slate-50 dark:bg-zinc-900 text-slate-700 dark:text-zinc-300 hover:bg-slate-100 dark:hover:bg-zinc-800 transition-colors">Framework Guides</a>
      <a href="/faq" class="p-2 rounded-lg bg-slate-50 dark:bg-zinc-900 text-slate-700 dark:text-zinc-300 hover:bg-slate-100 dark:hover:bg-zinc-800 transition-colors">FAQ Knowledge Base</a>
      <a href="/docs" class="col-span-2 p-2 rounded-lg bg-slate-50 dark:bg-zinc-900 text-slate-700 dark:text-zinc-300 hover:bg-slate-100 dark:hover:bg-zinc-800 transition-colors text-center">API Documentation</a>
    </div>


  </div>
</header>

<script is:inline>
  (function initExpertThemeEngine() {
    var THEMES = ['bright', 'obsidian', 'midnight'];
    var themeMetaColors = {
      bright: '#ffffff',
      obsidian: '#070a12',
      midnight: '#050814'
    };

    function applyTheme(themeName, persist) {
      if (!themeName || THEMES.indexOf(themeName) === -1) {
        themeName = 'obsidian';
      }

      document.documentElement.setAttribute('data-theme', themeName);

      if (themeName === 'bright' || themeName === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
      }

      // Update mobile browser header meta color
      var metaThemeColor = document.querySelector('meta[name="theme-color"]');
      if (metaThemeColor && themeMetaColors[themeName]) {
        metaThemeColor.setAttribute('content', themeMetaColors[themeName]);
      }

      if (persist !== false) {
        try {
          localStorage.setItem('safewebhook_theme', themeName);
        } catch(e) {}
      }

      // Update Desktop Segmented Controls Active State
      document.querySelectorAll('.theme-seg-btn').forEach(function(btn) {
        var choice = btn.getAttribute('data-theme-choice');
        var isActive = choice === themeName;
        btn.setAttribute('aria-checked', isActive ? 'true' : 'false');

        if (isActive) {
          btn.className = 'theme-seg-btn relative flex items-center justify-center p-1.5 rounded-md text-xs font-semibold shadow-sm transition-all duration-200 cursor-pointer focus:outline-none ' +
            (choice === 'bright' 
              ? 'bg-white text-indigo-600 shadow-slate-200 border border-slate-200' 
              : (choice === 'midnight' 
                ? 'bg-[#11162a] text-violet-400 border border-violet-500/40' 
                : 'bg-[#161f33] text-indigo-400 border border-indigo-500/30'));
        } else {
          btn.className = 'theme-seg-btn relative flex items-center justify-center p-1.5 rounded-md text-xs text-slate-500 hover:text-slate-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-all duration-150 cursor-pointer focus:outline-none';
        }
      });

      // Update Mobile Drawer Segmented Buttons
      document.querySelectorAll('.mobile-theme-opt').forEach(function(btn) {
        var choice = btn.getAttribute('data-mobile-theme');
        var isActive = choice === themeName;
        if (isActive) {
          btn.className = 'mobile-theme-opt px-3 py-2 rounded-lg border text-xs font-mono font-bold flex items-center justify-center gap-1.5 shadow-sm transition-all ' +
            (choice === 'bright' 
              ? 'bg-indigo-50 border-indigo-600 text-indigo-600' 
              : (choice === 'midnight' 
                ? 'bg-violet-950/40 border-violet-500 text-violet-300' 
                : 'bg-indigo-950/40 border-indigo-500 text-indigo-300'));
        } else {
          btn.className = 'mobile-theme-opt px-3 py-2 rounded-lg border text-xs font-mono font-medium flex items-center justify-center gap-1.5 transition-all border-slate-200 dark:border-zinc-800 text-slate-700 dark:text-zinc-300 hover:bg-slate-50 dark:hover:bg-zinc-900';
        }
      });

      // Update Mobile Quick Toggle Icon
      var sun = document.getElementById('mobile-theme-icon-sun');
      var moon = document.getElementById('mobile-theme-icon-moon');
      var stars = document.getElementById('mobile-theme-icon-stars');
      if (sun && moon && stars) {
        sun.classList.add('hidden');
        moon.classList.add('hidden');
        stars.classList.add('hidden');
        if (themeName === 'bright') sun.classList.remove('hidden');
        else if (themeName === 'midnight') stars.classList.remove('hidden');
        else moon.classList.remove('hidden');
      }
    }

    // Initialize from storage or default
    var initial = 'obsidian';
    try {
      initial = localStorage.getItem('safewebhook_theme') || 'obsidian';
    } catch(e) {}
    applyTheme(initial, false);

    // Desktop Segment Clicks
    document.querySelectorAll('.theme-seg-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var choice = btn.getAttribute('data-theme-choice');
        if (choice) applyTheme(choice, true);
      });
    });

    // Mobile Drawer Segment Clicks
    document.querySelectorAll('.mobile-theme-opt').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var choice = btn.getAttribute('data-mobile-theme');
        if (choice) applyTheme(choice, true);
      });
    });

    // Mobile Quick 1-Tap Toggle (Cycles: bright -> obsidian -> midnight -> bright)
    var mobileQuickBtn = document.getElementById('mobile-quick-theme-toggle');
    if (mobileQuickBtn) {
      mobileQuickBtn.addEventListener('click', function() {
        var current = document.documentElement.getAttribute('data-theme') || 'obsidian';
        var idx = THEMES.indexOf(current);
        var next = THEMES[(idx + 1) % THEMES.length];
        applyTheme(next, true);
      });
    }

    // Keyboard Shortcut (Shift + D or Ctrl/Cmd + J to quickly cycle themes)
    document.addEventListener('keydown', function(e) {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'j') {
        e.preventDefault();
        var current = document.documentElement.getAttribute('data-theme') || 'obsidian';
        var idx = THEMES.indexOf(current);
        var next = THEMES[(idx + 1) % THEMES.length];
        applyTheme(next, true);
      }
    });

    // Cross-Tab Sync via Storage Event
    window.addEventListener('storage', function(e) {
      if (e.key === 'safewebhook_theme' && e.newValue) {
        applyTheme(e.newValue, false);
      }
    });

    // Mobile drawer toggle
    var mobileBtn = document.getElementById('mobile-menu-btn');
    var mobileDrawer = document.getElementById('mobile-menu-drawer');
    if (mobileBtn && mobileDrawer) {
      mobileBtn.addEventListener('click', function() {
        mobileDrawer.classList.toggle('hidden');
      });
    }
  })();
</script>

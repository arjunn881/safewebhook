---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { FRAMEWORK_GUIDES } from '../../data/frameworkGuides';

export const prerender = false;

const frameworkGuides = Object.values(FRAMEWORK_GUIDES);

const pageTitle = 'Framework Webhook Implementation Guides & Boilerplates | SafeWebhook';
const pageDescription = 'Learn how to build secure webhook receivers with raw body HMAC verification in Next.js App Router, Express.js, Python FastAPI, Flask, Django, Go Gin, and Laravel.';

const structuredSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: pageTitle,
      description: pageDescription,
      url: Astro.url.href,
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: frameworkGuides.map((g, idx) => ({
          '@type': 'ListItem',
          position: idx + 1,
          name: g.title,
          url: `https://safewebhook.com/guides/${g.slug}`
        }))
      }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://safewebhook.com/' },
        { '@type': 'ListItem', position: 2, name: 'Framework Guides', item: Astro.url.href }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={Astro.url.href}
  keywords="nextjs webhook handler, express raw body webhook, fastapi async webhook, flask webhook listener, django csrf exempt webhook, go gin webhook, laravel webhook controller"
  schema={structuredSchema}
>
  <Header activeNav="guides" subTitle="/ Guides" />

  <main class="py-12 sm:py-16 flex-1 bg-developer-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Hero -->
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-500/20 font-mono">
          <span>Framework Recipes</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white font-sans">
          Framework Webhook Implementation Guides
        </h1>
        <p class="text-base sm:text-lg text-slate-600 dark:text-zinc-400 leading-relaxed font-normal">
          Production-grade boilerplate code, raw body parsing configurations, and cryptographic signature validation recipes for popular modern web frameworks.
        </p>
      </div>

      <!-- Frameworks Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
        {frameworkGuides.map(guide => (
          <a
            href={`/guides/${guide.slug}`}
            class="p-5 sm:p-6 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 hover:border-indigo-600 dark:hover:border-sky-500/50 hover:shadow-md transition-all group flex flex-col justify-between space-y-4"
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-500/20">
                  {guide.framework}
                </span>
                <span class="text-[11px] font-mono text-slate-500 dark:text-zinc-400">{guide.language}</span>
              </div>
              <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-sky-400 transition-colors font-sans">
                {guide.title}
              </h2>
              <p class="text-xs text-slate-600 dark:text-zinc-400 leading-relaxed line-clamp-3 font-normal">
                {guide.headline}
              </p>
            </div>

            <div class="pt-3 border-t border-slate-100 dark:border-zinc-800/60 flex items-center justify-between text-xs font-mono text-slate-500 dark:text-zinc-400 group-hover:text-slate-900 dark:group-hover:text-zinc-200">
              <span>View Boilerplate &rarr;</span>
              <span class="text-[10px] text-indigo-600 dark:text-sky-400 font-semibold">Code Recipe</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </main>

  <Footer />
</Layout>

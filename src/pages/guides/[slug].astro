---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { FRAMEWORK_GUIDES, type FrameworkGuideInfo } from '../../data/frameworkGuides';

export const prerender = false;

const { slug } = Astro.params;
const guideData: FrameworkGuideInfo | undefined = FRAMEWORK_GUIDES[slug as string];

if (!guideData) {
  return Astro.redirect('/guides');
}

const pageTitle = `${guideData.title} | SafeWebhook`;
const pageDescription = `${guideData.headline} Learn how to parse raw bodies and verify HMAC signatures in ${guideData.framework} with complete production boilerplates.`;

const structuredSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      headline: pageTitle,
      description: pageDescription,
      url: Astro.url.href,
      inLanguage: 'en',
      datePublished: '2026-08-21',
      dateModified: '2026-09-13',
      author: {
        '@type': 'Organization',
        name: 'SafeWebhook',
        url: 'https://safewebhook.com'
      },
      publisher: { '@id': 'https://safewebhook.com/#organization' },
      about: {
        '@type': 'SoftwareApplication',
        name: `${guideData.framework} Webhook Handler`
      }
    },
    {
      '@type': 'HowTo',
      name: guideData.title,
      description: `Complete step-by-step guide to handling webhooks in ${guideData.framework} (${guideData.language}) with HMAC signature verification.`,
      totalTime: 'PT10M',
      tool: [
        { '@type': 'HowToTool', name: guideData.framework },
        { '@type': 'HowToTool', name: 'SafeWebhook' }
      ],
      step: guideData.stepByStepGuide.map((step, idx) => ({
        '@type': 'HowToStep',
        position: idx + 1,
        name: `Step ${idx + 1}`,
        text: typeof step === 'string' ? step : String(step),
        url: Astro.url.href
      }))
    },
    {
      '@type': 'FAQPage',
      mainEntity: guideData.faqs.map(f => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a }
      }))
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://safewebhook.com/' },
        { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://safewebhook.com/guides' },
        { '@type': 'ListItem', position: 3, name: guideData.framework, item: Astro.url.href }
      ]
    }
  ]
};

const otherGuides = Object.values(FRAMEWORK_GUIDES)
  .filter(g => g.slug !== guideData.slug)
  .slice(0, 3);
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={Astro.url.href}
  keywords={`${guideData.framework.toLowerCase()} webhook handler, ${guideData.language.toLowerCase()} webhook raw body, verify webhook signature ${guideData.framework.toLowerCase()}, ${guideData.framework.toLowerCase()} stripe webhook`}
  schema={structuredSchema}
>
  <Header activeNav="guides" subTitle={`/ ${guideData.framework}`} />

  <main class="py-10 sm:py-16 flex-1 bg-developer-grid">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 sm:space-y-12">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs font-mono text-slate-500 dark:text-zinc-400">
        <a href="/" class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/guides" class="hover:text-slate-900 dark:hover:text-white transition-colors">Guides</a>
        <span>/</span>
        <span class="text-indigo-600 dark:text-sky-400 font-semibold">{guideData.framework}</span>
      </nav>

      <!-- Hero Header -->
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <span class="px-3 py-1 rounded-full text-xs font-medium bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-500/20 font-mono">
            {guideData.framework}
          </span>
          <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-zinc-900 text-slate-600 dark:text-zinc-400 border border-slate-200 dark:border-zinc-800 font-mono">
            {guideData.language}
          </span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white font-sans">
          {guideData.headline}
        </h1>
        <p class="text-base sm:text-lg text-slate-600 dark:text-zinc-400 leading-relaxed max-w-3xl font-normal">
          {guideData.description}
        </p>
      </div>

      <!-- GEO / AEO Direct Answer Box -->
      {guideData.directAnswer && (
        <section class="rounded-xl border border-blue-200 dark:border-sky-500/30 bg-blue-50/50 dark:bg-sky-950/20 p-5 sm:p-6 backdrop-blur-sm shadow-sm">
          <div class="flex items-center gap-2 text-indigo-600 dark:text-sky-400 text-xs font-mono font-semibold uppercase tracking-wider mb-2">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Direct Answer / Quick Implementation Guide
          </div>
          <p class="text-sm sm:text-base text-slate-800 dark:text-zinc-200 leading-relaxed font-sans font-medium">
            {guideData.directAnswer}
          </p>
        </section>
      )}

      <!-- Key Takeaways Callout -->
      <section class="rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 p-5 sm:p-6 space-y-3 shadow-sm">
        <h2 class="text-xs font-mono font-semibold text-slate-500 dark:text-zinc-400 uppercase tracking-wider flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Essential Implementation Takeaways
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs sm:text-sm text-slate-700 dark:text-zinc-300 font-normal">
          {guideData.keyTakeaways.map(item => (
            <li class="flex items-start gap-2">
              <span class="text-indigo-600 dark:text-sky-400 font-bold mt-0.5">&bull;</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Common Gotchas & Fixes -->
      <section class="space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white font-sans">
          Common Gotchas in {guideData.framework} &amp; How to Fix Them
        </h2>
        <div class="grid grid-cols-1 gap-3 sm:gap-3.5">
          {guideData.commonGotchas.map(g => (
            <div class="p-4 sm:p-5 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/30 space-y-2 shadow-sm">
              <div class="text-sm font-semibold text-rose-600 dark:text-rose-400 flex items-center gap-2">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {g.gotcha}
              </div>
              <div class="text-xs sm:text-sm text-emerald-700 dark:text-emerald-300 flex items-start gap-2 pl-6 font-normal">
                <span class="font-bold">Fix:</span>
                <span>{g.fix}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Full Production-Ready Boilerplate -->
      <section class="space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-lg sm:text-xl font-bold tracking-tight text-slate-900 dark:text-white font-sans">
            Complete Production Boilerplate
          </h2>
          <span class="text-[11px] font-mono text-indigo-600 dark:text-sky-400 font-semibold">{guideData.language}</span>
        </div>
        <div class="rounded-xl border border-slate-800 bg-[#070b14] p-4 font-mono text-xs text-sky-300 overflow-x-auto shadow-lg">
          <pre><code>{guideData.boilerplateCode}</code></pre>
        </div>
      </section>

      <!-- Step-by-Step Implementation Steps -->
      <section class="space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white font-sans">
          Step-by-Step Setup Guide
        </h2>
        <div class="space-y-3">
          {guideData.stepByStepGuide.map((step, idx) => (
            <div class="flex items-start gap-3.5 p-4 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/30 shadow-sm">
              <span class="w-6 h-6 rounded-full bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-500/20 text-xs font-mono font-bold flex items-center justify-center flex-shrink-0 mt-0.5">
                {idx + 1}
              </span>
              <div class="text-xs sm:text-sm text-slate-700 dark:text-zinc-300 leading-relaxed font-normal">
                {step}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Local Testing Instructions -->
      <section class="p-5 sm:p-6 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 space-y-3 shadow-sm">
        <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2 font-sans">
          <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          How to Test Locally on Your Machine
        </h2>
        <ul class="space-y-2 text-xs sm:text-sm text-slate-700 dark:text-zinc-300 list-disc list-inside font-normal">
          {guideData.howToTestLocally.map(step => (
            <li>{step}</li>
          ))}
        </ul>
      </section>

      <!-- Frequently Asked Questions -->
      <section class="space-y-4 sm:space-y-5">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white font-sans">
          Frequently Asked Questions: {guideData.framework} Webhooks
        </h2>
        <div class="space-y-3">
          {guideData.faqs.map(faq => (
            <div class="p-5 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 space-y-2 shadow-sm">
              <h3 class="text-sm sm:text-base font-semibold text-slate-900 dark:text-white">
                {faq.q}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-zinc-400 leading-relaxed font-normal">
                {faq.a}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- CTA Box -->
      <section class="rounded-2xl border border-blue-200 dark:border-sky-500/30 bg-gradient-to-br from-blue-50 via-white to-slate-100 dark:from-[#070a12] dark:via-zinc-900/50 dark:to-zinc-950 p-6 sm:p-8 text-center space-y-4 shadow-sm">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-sans">
          Test Your {guideData.framework} Webhook Handler Live
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-zinc-400 max-w-xl mx-auto font-normal">
          Capture payloads, simulate errors, and replay directly to your localhost server.
        </p>
        <div>
          <a
            href="/app"
            class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold rounded-xl text-white bg-indigo-600 hover:bg-indigo-500 shadow-sm shadow-indigo-500/20 transition-all shadow-md hover:scale-105"
          >
            <span>Launch Webhook Workbench &rarr;</span>
          </a>
        </div>
      </section>

      <!-- Related Guides -->
      {otherGuides.length > 0 && (
        <section class="space-y-4 border-t border-slate-200 dark:border-zinc-800 pt-8">
          <h2 class="text-xs font-mono font-semibold uppercase text-slate-500 dark:text-zinc-400 tracking-wider">
            Explore Other Webhook Framework Guides
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            {otherGuides.map(g => (
              <a
                href={`/guides/${g.slug}`}
                class="p-3.5 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/30 hover:border-indigo-600 dark:hover:border-sky-500/50 transition-all group block shadow-sm"
              >
                <div class="text-xs font-semibold text-slate-800 dark:text-zinc-200 group-hover:text-indigo-600 dark:group-hover:text-sky-400 transition-colors">
                  {g.framework} Guide
                </div>
                <div class="text-[11px] text-slate-500 dark:text-zinc-400 mt-1 line-clamp-2">
                  {g.headline}
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </main>

  <Footer />
</Layout>

---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  error?: unknown;
}

const { error } = Astro.props;
const errorMessage = error instanceof Error ? error.message : 'An unexpected edge worker exception occurred.';
---

<Layout
  title="500 — Edge Exception | SafeWebhook"
  description="An internal error occurred while processing your request on SafeWebhook."
  robots="noindex, nofollow"
>
  <Header subTitle="/ 500 Error" />

  <main class="min-h-[calc(100vh-200px)] flex items-center justify-center px-4 py-16 sm:px-6 lg:px-8 bg-developer-grid flex-1">
    <div class="max-w-md w-full text-center space-y-6">
      
      <!-- Terminal Status Pill -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/20 text-xs font-mono text-rose-700 dark:text-rose-400">
        <span class="w-2 h-2 rounded-full bg-rose-500"></span>
        <span>HTTP Status 500 &bull; Edge Worker Exception</span>
      </div>

      <!-- Main Display -->
      <div class="space-y-3">
        <h1 class="text-6xl sm:text-7xl font-mono font-extrabold text-slate-900 dark:text-white tracking-tight">500</h1>
        <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-zinc-200 font-sans">Internal Edge Error</h2>
        <p class="text-slate-600 dark:text-zinc-400 text-xs sm:text-sm leading-relaxed max-w-sm mx-auto font-normal">
          The edge isolate encountered an unhandled exception. Webhooks sent to active endpoints are buffered in-memory and resiliently re-attempted.
        </p>
      </div>

      <!-- Diagnostic Card -->
      <div class="text-left p-3.5 rounded-xl bg-slate-100 dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800 text-xs font-mono space-y-1 text-slate-600 dark:text-zinc-400 shadow-sm">
        <div class="text-[10px] text-slate-400 dark:text-zinc-500 uppercase font-semibold">Diagnostic Trace</div>
        <div class="text-rose-600 dark:text-rose-400 break-all font-normal">{errorMessage}</div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
        <button
          onclick="window.location.reload()"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-2 text-xs font-semibold rounded-lg bg-indigo-600 hover:bg-indigo-500 shadow-sm shadow-indigo-500/20 text-white transition-colors shadow-sm cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
          <span>Retry Request</span>
        </button>
        <a
          href="/app"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-2 text-xs font-semibold rounded-lg bg-slate-100 dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 hover:border-slate-300 dark:hover:border-zinc-700 text-slate-800 dark:text-zinc-300 transition-colors"
        >
          <span>Open Webhook Workbench</span>
        </a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { USE_CASES } from '../../data/usecases';

export const prerender = false;

const tools = Object.values(USE_CASES);

const pageTitle = 'Free Online Webhook Developer Tools & Utilities | SafeWebhook';
const pageDescription = 'Explore free online developer utilities for webhooks: Status Code Simulator, Latency Timeout Simulator, Cryptographic HMAC Signature Verifier, Localhost Replay, Inbound Email Parser, and JWT Validator.';

const structuredSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: pageTitle,
      description: pageDescription,
      url: Astro.url.href,
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: tools.map((t, idx) => ({
          '@type': 'ListItem',
          position: idx + 1,
          name: t.name,
          url: `https://safewebhook.com/tools/${t.slug}`
        }))
      }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://safewebhook.com/' },
        { '@type': 'ListItem', position: 2, name: 'Tools', item: Astro.url.href }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={Astro.url.href}
  keywords="webhook tools, mock api response, simulate webhook latency, verify webhook signature online, replay webhook to localhost, inbound email webhook parser"
  schema={structuredSchema}
>
  <Header activeNav="tools" subTitle="/ Tools" />

  <main class="py-12 sm:py-16 flex-1 bg-developer-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Hero -->
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-500/20 font-mono">
          <span>12+ Free Developer Utilities</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white font-sans">
          Webhook Developer Tools &amp; Simulators
        </h1>
        <p class="text-base sm:text-lg text-slate-600 dark:text-zinc-400 leading-relaxed font-normal">
          Zero-login tools to simulate status codes, test latency timeouts, verify cryptographic HMAC signatures, and replay events without Ngrok.
        </p>
      </div>

      <!-- Tools Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
        {tools.map(tool => (
          <a
            href={`/tools/${tool.slug}`}
            class="p-5 sm:p-6 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 hover:border-indigo-600 dark:hover:border-sky-500/50 hover:shadow-md transition-all group flex flex-col justify-between space-y-4"
          >
            <div class="space-y-3">
              <div class="w-8 h-8 rounded-lg bg-blue-50 dark:bg-sky-500/10 border border-blue-200 dark:border-sky-500/20 flex items-center justify-center text-indigo-600 dark:text-sky-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-sky-400 transition-colors font-sans">
                {tool.name}
              </h2>
              <p class="text-xs text-slate-600 dark:text-zinc-400 leading-relaxed line-clamp-3 font-normal">
                {tool.headline}
              </p>
            </div>

            <div class="pt-3 border-t border-slate-100 dark:border-zinc-800/60 flex items-center justify-between text-xs font-mono text-slate-500 dark:text-zinc-400 group-hover:text-slate-900 dark:group-hover:text-zinc-200">
              <span>Open Tool Guide &rarr;</span>
              <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold">Free Forever</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </main>

  <Footer />
</Layout>

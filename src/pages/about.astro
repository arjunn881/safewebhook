---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'About Us — SafeWebhook';
const pageDescription = 'Learn about SafeWebhook: our mission, zero-server-storage privacy architecture, and commitment to free, developer-first webhook testing tools.';

const aboutSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': 'https://safewebhook.com/about',
      url: 'https://safewebhook.com/about',
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'en',
      datePublished: '2026-08-30',
      dateModified: '2026-09-13',
      isPartOf: { '@id': 'https://safewebhook.com/#website' },
      about: { '@id': 'https://safewebhook.com/#organization' },
      publisher: { '@id': 'https://safewebhook.com/#organization' }
    },
    {
      '@type': 'Organization',
      '@id': 'https://safewebhook.com/#organization',
      name: 'SafeWebhook',
      url: 'https://safewebhook.com',
      logo: 'https://safewebhook.com/favicon.svg',
      foundingDate: '2026',
      email: 'support@safewebhook.com',
      description: 'SafeWebhook is the zero-login, privacy-first developer platform for testing, debugging, and simulating inbound HTTP webhooks in real time at the Cloudflare edge. No server storage, no accounts, no paywalls.',
      knowsAbout: [
        'Webhook Testing and Debugging',
        'HMAC-SHA256 Signature Verification',
        'HTTP Payload Inspection',
        'Cryptographic Security',
        'Cloudflare Workers Edge Computing',
        'Server-Sent Events (SSE)',
        'Developer Tools',
        'API Development',
        'Webhook Security Best Practices'
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'technical support',
        email: 'support@safewebhook.com',
        availableLanguage: 'English'
      },
      sameAs: [
        'https://github.com/safewebhook',
        'https://twitter.com/safewebhook',
        'https://www.linkedin.com/company/safewebhook'
      ]
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://safewebhook.com/' },
        { '@type': 'ListItem', position: 2, name: 'About', item: 'https://safewebhook.com/about' }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  robots="index, follow"
  schema={aboutSchema}
>
  <Header subTitle="/ About Us" />

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 flex-1 bg-developer-grid">
    
    <!-- Hero Section -->
    <div class="space-y-4 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-500/20 text-xs font-mono">
        <span class="w-2 h-2 rounded-full bg-blue-500"></span>
        <span>Our Mission &amp; Story</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white font-sans">
        Building the World's Most Private Webhook Debugger
      </h1>
      <p class="text-base sm:text-lg text-slate-600 dark:text-zinc-400 leading-relaxed font-normal">
        SafeWebhook was born out of a simple conviction: developers shouldn't have to sacrifice their privacy, install complex tunneling daemons, or pay $45/month subscriptions just to inspect an HTTP POST payload.
      </p>
    </div>

    <!-- Core Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <div class="p-6 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 space-y-3 shadow-sm">
        <div class="w-10 h-10 rounded-lg bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-500/20 flex items-center justify-center font-bold font-mono">
          01
        </div>
        <h2 class="text-base font-bold text-slate-900 dark:text-white font-sans">Zero Server Storage</h2>
        <p class="text-xs text-slate-600 dark:text-zinc-400 leading-relaxed font-normal">
          Your customer data, bearer tokens, and signatures are processed in-memory at the edge and never saved to persistent disks or central databases.
        </p>
      </div>

      <div class="p-6 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 space-y-3 shadow-sm">
        <div class="w-10 h-10 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/20 flex items-center justify-center font-bold font-mono">
          02
        </div>
        <h2 class="text-base font-bold text-slate-900 dark:text-white font-sans">Zero Friction</h2>
        <p class="text-xs text-slate-600 dark:text-zinc-400 leading-relaxed font-normal">
          No signups, no email verification, no credit cards. Open the app and start receiving live webhook events in under 2 seconds.
        </p>
      </div>

      <div class="p-6 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 space-y-3 shadow-sm">
        <div class="w-10 h-10 rounded-lg bg-purple-50 dark:bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-200 dark:border-purple-500/20 flex items-center justify-center font-bold font-mono">
          03
        </div>
        <h2 class="text-base font-bold text-slate-900 dark:text-white font-sans">Edge SSE Streaming</h2>
        <p class="text-xs text-slate-600 dark:text-zinc-400 leading-relaxed font-normal">
          Powered by Cloudflare Workers Anycast network with sub-20ms real-time Server-Sent Events pushed straight to your browser.
        </p>
      </div>
    </div>

    <!-- The Story & Why We Create Content -->
    <div class="space-y-8 text-slate-700 dark:text-zinc-300 leading-relaxed font-normal text-sm sm:text-base">

      <section class="space-y-3 p-6 sm:p-8 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white font-sans">Why We Built SafeWebhook</h2>
        <p>
          As software engineers building integrations for Stripe, Shopify, GitHub, OpenAI, and hundreds of web services, we repeatedly encountered the same frustrating friction:
        </p>
        <ul class="list-disc list-inside space-y-2 ml-2">
          <li><strong>Data Leak Concerns:</strong> Traditional cloud webhook inspect tools save all payloads on central multi-tenant servers, risking sensitive API keys and PII data leaks.</li>
          <li><strong>Aggressive Paywalls:</strong> Basic developer capabilities—like returning custom status codes (400, 500), testing retry backoff latency, or filtering requests—were gated behind expensive monthly subscriptions.</li>
          <li><strong>Local Tunnel Friction:</strong> Installing local tunnel software like ngrok requires account registration, auth tokens, and opens security holes in firewalls.</li>
        </ul>
        <p>
          We created <strong>SafeWebhook</strong> to provide an uncompromised, free, client-side developer workbench that treats security and developer speed as first-class citizens.
        </p>
      </section>

      <section class="space-y-3 p-6 sm:p-8 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white font-sans">Why We Create In-Depth Guides &amp; Tools</h2>
        <p>
          Webhooks are deceptively difficult to get right in production. From raw body stream parsing in Next.js App Router and Express to asynchronous HMAC signature verification in FastAPI and Go, developers lose hundreds of hours to subtle webhook bugs.
        </p>
        <p>
          We publish comprehensive guides, signature verification recipes, and error diagnostics across 24+ platforms and frameworks to demystify webhook infrastructure for the entire global developer community.
        </p>
      </section>

      <section class="space-y-4 p-6 sm:p-8 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white font-sans">The Zero-Storage Privacy Architecture</h2>
        <p>
          Unlike traditional request catcher tools that write incoming webhook payloads directly to central relational databases or disk volumes, SafeWebhook operates under an uncompromising privacy model:
        </p>
        <div class="space-y-3 text-xs sm:text-sm text-slate-600 dark:text-zinc-400">
          <div class="p-3.5 rounded-lg bg-slate-50 dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800">
            <h3 class="font-bold text-slate-900 dark:text-white mb-1 font-mono">1. In-Memory Edge Proxying</h3>
            <p>Inbound HTTP POST requests are ingested by Cloudflare edge workers, buffered in volatile memory, and immediately streamed to the subscribed browser session using Server-Sent Events (SSE). Once the SSE message is delivered, the worker discards the memory buffer immediately.</p>
          </div>
          <div class="p-3.5 rounded-lg bg-slate-50 dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800">
            <h3 class="font-bold text-slate-900 dark:text-white mb-1 font-mono">2. Client-Side Sandbox Storage (IndexedDB)</h3>
            <p>Your captured request history, response configurations, and custom headers are stored exclusively within your browser's local IndexedDB sandbox. Clearing your browser cache permanently removes all traces of captured webhook events.</p>
          </div>
          <div class="p-3.5 rounded-lg bg-slate-50 dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800">
            <h3 class="font-bold text-slate-900 dark:text-white mb-1 font-mono">3. Tunnel-Free Localhost Forwarding</h3>
            <p>Our 1-Click Request Replay dispatches captured payloads directly from your local browser window to your development server (e.g. <code>http://localhost:3000</code>). No open ingress ports, no third-party tunneling daemons, and zero exposure to external network scanners.</p>
          </div>
        </div>
      </section>

      <section class="space-y-3 p-6 sm:p-8 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white font-sans">Technology Stack &amp; Infrastructure</h2>
        <p>SafeWebhook is architected on modern, edge-native web technologies:</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 font-mono text-xs">
          <div class="p-3 rounded-lg bg-slate-50 dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800 text-center">
            <span class="text-slate-900 dark:text-white font-bold block">Astro 5</span>
            <span class="text-slate-500 text-[10px]">Zero-JS SSG/SSR</span>
          </div>
          <div class="p-3 rounded-lg bg-slate-50 dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800 text-center">
            <span class="text-slate-900 dark:text-white font-bold block">Cloudflare Edge</span>
            <span class="text-slate-500 text-[10px]">Global Workers</span>
          </div>
          <div class="p-3 rounded-lg bg-slate-50 dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800 text-center">
            <span class="text-slate-900 dark:text-white font-bold block">SSE Streams</span>
            <span class="text-slate-500 text-[10px]">Sub-20ms Push</span>
          </div>
          <div class="p-3 rounded-lg bg-slate-50 dark:bg-zinc-950 border border-slate-200 dark:border-zinc-800 text-center">
            <span class="text-slate-900 dark:text-white font-bold block">Tailwind v4</span>
            <span class="text-slate-500 text-[10px]">High-Contrast UI</span>
          </div>
        </div>
      </section>


      <!-- CTA Box -->
      <div class="p-6 sm:p-8 rounded-2xl border border-blue-200 dark:border-sky-500/30 bg-gradient-to-br from-blue-50 via-white to-slate-100 dark:from-[#070a12] dark:via-zinc-900/50 dark:to-zinc-950 text-center space-y-4 shadow-sm">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-sans">
          Ready to test your webhooks safely?
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-zinc-400 max-w-xl mx-auto font-normal">
          Generate an instant temporary webhook URL and start streaming live payloads in your browser right now.
        </p>
        <div class="pt-2">
          <a
            href="/app"
            class="inline-flex items-center justify-center px-6 py-2.5 rounded-lg text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-500 shadow-sm shadow-indigo-500/20 transition-colors shadow-sm"
          >
            <span>Launch Webhook Workbench &rarr;</span>
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { PLATFORMS, type PlatformIntegration } from '../../data/platforms';

export const prerender = false;

const { platform } = Astro.params;
const platformData: PlatformIntegration | undefined = platform ? PLATFORMS[platform] : undefined;

if (!platformData) {
  return Astro.redirect('/docs');
}

const pageTitle = `Test ${platformData.name} Webhooks Online — SafeWebhook`;
const pageDescription = `Free online ${platformData.name} webhook tester by SafeWebhook. Inspect ${platformData.name} payloads, verify ${platformData.signatureHeader} HMAC signatures, and replay requests to localhost with zero login at safewebhook.com.`;

const structuredSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      headline: `How to Test and Verify ${platformData.name} Webhooks on SafeWebhook`,
      description: pageDescription,
      author: { '@type': 'Organization', name: 'SafeWebhook' },
      datePublished: '2026-08-19',
      dateModified: '2026-08-19',
      mainEntityOfPage: Astro.url.href
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://safewebhook.com/' },
        { '@type': 'ListItem', position: 2, name: 'Integrations', item: 'https://safewebhook.com/docs' },
        { '@type': 'ListItem', position: 3, name: `${platformData.name} Webhook Testing`, item: Astro.url.href }
      ]
    },
    {
      '@type': 'FAQPage',
      mainEntity: platformData.faqs.map(f => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a }
      }))
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={Astro.url.href}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredSchema)} />

  <!-- Navigation Header -->
  <header class="sticky top-0 z-50 w-full border-b border-slate-800 bg-slate-950/85 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 group-hover:border-cyan-400 transition-colors shadow-sm shadow-cyan-500/10">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-bold tracking-tight text-white text-base font-sans">Safe<span class="text-cyan-400">Webhook</span></span>
          <span class="text-[10px] text-slate-400 -mt-1 font-mono">{platformData.name} Suite</span>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
        <a href="/" class="hover:text-cyan-300 transition-colors">Home</a>
        <a href="/docs" class="hover:text-cyan-300 transition-colors">Docs</a>
        <a href="/faq" class="hover:text-cyan-300 transition-colors">FAQ</a>
      </nav>

      <a
        href="/app"
        class="inline-flex items-center justify-center px-4 py-2 text-xs font-semibold rounded-lg text-slate-950 bg-gradient-to-r from-cyan-400 to-cyan-300 hover:from-cyan-300 hover:to-cyan-200 transition-all shadow-md shadow-cyan-500/20 active:scale-95"
      >
        Launch Workbench &rarr;
      </a>
    </div>
  </header>

  <main class="py-12 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs font-mono text-slate-400">
        <a href="/" class="hover:text-cyan-300 transition-colors">Home</a>
        <span>/</span>
        <a href="/docs" class="hover:text-cyan-300 transition-colors">Integrations</a>
        <span>/</span>
        <span class="text-cyan-400 font-semibold">{platformData.name}</span>
      </nav>

      <!-- Hero Header -->
      <div class="space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-500/30 text-cyan-300 text-xs font-mono">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
          <span>{platformData.category} Integration</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Test {platformData.name} Webhooks on SafeWebhook
        </h1>
        <p class="text-base sm:text-lg text-slate-300 max-w-3xl leading-relaxed">
          {platformData.tagline}
        </p>

        <div class="pt-4 flex flex-wrap items-center gap-4">
          <a
            href="/app"
            class="px-6 py-3 rounded-xl text-sm font-bold text-slate-950 bg-gradient-to-r from-cyan-400 via-cyan-300 to-teal-300 hover:from-cyan-300 hover:to-teal-200 transition-all shadow-lg shadow-cyan-500/25"
          >
            Spawn Free {platformData.name} Endpoint &rarr;
          </a>
          <a
            href="/docs"
            class="px-5 py-3 rounded-xl text-sm font-semibold text-slate-200 bg-slate-900 hover:bg-slate-850 border border-slate-700 transition-colors"
          >
            Read All Integration Guides
          </a>
        </div>
      </div>

      <!-- Quick Metadata Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 font-mono text-xs">
        <div class="p-4 rounded-xl border border-slate-800 bg-slate-900/60 space-y-1">
          <div class="text-slate-400 text-[11px] font-semibold uppercase">Signature Header</div>
          <div class="text-cyan-300 font-bold truncate">{platformData.signatureHeader}</div>
        </div>

        <div class="p-4 rounded-xl border border-slate-800 bg-slate-900/60 space-y-1">
          <div class="text-slate-400 text-[11px] font-semibold uppercase">Cryptographic Algorithm</div>
          <div class="text-emerald-300 font-bold truncate">{platformData.signatureAlgorithm}</div>
        </div>

        <div class="p-4 rounded-xl border border-slate-800 bg-slate-900/60 space-y-1">
          <div class="text-slate-400 text-[11px] font-semibold uppercase">Server Retention</div>
          <div class="text-teal-300 font-bold">100% Private (0 Disk Storage)</div>
        </div>
      </div>

      <!-- Step-by-Step Setup Guide -->
      <section class="space-y-6 pt-8 border-t border-slate-800">
        <div class="flex items-center gap-3">
          <span class="text-cyan-400 font-mono text-sm font-bold">01.</span>
          <h2 class="text-2xl font-bold text-white">How to Set Up {platformData.name} Webhooks</h2>
        </div>
        <div class="space-y-3">
          {platformData.setupSteps.map((step, idx) => (
            <div class="flex items-start gap-3.5 p-4 rounded-xl border border-slate-800 bg-slate-900/40 text-sm text-slate-200">
              <span class="w-6 h-6 rounded-lg bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 font-mono text-xs flex items-center justify-center flex-shrink-0 font-bold">
                {idx + 1}
              </span>
              <span class="leading-relaxed">{step}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Sample Payload Inspector Preview -->
      <section class="space-y-4 pt-8 border-t border-slate-800">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="text-cyan-400 font-mono text-sm font-bold">02.</span>
            <h2 class="text-2xl font-bold text-white">Sample {platformData.name} Payload Schema</h2>
          </div>
          <span class="text-xs font-mono text-slate-400">JSON Payload</span>
        </div>
        <div class="rounded-2xl border border-slate-800 bg-slate-950 p-5 overflow-x-auto text-xs font-mono">
          <pre class="text-cyan-300 leading-relaxed"><code>{JSON.stringify(platformData.samplePayload, null, 2)}</code></pre>
        </div>
      </section>

      <!-- Signature Verification Code Recipes -->
      <section class="space-y-6 pt-8 border-t border-slate-800">
        <div class="flex items-center gap-3">
          <span class="text-cyan-400 font-mono text-sm font-bold">03.</span>
          <h2 class="text-2xl font-bold text-white">Cryptographic Signature Verification Recipes</h2>
        </div>

        <!-- Node.js Recipe -->
        <div class="p-5 rounded-2xl border border-slate-800 bg-slate-900/60 space-y-3 font-mono text-xs">
          <div class="flex items-center justify-between text-slate-300 font-bold">
            <span>Node.js / Express Recipe</span>
            <span class="text-cyan-400 text-[11px]">JavaScript</span>
          </div>
          <pre class="p-4 rounded-xl bg-slate-950 text-cyan-300 overflow-x-auto border border-slate-850 leading-relaxed"><code>{platformData.verificationCodeNode}</code></pre>
        </div>

        <!-- Python Recipe -->
        <div class="p-5 rounded-2xl border border-slate-800 bg-slate-900/60 space-y-3 font-mono text-xs">
          <div class="flex items-center justify-between text-slate-300 font-bold">
            <span>Python / Flask Recipe</span>
            <span class="text-emerald-400 text-[11px]">Python 3</span>
          </div>
          <pre class="p-4 rounded-xl bg-slate-950 text-emerald-300 overflow-x-auto border border-slate-850 leading-relaxed"><code>{platformData.verificationCodePython}</code></pre>
        </div>
      </section>

      <!-- Platform-Specific FAQs -->
      <section class="space-y-6 pt-8 border-t border-slate-800">
        <div class="flex items-center gap-3">
          <span class="text-cyan-400 font-mono text-sm font-bold">04.</span>
          <h2 class="text-2xl font-bold text-white">Frequently Asked Questions</h2>
        </div>
        <div class="space-y-4">
          {platformData.faqs.map(faq => (
            <div class="p-5 rounded-xl border border-slate-800 bg-slate-900/60 space-y-2">
              <h3 class="font-semibold text-white text-base">{faq.q}</h3>
              <p class="text-sm text-slate-300 leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Bottom CTA Banner -->
      <div class="p-8 sm:p-10 rounded-2xl border border-cyan-500/30 bg-gradient-to-r from-slate-900 to-slate-950 text-center space-y-4 shadow-xl">
        <h3 class="text-2xl font-bold text-white">Ready to test your {platformData.name} integration?</h3>
        <p class="text-sm text-slate-300 max-w-xl mx-auto">
          Spawn an instant edge endpoint, paste it into {platformData.name}, and watch live events arrive at safewebhook.com.
        </p>
        <div class="pt-2">
          <a
            href="/app"
            class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-bold text-sm shadow-md shadow-cyan-500/20 transition-all"
          >
            Launch SafeWebhook Free &rarr;
          </a>
        </div>
      </div>

    </div>
  </main>

  <!-- Footer -->
  <footer class="py-12 border-t border-slate-800 bg-slate-950 text-slate-400 text-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <div class="w-6 h-6 rounded bg-cyan-500/20 text-cyan-400 flex items-center justify-center text-xs font-bold font-mono">
          S
        </div>
        <span class="font-semibold text-slate-200">SafeWebhook</span>
        <span class="text-xs text-slate-400">&bull; safewebhook.com &bull; {platformData.name} Integration</span>
      </div>

      <div class="flex items-center gap-6 text-xs">
        <a href="/" class="hover:text-cyan-300 transition-colors">Home</a>
        <a href="/docs" class="hover:text-cyan-300 transition-colors">Docs</a>
        <a href="/faq" class="hover:text-cyan-300 transition-colors">FAQ</a>
        <a href="/app" class="text-cyan-400 hover:text-cyan-300 font-semibold transition-colors">Open App Workbench &rarr;</a>
      </div>
    </div>
  </footer>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { ERROR_GUIDES, type ErrorGuideInfo } from '../../data/errorGuides';

export const prerender = false;

const { code } = Astro.params;
const errorData: ErrorGuideInfo | undefined = ERROR_GUIDES[code as string];

if (!errorData) {
  return Astro.redirect('/errors');
}

const pageTitle = `Fix Webhook HTTP ${errorData.statusCode} Error (${errorData.title}) | SafeWebhook`;
const pageDescription = `Complete root cause analysis, provider retry schedules (Stripe, GitHub, Shopify), and code fixes for webhook HTTP ${errorData.statusCode} (${errorData.title}).`;

const structuredSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      headline: pageTitle,
      description: pageDescription,
      url: Astro.url.href,
      inLanguage: 'en',
      datePublished: '2026-08-21',
      dateModified: '2026-09-13',
      author: {
        '@type': 'Organization',
        name: 'SafeWebhook',
        url: 'https://safewebhook.com'
      },
      publisher: { '@id': 'https://safewebhook.com/#organization' }
    },
    {
      '@type': 'HowTo',
      name: `How to Fix Webhook HTTP ${errorData.statusCode} Error`,
      description: `Step-by-step resolution checklist for webhook HTTP ${errorData.statusCode} (${errorData.title}).`,
      totalTime: 'PT5M',
      tool: [{ '@type': 'HowToTool', name: 'SafeWebhook' }],
      step: errorData.troubleshootingChecklist.map((item, idx) => ({
        '@type': 'HowToStep',
        position: idx + 1,
        name: `Step ${idx + 1}`,
        text: typeof item === 'string' ? item : String(item),
        url: Astro.url.href
      }))
    },
    {
      '@type': 'FAQPage',
      mainEntity: errorData.faqs.map(f => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a }
      }))
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://safewebhook.com/' },
        { '@type': 'ListItem', position: 2, name: 'Errors', item: 'https://safewebhook.com/errors' },
        { '@type': 'ListItem', position: 3, name: `HTTP ${errorData.statusCode}`, item: Astro.url.href }
      ]
    }
  ]
};

const otherErrors = Object.values(ERROR_GUIDES)
  .filter(e => e.slug !== errorData.slug)
  .slice(0, 3);
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={Astro.url.href}
  keywords={`fix ${errorData.title.toLowerCase()}, webhook ${errorData.statusCode} error, debug http ${errorData.statusCode} webhook, stripe webhook ${errorData.statusCode}, shopify webhook ${errorData.statusCode}`}
  schema={structuredSchema}
>
  <Header activeNav="errors" subTitle={`/ HTTP ${errorData.statusCode}`} />

  <main class="py-10 sm:py-16 flex-1 bg-developer-grid">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 sm:space-y-12">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs font-mono text-slate-500 dark:text-zinc-400">
        <a href="/" class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/errors" class="hover:text-slate-900 dark:hover:text-white transition-colors">Errors</a>
        <span>/</span>
        <span class="text-rose-600 dark:text-rose-400 font-semibold">HTTP {errorData.statusCode}</span>
      </nav>

      <!-- Hero Header -->
      <div class="space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-rose-50 dark:bg-rose-500/10 text-rose-700 dark:text-rose-400 border border-rose-200 dark:border-rose-500/20 font-mono">
          <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
          <span>HTTP Status Code {errorData.statusCode}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white font-sans">
          {errorData.headline}
        </h1>
        <p class="text-base sm:text-lg text-slate-600 dark:text-zinc-400 leading-relaxed max-w-3xl font-normal">
          {errorData.description}
        </p>
      </div>

      <!-- GEO / AEO Direct Answer Box -->
      {errorData.directAnswer && (
        <section class="rounded-xl border border-rose-200 dark:border-rose-500/30 bg-rose-50/50 dark:bg-rose-950/20 p-5 sm:p-6 backdrop-blur-sm shadow-sm">
          <div class="flex items-center gap-2 text-rose-700 dark:text-rose-400 text-xs font-mono font-semibold uppercase tracking-wider mb-2">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            Direct Answer / Root Cause Diagnosis
          </div>
          <p class="text-sm sm:text-base text-slate-800 dark:text-zinc-200 leading-relaxed font-sans font-medium">
            {errorData.directAnswer}
          </p>
        </section>
      )}

      <!-- Key Takeaways Grid -->
      <section class="rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 p-5 sm:p-6 space-y-3 shadow-sm">
        <h2 class="text-xs font-mono font-semibold text-slate-500 dark:text-zinc-400 uppercase tracking-wider flex items-center gap-2">
          <svg class="w-4 h-4 text-indigo-600 dark:text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Key Diagnostic Takeaways
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs sm:text-sm text-slate-700 dark:text-zinc-300 font-normal">
          {errorData.keyTakeaways.map(item => (
            <li class="flex items-start gap-2">
              <span class="text-rose-500 font-bold mt-0.5">&bull;</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Common Root Causes Breakdown -->
      <section class="space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white font-sans">
          Common Root Causes for HTTP {errorData.statusCode}
        </h2>
        <div class="grid grid-cols-1 gap-3 sm:gap-3.5">
          {errorData.rootCauses.map(rc => (
            <div class="p-4 sm:p-5 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/30 space-y-2 shadow-sm">
              <h3 class="text-sm sm:text-base font-semibold text-slate-900 dark:text-zinc-200 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-rose-500"></span>
                {rc.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-zinc-400 leading-relaxed pl-4 font-normal">
                {rc.explanation}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- Provider Retry Schedules Table -->
      <section class="space-y-4">
        <div class="space-y-1">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white font-sans">
            Provider Retry Schedules for HTTP {errorData.statusCode}
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-zinc-400 font-normal">
            How major webhook senders retry when receiving status {errorData.statusCode}:
          </p>
        </div>

        <div class="rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 overflow-hidden shadow-sm">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-slate-50 dark:bg-zinc-900/80 border-b border-slate-200 dark:border-zinc-800 text-slate-600 dark:text-zinc-400 font-mono text-[11px] uppercase tracking-wider">
              <tr>
                <th class="py-3 px-4 sm:px-6">Webhook Provider</th>
                <th class="py-3 px-4 sm:px-6">Retry Schedule &amp; Backoff</th>
                <th class="py-3 px-4 sm:px-6">Max Window</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-zinc-800/60 font-sans">
              {errorData.providerRetryBehaviors.map((row, idx) => (
                <tr class={idx % 2 === 0 ? 'bg-slate-50/50 dark:bg-zinc-950/30' : 'bg-white dark:bg-zinc-900/20'}>
                  <td class="py-3.5 px-4 sm:px-6 font-semibold text-slate-800 dark:text-zinc-200">{row.provider}</td>
                  <td class="py-3.5 px-4 sm:px-6 text-slate-600 dark:text-zinc-300">{row.schedule}</td>
                  <td class="py-3.5 px-4 sm:px-6 font-mono text-emerald-600 dark:text-emerald-400">{row.maxDuration}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Troubleshooting Checklist -->
      <section class="space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white font-sans">
          Step-by-Step Resolution Checklist
        </h2>
        <div class="space-y-3">
          {errorData.troubleshootingChecklist.map((item, idx) => (
            <div class="flex items-start gap-3.5 p-4 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/30 shadow-sm">
              <span class="w-6 h-6 rounded-full bg-blue-50 dark:bg-emerald-500/10 text-indigo-600 dark:text-emerald-400 border border-blue-200 dark:border-emerald-500/20 text-xs font-mono font-bold flex items-center justify-center flex-shrink-0 mt-0.5">
                {idx + 1}
              </span>
              <div class="text-xs sm:text-sm text-slate-700 dark:text-zinc-300 leading-relaxed font-normal">
                {item}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Production Fix Code Snippet -->
      <section class="space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-lg sm:text-xl font-bold tracking-tight text-slate-900 dark:text-white font-sans">
            Production Code Fix Recipe
          </h2>
          <span class="text-[11px] font-mono text-emerald-600 dark:text-emerald-400">Node / Express / Python</span>
        </div>
        <div class="rounded-xl border border-slate-800 bg-[#070b14] p-4 font-mono text-xs text-emerald-400 overflow-x-auto shadow-lg">
          <pre><code>{errorData.fixCodeSnippet}</code></pre>
        </div>
      </section>

      <!-- How to Simulate in SafeWebhook -->
      <section class="p-5 sm:p-6 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 space-y-3 shadow-sm">
        <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2 font-sans">
          <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          How to Test &amp; Simulate HTTP {errorData.statusCode} in SafeWebhook
        </h2>
        <ol class="space-y-2 text-xs sm:text-sm text-slate-700 dark:text-zinc-300 list-decimal list-inside font-normal">
          {errorData.howToSimulateInSafeWebhook.map(step => (
            <li>{step}</li>
          ))}
        </ol>
      </section>

      <!-- Frequently Asked Questions -->
      <section class="space-y-4 sm:space-y-5">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white font-sans">
          Frequently Asked Questions: Webhook HTTP {errorData.statusCode}
        </h2>
        <div class="space-y-3">
          {errorData.faqs.map(faq => (
            <div class="p-5 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 space-y-2 shadow-sm">
              <h3 class="text-sm sm:text-base font-semibold text-slate-900 dark:text-white">
                {faq.q}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-zinc-400 leading-relaxed font-normal">
                {faq.a}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- CTA Box -->
      <section class="rounded-2xl border border-rose-200 dark:border-rose-500/30 bg-gradient-to-br from-rose-50 via-white to-slate-100 dark:from-[#070a12] dark:via-zinc-900/50 dark:to-zinc-950 p-6 sm:p-8 text-center space-y-4 shadow-sm">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-sans">
          Simulate HTTP {errorData.statusCode} in 1 Click
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-zinc-400 max-w-xl mx-auto font-normal">
          Test your application error resilience and webhook retry mechanisms in real-time.
        </p>
        <div>
          <a
            href="/app"
            class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold rounded-xl text-white bg-indigo-600 hover:bg-indigo-500 shadow-sm shadow-indigo-500/20 transition-all shadow-md hover:scale-105"
          >
            <span>Launch Error Simulator &rarr;</span>
          </a>
        </div>
      </section>

      <!-- Related Errors -->
      {otherErrors.length > 0 && (
        <section class="space-y-4 border-t border-slate-200 dark:border-zinc-800 pt-8">
          <h2 class="text-xs font-mono font-semibold uppercase text-slate-500 dark:text-zinc-400 tracking-wider">
            Troubleshoot Other Webhook Errors
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            {otherErrors.map(e => (
              <a
                href={`/errors/${e.slug}`}
                class="p-3.5 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/30 hover:border-indigo-600 dark:hover:border-sky-500/50 transition-all group block shadow-sm"
              >
                <div class="text-xs font-semibold text-slate-800 dark:text-zinc-200 group-hover:text-rose-600 dark:group-hover:text-rose-400 transition-colors">
                  HTTP {e.statusCode} Error Guide
                </div>
                <div class="text-[11px] text-slate-500 dark:text-zinc-400 mt-1 line-clamp-2">
                  {e.headline}
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </main>

  <Footer />
</Layout>

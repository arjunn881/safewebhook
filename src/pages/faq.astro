---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { ALL_FAQS, FAQ_CATEGORIES, generateFaqJsonLd } from "../data/faqs";

const pageTitle = "Webhook Knowledge Base & FAQ Hub — 130+ Developer Questions & Answers | SafeWebhook";
const pageDescription = "Explore 130+ technical webhook answers: What is a webhook, how to test webhooks locally without ngrok, HMAC-SHA256 signature verification, status codes, latency simulation, and platform setup guides.";
const pageUrl = "https://safewebhook.com/faq";

const faqSchema = generateFaqJsonLd(ALL_FAQS, pageUrl);

const structuredSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      headline: pageTitle,
      description: pageDescription,
      url: pageUrl,
      author: {
        "@type": "Organization",
        name: "SafeWebhook",
        url: "https://safewebhook.com"
      },
      about: {
        "@type": "Thing",
        name: "Webhook Engineering, Testing, Security & Troubleshooting"
      }
    },
    faqSchema,
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://safewebhook.com/" },
        { "@type": "ListItem", position: 2, name: "FAQ", item: pageUrl }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords="webhook faq, what is a webhook, how to test webhooks online, hmac sha256 signature verification, webhook vs api, test webhooks locally without ngrok, webhook site alternative, stripe webhook tester, github webhook payload, shopify webhook guide"
  canonicalURL={pageUrl}
  schema={structuredSchema}
>
  <Header activeNav="faq" subTitle="/ FAQ Hub" />

  <main class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 bg-developer-grid flex-1">
    <div class="max-w-5xl mx-auto space-y-12 sm:space-y-16">
      
      <!-- Hero Header -->
      <header class="text-center space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-500/20 text-xs font-mono shadow-sm">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>{ALL_FAQS.length} Verified Developer Questions &amp; Answers &bull; AEO &amp; GEO Optimized</span>
        </div>
        
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white font-sans">
          Webhook Developer FAQ &amp; Knowledge Base
        </h1>
        
        <p class="text-base sm:text-lg text-slate-600 dark:text-zinc-400 leading-relaxed font-normal max-w-3xl mx-auto">
          Comprehensive technical answers covering core webhook architecture, HMAC cryptographic security, local tunneling alternatives, latency simulation, and platform integrations.
        </p>
      </header>

      <!-- Category Quick Jumps (6 Dedicated Category Hubs) -->
      <section aria-label="FAQ Categories" class="space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xs font-mono uppercase tracking-wider text-slate-500 dark:text-zinc-400 font-semibold">
            Browse Knowledge by Topic ({FAQ_CATEGORIES.length} Categories)
          </h2>
          <span class="text-xs font-mono text-indigo-600 dark:text-indigo-400 font-semibold">
            Total {ALL_FAQS.length} Questions
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
          {FAQ_CATEGORIES.map((cat) => {
            const catCount = ALL_FAQS.filter((f) => f.category === cat.slug).length;
            return (
              <a
                href={`/faq/${cat.slug}`}
                class="p-4 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 hover:border-indigo-500/40 hover:bg-slate-50 dark:hover:bg-zinc-850/50 transition-all group flex flex-col justify-between space-y-2 shadow-sm"
              >
                <div class="flex items-center justify-between">
                  <span class="font-bold text-sm text-slate-900 dark:text-zinc-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                    {cat.shortTitle}
                  </span>
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-indigo-50 dark:bg-indigo-950/50 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800/40 font-semibold">
                    {catCount} FAQs
                  </span>
                </div>
                <p class="text-xs text-slate-500 dark:text-zinc-400 line-clamp-2 leading-relaxed font-normal">
                  {cat.description}
                </p>
                <div class="text-[11px] font-mono text-indigo-600 dark:text-indigo-400 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform pt-1">
                  <span>Explore category &rarr;</span>
                </div>
              </a>
            );
          })}
        </div>
      </section>

      <!-- Master Interactive FAQ Accordion with Live Instant Search & Filter -->
      <section aria-label="Interactive FAQ Search and Directory" class="space-y-6 pt-4 border-t border-slate-200 dark:border-zinc-800">
        <div class="text-center space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white font-sans">
            Search All {ALL_FAQS.length} Questions Live
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-zinc-400 max-w-xl mx-auto">
            Type keywords, error codes (504, 401), platforms (Stripe, Discord, Shopify), or question phrases to find instant code answers.
          </p>
        </div>

        <FaqAccordion
          faqs={ALL_FAQS}
          categories={FAQ_CATEGORIES}
          showSearch={true}
          showCategoryFilter={true}
          defaultExpandedIndex={0}
        />
      </section>

      <!-- Bottom Developer Workbench CTA -->
      <section
        class="p-6 sm:p-10 rounded-2xl border border-indigo-200 dark:border-indigo-500/30 bg-gradient-to-br from-indigo-50/50 via-white to-slate-100 dark:from-[#080b11] dark:via-zinc-900/50 dark:to-zinc-950 text-center space-y-4 shadow-sm"
      >
        <h2 class="text-xl sm:text-3xl font-bold text-slate-900 dark:text-white font-sans">
          Ready to test and debug webhooks live?
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-zinc-400 max-w-xl mx-auto font-normal leading-relaxed">
          Generate an instant secure webhook URL without signup. Inspect payloads, verify HMAC signatures, and forward events to localhost with 100% client-side privacy.
        </p>
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="/app"
            class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 text-xs font-semibold rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white transition-all shadow-md shadow-indigo-500/25 hover:scale-105"
          >
            <span>Open Free Webhook Workbench &rarr;</span>
          </a>
          <a
            href="/docs"
            class="w-full sm:w-auto inline-flex items-center justify-center px-5 py-3 text-xs font-medium rounded-xl bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 hover:bg-slate-100 dark:hover:bg-zinc-800 text-slate-800 dark:text-zinc-200 transition-colors shadow-sm"
          >
            <span>Read Edge API Documentation</span>
          </a>
        </div>
      </section>

    </div>
  </main>

  <Footer />
</Layout>

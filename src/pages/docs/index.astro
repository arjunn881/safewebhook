          <!-- Section 5: HMAC Cryptographic Verification -->
          <section id="hmac-verification" class="space-y-4 pt-8 border-t border-slate-200 dark:border-zinc-800">
            <div class="flex items-center gap-2.5">
              <span class="text-indigo-600 dark:text-indigo-400 font-mono text-sm font-bold">05</span>

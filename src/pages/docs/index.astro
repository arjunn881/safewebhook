  <!-- Interactive Scripts: Copy Helper & Live API Console -->
  <script is:inline>
    // Copy code button handler
    document.querySelectorAll('.copy-code-btn').forEach(function(btn) {
      btn.addEventListener('click', async function() {
        var code = btn.getAttribute('data-code');
        if (!code) return;
        try {
          await navigator.clipboard.writeText(code);
          var orig = btn.textContent;
          btn.textContent = 'Copied!';
          btn.classList.add('text-emerald-400');
          setTimeout(function() {
            btn.textContent = orig;
            btn.classList.remove('text-emerald-400');
          }, 2000);
        } catch (e) {}
      });
    });

    // Interactive API Console Runner
    (function() {
      var selectEl = document.getElementById('console-endpoint-select');
      var inputEl = document.getElementById('console-endpoint-input');
      var bodyWrap = document.getElementById('console-body-wrap');
      var bodyInput = document.getElementById('console-body-input');
      var execBtn = document.getElementById('console-execute-btn');
      var statusBadge = document.getElementById('console-status-badge');
      var latencyBadge = document.getElementById('console-latency-badge');
      var responseOutput = document.getElementById('console-response-output');
      var copyResBtn = document.getElementById('console-copy-response-btn');

      if (!selectEl || !execBtn) return;

      selectEl.addEventListener('change', function() {
        var val = selectEl.value;
        if (val === 'inbound') {
          if (bodyWrap) bodyWrap.classList.remove('hidden');
        } else {
          if (bodyWrap) bodyWrap.classList.add('hidden');
        }
      });

      execBtn.addEventListener('click', async function() {
        var val = selectEl.value;
        var epId = (inputEl.value || 'ep_live_demo').trim();
        var origin = window.location.origin;

        var url = '';
        var method = 'GET';
        var body = null;
        var headers = {};

        if (val === 'health') {
          url = origin + '/api/health';
        } else if (val === 'inbound') {
          url = origin + '/api/r/' + encodeURIComponent(epId);
          method = 'POST';
          headers['Content-Type'] = 'application/json';
          body = bodyInput ? bodyInput.value : '{}';
        } else if (val === 'history') {
          url = origin + '/api/history/' + encodeURIComponent(epId) + '?limit=10';
        } else if (val === 'stats') {
          url = origin + '/api/stats/' + encodeURIComponent(epId);
        } else if (val === 'openapi') {
          url = origin + '/api/openapi.json';
        }

        execBtn.disabled = true;
        execBtn.textContent = 'Running...';
        statusBadge.className = 'px-2 py-0.5 rounded text-[11px] font-bold bg-slate-100 dark:bg-zinc-800 text-slate-700 dark:text-zinc-400';
        statusBadge.textContent = 'Sending...';
        latencyBadge.textContent = '';
        responseOutput.textContent = 'Executing ' + method + ' ' + url + '...';

        var start = performance.now();

        try {
          var res = await fetch(url, {
            method: method,
            headers: headers,
            body: body
          });

          var duration = Math.round(performance.now() - start);
          var isOk = res.ok;
          var status = res.status + ' ' + res.statusText;

          statusBadge.textContent = status;
          statusBadge.className = isOk
            ? 'px-2 py-0.5 rounded text-[11px] font-bold bg-emerald-50 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/30'
            : 'px-2 py-0.5 rounded text-[11px] font-bold bg-rose-50 dark:bg-rose-500/20 text-rose-700 dark:text-rose-400 border border-rose-200 dark:border-rose-500/30';
          latencyBadge.textContent = duration + ' ms';

          var text = await res.text();
          try {
            var json = JSON.parse(text);
            responseOutput.textContent = JSON.stringify(json, null, 2);
          } catch (e) {
            responseOutput.textContent = text || '(Empty Response)';
          }
        } catch (err) {
          statusBadge.textContent = 'Failed';
          statusBadge.className = 'px-2 py-0.5 rounded text-[11px] font-bold bg-rose-50 dark:bg-rose-500/20 text-rose-700 dark:text-rose-400 border border-rose-200 dark:border-rose-500/30';
          responseOutput.textContent = 'Fetch Error: ' + err.message;
        } finally {
          execBtn.disabled = false;
          execBtn.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /></svg><span>Execute Request</span>';
        }
      });

      if (copyResBtn) {
        copyResBtn.addEventListener('click', async function() {
          try {
            await navigator.clipboard.writeText(responseOutput.textContent);
            var orig = copyResBtn.textContent;
            copyResBtn.textContent = 'Copied!';
            setTimeout(function() { copyResBtn.textContent = orig; }, 2000);
          } catch (e) {}
        });
      }
    })();
  </script>

  <Footer />
</Layout>

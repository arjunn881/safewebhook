              </ul>
            </div>

            <div class="space-y-2 pt-3 border-t border-slate-100 dark:border-zinc-800">
              <div class="font-bold uppercase tracking-wider text-slate-500 dark:text-zinc-400 text-[11px]">REST Endpoints</div>
              <ul class="space-y-1.5 text-slate-700 dark:text-zinc-300">
                <li><a href="#ep-inbound" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors block py-0.5 flex items-center justify-between"><span class="truncate">POST /api/r/:id</span><span class="text-[9px] text-emerald-600 dark:text-emerald-400 font-bold">INGEST</span></a></li>
                <li><a href="#ep-stream" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors block py-0.5 flex items-center justify-between"><span class="truncate">GET /api/stream/:id</span><span class="text-[9px] text-indigo-600 dark:text-indigo-400 font-bold">SSE</span></a></li>
                <li><a href="#ep-history" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors block py-0.5 flex items-center justify-between"><span class="truncate">GET /api/history/:id</span><span class="text-[9px] text-slate-500 dark:text-zinc-400">LOGS</span></a></li>
                <li><a href="#ep-stats" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors block py-0.5 flex items-center justify-between"><span class="truncate">GET /api/stats/:id</span><span class="text-[9px] text-purple-600 dark:text-purple-400">STATS</span></a></li>
                <li><a href="#ep-replay" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors block py-0.5 flex items-center justify-between"><span class="truncate">POST /api/replay</span><span class="text-[9px] text-violet-600 dark:text-violet-400">REPLAY</span></a></li>
                <li><a href="#ep-health" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors block py-0.5 flex items-center justify-between"><span class="truncate">GET /api/health</span><span class="text-[9px] text-emerald-600 dark:text-emerald-400">HEALTH</span></a></li>
              </ul>
            </div>

            <div class="space-y-2 pt-3 border-t border-slate-100 dark:border-zinc-800">
              <div class="font-bold uppercase tracking-wider text-slate-500 dark:text-zinc-400 text-[11px]">
                <a href="/integrations" class="hover:text-indigo-600 dark:hover:text-indigo-400">Integrations (24+) &rarr;</a>
              </div>
              <ul class="space-y-1.5 text-slate-700 dark:text-zinc-300">
                <li><a href="/test/stripe" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors block py-0.5">Stripe Webhooks</a></li>
                <li><a href="/test/openai" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors block py-0.5">OpenAI Callbacks</a></li>
                <li><a href="/test/github" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors block py-0.5">GitHub Webhooks</a></li>
                <li><a href="/test/shopify" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors block py-0.5">Shopify Webhooks</a></li>
              </ul>
            </div>

            <div class="space-y-2 pt-3 border-t border-slate-100 dark:border-zinc-800">
              <div class="font-bold uppercase tracking-wider text-slate-500 dark:text-zinc-400 text-[11px]">
                <a href="/tools" class="hover:text-indigo-600 dark:hover:text-indigo-400">Developer Tools &rarr;</a>
              </div>
              <ul class="space-y-1.5 text-slate-700 dark:text-zinc-300">
                <li><a href="/tools/mock-api-response" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors block py-0.5">Mock Status Codes</a></li>
                <li><a href="/tools/simulate-latency" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors block py-0.5">Simulate Delays</a></li>
                <li><a href="/tools/verify-signatures" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors block py-0.5">HMAC Verifier</a></li>
              </ul>
            </div>

          </div>
        </aside>

        <!-- Main Docs Content -->
        <main class="lg:col-span-9 space-y-12 sm:space-y-16">
          
          <!-- Header Hero -->
          <section class="space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-500/20 text-xs font-mono">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>Production Edge REST API &bull; v1.0.0</span>
            </div>
            <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight font-sans">
              SafeWebhook API Documentation
            </h1>
            <p class="text-slate-600 dark:text-zinc-400 text-sm sm:text-base leading-relaxed max-w-3xl font-normal">
              Complete technical reference for SafeWebhook edge endpoints. Ingest, inspect, stream, replay, and verify incoming HTTP webhooks and email payloads with sub-20ms global edge latency and zero server-side storage retention.
            </p>
            <div class="flex flex-wrap items-center gap-3 pt-2">
              <a
                href="/app"
                class="inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white transition-colors shadow-sm shadow-indigo-500/25"
              >
                <span>Open Webhook Workbench</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
              </a>
              <a
                href="/api/openapi.json"
                target="_blank"
                class="inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold rounded-lg bg-slate-100 dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 hover:bg-slate-200 dark:hover:bg-zinc-800 text-slate-800 dark:text-zinc-200 transition-colors"
              >
                <span>Download OpenAPI Spec (.json)</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
              </a>
            </div>
          </section>

          <!-- Section 1: Quickstart -->
          <section id="quickstart" class="space-y-4 pt-8 border-t border-slate-200 dark:border-zinc-800">
            <div class="flex items-center gap-2.5">
              <span class="text-indigo-600 dark:text-indigo-400 font-mono text-sm font-bold">01</span>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-sans">Quickstart in 10 Seconds</h2>
            </div>
            <p class="text-slate-600 dark:text-zinc-400 text-xs sm:text-sm leading-relaxed font-normal">
              Create an endpoint immediately without signup. Send any HTTP request (<code class="font-mono text-slate-800 dark:text-zinc-200">GET</code>, <code class="font-mono text-slate-800 dark:text-zinc-200">POST</code>, <code class="font-mono text-slate-800 dark:text-zinc-200">PUT</code>, <code class="font-mono text-slate-800 dark:text-zinc-200">DELETE</code>, <code class="font-mono text-slate-800 dark:text-zinc-200">PATCH</code>) to your endpoint URL:
            </p>

            <div class="rounded-xl border border-slate-200 dark:border-zinc-800 bg-slate-900 dark:bg-[#0b0f19] overflow-hidden shadow-sm">
              <div class="flex items-center justify-between px-4 py-2.5 bg-slate-800/80 dark:bg-[#111625] border-b border-slate-700/60 dark:border-zinc-800 text-xs font-mono text-slate-300">
                <span class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 inline-block"></span>
                  <span>cURL Inbound Webhook Test</span>
                </span>
                <button
                  type="button"
                  class="copy-code-btn px-2.5 py-1 rounded bg-slate-700 hover:bg-slate-600 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-slate-200 text-[11px] font-mono transition-colors cursor-pointer border border-slate-600/60 dark:border-zinc-700"
                  data-code={curlTestScript}
                >
                  Copy
                </button>
              </div>
              <pre class="p-4 text-emerald-400 font-mono text-xs leading-relaxed overflow-x-auto"><code>{curlTestScript}</code></pre>
            </div>
          </section>

          <!-- Section 2: Interactive Live API Console -->
          <section id="live-api-tester" class="space-y-4 pt-8 border-t border-slate-200 dark:border-zinc-800">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="text-indigo-600 dark:text-indigo-400 font-mono text-sm font-bold">02</span>
                <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-sans">Interactive API Console</h2>
              </div>
              <span class="px-2.5 py-1 rounded text-[10px] font-mono font-semibold bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/20">LIVE TESTER</span>
            </div>
            <p class="text-slate-600 dark:text-zinc-400 text-xs sm:text-sm leading-relaxed font-normal">
              Execute requests directly against the live SafeWebhook edge engine from your browser.
            </p>

            <div class="rounded-2xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 p-5 sm:p-6 space-y-4 shadow-sm">
              <div class="grid grid-cols-1 md:grid-cols-12 gap-3">
                <div class="md:col-span-4">
                  <label class="block text-[11px] font-mono uppercase text-slate-700 dark:text-zinc-300 font-semibold mb-1">Method &amp; Action</label>
                  <select id="console-endpoint-select" class="w-full h-10 px-3 rounded-lg bg-slate-50 dark:bg-zinc-950 border border-slate-300 dark:border-zinc-700 text-slate-900 dark:text-zinc-200 text-xs font-mono focus:outline-none focus:border-indigo-500 dark:focus:border-indigo-400">
                    <option value="health">GET /api/health</option>
                    <option value="inbound" selected>POST /api/r/:endpoint_id</option>
                    <option value="history">GET /api/history/:endpoint_id</option>
                    <option value="stats">GET /api/stats/:endpoint_id</option>
                    <option value="openapi">GET /api/openapi.json</option>
                  </select>
                </div>

                <div class="md:col-span-5">
                  <label class="block text-[11px] font-mono uppercase text-slate-700 dark:text-zinc-300 font-semibold mb-1">Target Endpoint ID</label>
                  <input
                    id="console-endpoint-input"
                    type="text"
                    value="ep_live_demo"
                    class="w-full h-10 px-3 rounded-lg bg-slate-50 dark:bg-zinc-950 border border-slate-300 dark:border-zinc-700 text-slate-900 dark:text-zinc-200 text-xs font-mono focus:outline-none focus:border-indigo-500 dark:focus:border-indigo-400"
                    placeholder="ep_demo_123"
                  />
                </div>

                <div class="md:col-span-3 flex items-end">
                  <button
                    id="console-execute-btn"
                    type="button"
                    class="w-full h-10 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs transition-colors flex items-center justify-center gap-2 cursor-pointer shadow-sm shadow-indigo-500/25"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /></svg>
                    <span>Execute Request</span>
                  </button>
                </div>
              </div>

              <!-- Optional Request Body for POST -->
              <div id="console-body-wrap" class="space-y-1">
                <label class="block text-[11px] font-mono uppercase text-slate-700 dark:text-zinc-300 font-semibold">Request Body (JSON)</label>
                <textarea
                  id="console-body-input"
                  rows="3"
                  class="w-full p-3 rounded-lg bg-slate-50 dark:bg-zinc-950 border border-slate-300 dark:border-zinc-700 text-slate-900 dark:text-zinc-200 text-xs font-mono focus:outline-none focus:border-indigo-500 dark:focus:border-indigo-400 resize-y"
                >{`{
  "event": "customer.subscription.created",
  "plan": "pro_annual",
  "amount": 12000,
  "currency": "usd",
  "customer": "cus_98a7b1c"
}`}</textarea>
              </div>

              <!-- Console Response Window -->
              <div class="space-y-2 pt-3 border-t border-slate-100 dark:border-zinc-800">
                <div class="flex items-center justify-between text-xs font-mono">
                  <div class="flex items-center gap-2">
                    <span class="text-slate-600 dark:text-zinc-400">Response:</span>
                    <span id="console-status-badge" class="px-2 py-0.5 rounded text-[11px] font-bold bg-slate-100 dark:bg-zinc-800 text-slate-700 dark:text-zinc-400">Ready</span>
                    <span id="console-latency-badge" class="text-slate-500 dark:text-zinc-500 text-[11px]"></span>
                  </div>
                  <button
                    id="console-copy-response-btn"
                    type="button"
                    class="text-[11px] text-indigo-600 dark:text-indigo-400 hover:underline cursor-pointer"
                  >
                    Copy Response
                  </button>
                </div>
                <pre id="console-response-output" class="p-4 rounded-xl bg-slate-900 dark:bg-[#0b0f19] border border-slate-800 dark:border-zinc-850 text-emerald-400 font-mono text-xs leading-relaxed max-h-64 overflow-y-auto">Click "Execute Request" above to test the API live.</pre>
              </div>
            </div>
          </section>


          <!-- Section 3: REST API Reference -->
          <section id="api-reference" class="space-y-8 pt-8 border-t border-slate-200 dark:border-zinc-800">
            <div class="flex items-center gap-2.5">
              <span class="text-indigo-600 dark:text-sky-400 font-mono text-sm font-bold">03</span>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-sans">REST API Specification</h2>
            </div>

            <div class="space-y-6">
              
              <!-- Inbound Receiver -->
              <div id="ep-inbound" class="p-6 rounded-2xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 space-y-4 shadow-sm">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div class="flex items-center gap-2.5">
                    <span class="px-2.5 py-1 rounded bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/20 font-mono font-bold text-xs">POST</span>
                    <span class="text-slate-900 dark:text-white font-mono font-semibold text-sm">/api/r/:endpoint_id</span>
                  </div>
                  <span class="text-slate-500 dark:text-zinc-400 text-[11px] font-mono">100 req/min &bull; Max 1MB</span>
                </div>
                <p class="text-slate-600 dark:text-zinc-400 text-xs sm:text-sm leading-relaxed font-normal">
                  Universal inbound receiver. Accepts all HTTP methods, broadcasts the payload in sub-20ms to connected SSE listeners, and stores the event in the session buffer. Returns the user-configured custom HTTP response.
                </p>
                <div class="bg-[#070b14] rounded-xl p-4 border border-[#1b263b] text-xs font-mono text-emerald-300">
                  <span class="text-slate-400"># Example Response (200 OK)</span><br />
                  {`{"success": true, "message": "Webhook received"}`}
                </div>
              </div>

              <!-- SSE Real-time Stream -->
              <div id="ep-stream" class="p-6 rounded-2xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 space-y-4 shadow-sm">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div class="flex items-center gap-2.5">
                    <span class="px-2.5 py-1 rounded bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-500/20 font-mono font-bold text-xs">GET</span>
                    <span class="text-slate-900 dark:text-white font-mono font-semibold text-sm">/api/stream/:endpoint_id</span>
                  </div>
                  <span class="text-slate-500 dark:text-zinc-400 text-[11px] font-mono">text/event-stream &bull; 50 listeners</span>
                </div>
                <p class="text-slate-600 dark:text-zinc-400 text-xs sm:text-sm leading-relaxed font-normal">
                  Opens a persistent Server-Sent Events (SSE) connection. Inbound payloads sent to the endpoint are pushed immediately as JSON frames with 25-second heartbeat pings.
                </p>
              </div>

              <!-- History API -->
              <div id="ep-history" class="p-6 rounded-2xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 space-y-4 shadow-sm">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div class="flex items-center gap-2.5">
                    <span class="px-2.5 py-1 rounded bg-slate-100 dark:bg-zinc-800 text-slate-800 dark:text-zinc-200 border border-slate-300 dark:border-zinc-700 font-mono font-bold text-xs">GET</span>
                    <span class="text-slate-900 dark:text-white font-mono font-semibold text-sm">/api/history/:endpoint_id</span>
                  </div>
                  <span class="text-slate-500 dark:text-zinc-400 text-[11px] font-mono">Query params: page, limit, method, search</span>
                </div>
                <p class="text-slate-600 dark:text-zinc-400 text-xs sm:text-sm leading-relaxed font-normal">
                  Fetches paginated captured webhook records. Supports filtering by HTTP method, keyword search in headers/body, and timestamp ranges.
                </p>
              </div>

              <!-- Stats API -->
              <div id="ep-stats" class="p-6 rounded-2xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 space-y-4 shadow-sm">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div class="flex items-center gap-2.5">
                    <span class="px-2.5 py-1 rounded bg-purple-50 dark:bg-purple-500/10 text-purple-700 dark:text-purple-400 border border-purple-200 dark:border-purple-500/20 font-mono font-bold text-xs">GET</span>
                    <span class="text-slate-900 dark:text-white font-mono font-semibold text-sm">/api/stats/:endpoint_id</span>
                  </div>
                  <span class="text-slate-500 dark:text-zinc-400 text-[11px] font-mono">Real-time Analytics</span>
                </div>
                <p class="text-slate-600 dark:text-zinc-400 text-xs sm:text-sm leading-relaxed font-normal">
                  Returns hourly event frequency, HTTP method distribution, average payload size, and detected HMAC cryptographic signature providers.
                </p>
              </div>

              <!-- SSRF-Guarded Replay API -->
              <div id="ep-replay" class="p-6 rounded-2xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 space-y-4 shadow-sm">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div class="flex items-center gap-2.5">

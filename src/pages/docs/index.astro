---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { PLATFORMS } from '../../data/platforms';

const sampleEndpoint = 'ep_live_demo';

const curlTestScript = `curl -X POST https://safewebhook.com/api/r/${sampleEndpoint} \\
  -H "Content-Type: application/json" \\
  -H "Stripe-Signature: t=1755541200,v1=98a3c4f912e742c..." \\
  -d '{"event": "payment_intent.succeeded", "amount": 4900, "currency": "usd"}'`;

const nodeForwarderScript = `// Stream Webhooks to Localhost (Zero-Install One-Liner)
import EventSource from 'eventsource';

const endpoint = '${sampleEndpoint}';
const localTarget = 'http://localhost:3000/api/webhook';

const es = new EventSource(\`https://safewebhook.com/api/stream/\${endpoint}\`);

es.onmessage = async (e) => {
  const data = JSON.parse(e.data);
  if (data.type === 'connected' || data.type === 'ping') return;
  
  console.log(\`[Received \${data.method}] Forwarding \${data.id} to \${localTarget}\`);
  await fetch(localTarget, {
    method: data.method,
    headers: data.headers,
    body: ['GET', 'HEAD'].includes(data.method) ? undefined : data.body
  });
};`;

const pythonForwarderScript = `# Stream Webhooks to Localhost via Python
import json
import requests
import sseclient

endpoint = "${sampleEndpoint}"
local_target = "http://localhost:8000/api/webhook"

response = requests.get(f"https://safewebhook.com/api/stream/{endpoint}", stream=True)
client = sseclient.SSEClient(response)

for event in client.events():
    if not event.data:
        continue
    data = json.loads(event.data)
    if data.get("type") in ["connected", "ping"]:
        continue
    
    print(f"[Received {data.get('method')}] Forwarding to {local_target}")
    requests.request(
        method=data.get("method", "POST"),
        url=local_target,
        headers=data.get("headers", {}),
        data=data.get("body", "")
    )`;

const stripeVerificationNode = `import crypto from 'crypto';

export function verifyStripeSignature(rawBody, signatureHeader, secret) {
  const parts = signatureHeader.split(',');
  const timestamp = parts.find(p => p.startsWith('t='))?.split('=')[1];
  const signature = parts.find(p => p.startsWith('v1='))?.split('=')[1];
  
  if (!timestamp || !signature) return false;
  
  const signedPayload = \`\${timestamp}.\${rawBody}\`;
  const expectedSignature = crypto
    .createHmac('sha256', secret)
    .update(signedPayload)
    .digest('hex');
    
  return crypto.timingSafeEqual(
    Buffer.from(signature, 'utf8'),
    Buffer.from(expectedSignature, 'utf8')
  );
}`;

---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { COMPETITORS, type CompetitorInfo } from '../../data/competitors';

export const prerender = false;

const { competitor } = Astro.params;
const compData: CompetitorInfo | undefined = COMPETITORS[competitor as string];

if (!compData) {
  return Astro.redirect('/vs');
}

const pageTitle = `SafeWebhook vs ${compData.name} — Feature & Privacy Comparison (2026) | SafeWebhook`;
const pageDescription = `Detailed head-to-head comparison of SafeWebhook vs ${compData.name}. Compare privacy architecture, pricing, rate limits, latency, and client-side payload inspection without accounts.`;

const structuredSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      headline: pageTitle,
      description: pageDescription,
      url: Astro.url.href,
      inLanguage: 'en',
      datePublished: '2026-08-21',
      dateModified: '2026-09-13',
      author: {
        '@type': 'Organization',
        name: 'SafeWebhook',
        url: 'https://safewebhook.com'
      },
      publisher: { '@id': 'https://safewebhook.com/#organization' }
    },
    {
      '@type': 'FAQPage',
      mainEntity: compData.faqs.map(faq => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.a
        }
      }))
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://safewebhook.com/' },
        { '@type': 'ListItem', position: 2, name: 'Alternatives', item: 'https://safewebhook.com/vs' },
        { '@type': 'ListItem', position: 3, name: `SafeWebhook vs ${compData.name}`, item: Astro.url.href }
      ]
    }
  ]
};

const otherCompetitors = Object.values(COMPETITORS)
  .filter(c => c.slug !== compData.slug)
  .slice(0, 3);
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={Astro.url.href}
  keywords={`${compData.name.toLowerCase()} alternative, free ${compData.name.toLowerCase()} alternative, safewebhook vs ${compData.name.toLowerCase()}, ${compData.name.toLowerCase()} without login, best ${compData.name.toLowerCase()} replacement`}
  schema={structuredSchema}
>
  <Header activeNav="vs" subTitle={`/ vs ${compData.name}`} />

  <main class="py-10 sm:py-16 flex-1 bg-developer-grid">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 sm:space-y-12">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs font-mono text-slate-500 dark:text-zinc-400">
        <a href="/" class="hover:text-slate-900 dark:hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/vs" class="hover:text-slate-900 dark:hover:text-white transition-colors">Alternatives</a>
        <span>/</span>
        <span class="text-indigo-600 dark:text-sky-400 font-semibold">SafeWebhook vs {compData.name}</span>
      </nav>

      <!-- Hero Header -->
      <div class="space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-500/20 font-mono">
          <span>Head-to-Head Comparison</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white font-sans">
          SafeWebhook vs <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 via-sky-600 to-blue-500 dark:from-sky-400 dark:via-blue-400 dark:to-indigo-400">{compData.name}</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-600 dark:text-zinc-400 leading-relaxed max-w-3xl font-normal">
          {compData.tagline}
        </p>
      </div>

      <!-- GEO / AEO Direct Answer / Verdict Box -->
      {compData.directAnswer && (
        <section class="rounded-xl border border-blue-200 dark:border-sky-500/30 bg-blue-50/50 dark:bg-sky-950/20 p-5 sm:p-6 backdrop-blur-sm shadow-sm">
          <div class="flex items-center gap-2 text-indigo-600 dark:text-sky-400 text-xs font-mono font-semibold uppercase tracking-wider mb-2">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Direct Answer / Executive Verdict
          </div>
          <p class="text-sm sm:text-base text-slate-800 dark:text-zinc-200 leading-relaxed font-sans font-medium">
            {compData.directAnswer}
          </p>
        </section>
      )}

      <!-- Feature Comparison Matrix Table -->
      <section class="space-y-4">
        <div class="space-y-1">
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white font-sans">
            Feature Comparison Matrix
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-zinc-400 font-normal">
            See how SafeWebhook and {compData.name} compare across privacy, pricing, and developer tools:
          </p>
        </div>

        <div class="rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 overflow-hidden shadow-sm">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead class="bg-slate-50 dark:bg-zinc-900/80 border-b border-slate-200 dark:border-zinc-800 text-slate-600 dark:text-zinc-400 font-mono text-[11px] uppercase tracking-wider">
              <tr>
                <th class="py-3 px-4 sm:px-6">Feature</th>
                <th class="py-3 px-4 sm:px-6 text-indigo-600 dark:text-sky-400 font-bold">SafeWebhook</th>
                <th class="py-3 px-4 sm:px-6 text-slate-700 dark:text-zinc-300">{compData.name}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-zinc-800/60 font-sans">
              {compData.comparisonMatrix.map((row, idx) => (
                <tr class={idx % 2 === 0 ? 'bg-slate-50/50 dark:bg-zinc-950/30' : 'bg-white dark:bg-zinc-900/20'}>
                  <td class="py-3.5 px-4 sm:px-6 font-medium text-slate-800 dark:text-zinc-200">{row.feature}</td>
                  <td class="py-3.5 px-4 sm:px-6 font-semibold text-emerald-600 dark:text-emerald-400 flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{row.safewebhook}</span>
                  </td>
                  <td class="py-3.5 px-4 sm:px-6 text-slate-600 dark:text-zinc-400">{row.competitor}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Key Pillars Breakdown -->
      <section class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
        <div class="p-4 sm:p-5 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/30 space-y-2 shadow-sm">
          <div class="text-xs font-mono uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-semibold">Pricing Advantage</div>
          <p class="text-xs sm:text-sm text-slate-700 dark:text-zinc-300 leading-relaxed font-normal">{compData.pricingDifference}</p>
        </div>
        <div class="p-4 sm:p-5 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/30 space-y-2 shadow-sm">
          <div class="text-xs font-mono uppercase tracking-wider text-indigo-600 dark:text-sky-400 font-semibold">Privacy Architecture</div>
          <p class="text-xs sm:text-sm text-slate-700 dark:text-zinc-300 leading-relaxed font-normal">{compData.privacyDifference}</p>
        </div>
        <div class="p-4 sm:p-5 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/30 space-y-2 shadow-sm">
          <div class="text-xs font-mono uppercase tracking-wider text-amber-600 dark:text-amber-400 font-semibold">Global Latency</div>
          <p class="text-xs sm:text-sm text-slate-700 dark:text-zinc-300 leading-relaxed font-normal">{compData.latencyDifference}</p>
        </div>
      </section>

      <!-- Pros vs Cons Comparison -->
      <section class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        <!-- SafeWebhook Advantages -->
        <div class="p-5 sm:p-6 rounded-xl border border-emerald-200 dark:border-emerald-500/20 bg-emerald-50/50 dark:bg-emerald-950/10 space-y-3.5 shadow-sm">
          <h3 class="text-base font-bold text-emerald-800 dark:text-emerald-400 flex items-center gap-2 font-sans">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            Why Developers Choose SafeWebhook
          </h3>
          <ul class="space-y-2 text-xs sm:text-sm text-slate-700 dark:text-zinc-300 font-normal">
            {compData.advantages.map(adv => (
              <li class="flex items-start gap-2">
                <span class="text-emerald-600 dark:text-emerald-400 font-bold">&bull;</span>
                <span>{adv}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Competitor Limitations -->
        <div class="p-5 sm:p-6 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/30 space-y-3.5 shadow-sm">
          <h3 class="text-base font-bold text-slate-800 dark:text-zinc-300 flex items-center gap-2 font-sans">
            <svg class="w-4 h-4 text-rose-500 dark:text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            {compData.name} Limitations
          </h3>
          <ul class="space-y-2 text-xs sm:text-sm text-slate-600 dark:text-zinc-400 font-normal">
            {compData.limitations.map(lim => (
              <li class="flex items-start gap-2">
                <span class="text-rose-500 dark:text-rose-400 font-bold">&bull;</span>
                <span>{lim}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Frequently Asked Questions -->
      <section class="space-y-4 sm:space-y-5">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white font-sans">
          Frequently Asked Questions: SafeWebhook vs {compData.name}
        </h2>
        <div class="space-y-3">
          {compData.faqs.map(faq => (
            <div class="p-5 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 space-y-2 shadow-sm">
              <h3 class="text-sm sm:text-base font-semibold text-slate-900 dark:text-white">
                {faq.q}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-zinc-400 leading-relaxed font-normal">
                {faq.a}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- CTA Box -->
      <section class="rounded-2xl border border-blue-200 dark:border-sky-500/30 bg-gradient-to-br from-blue-50 via-white to-slate-100 dark:from-[#070a12] dark:via-zinc-900/50 dark:to-zinc-950 p-6 sm:p-8 text-center space-y-4 shadow-sm">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white font-sans">
          Switch to SafeWebhook in 2 Seconds
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-zinc-400 max-w-xl mx-auto font-normal">
          No signups, no paywalls, zero limits. Test your webhooks with full edge power right now.
        </p>
        <div>
          <a
            href="/app"
            class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold rounded-xl text-white bg-indigo-600 hover:bg-indigo-500 shadow-sm shadow-indigo-500/20 transition-all shadow-md hover:scale-105"
          >
            <span>Launch Free Workbench &rarr;</span>
          </a>
        </div>
      </section>

      <!-- Other Comparisons -->
      {otherCompetitors.length > 0 && (
        <section class="space-y-4 border-t border-slate-200 dark:border-zinc-800 pt-8">
          <h2 class="text-xs font-mono font-semibold uppercase text-slate-500 dark:text-zinc-400 tracking-wider">
            Explore Other Webhook Tool Comparisons
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            {otherCompetitors.map(c => (
              <a
                href={`/vs/${c.slug}`}
                class="p-3.5 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/30 hover:border-indigo-600 dark:hover:border-sky-500/50 transition-all group block shadow-sm"
              >
                <div class="text-xs font-semibold text-slate-800 dark:text-zinc-200 group-hover:text-indigo-600 dark:group-hover:text-sky-400 transition-colors">
                  SafeWebhook vs {c.name}
                </div>
                <div class="text-[11px] text-slate-500 dark:text-zinc-400 mt-1 truncate">
                  {c.tagline}
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </main>

  <Footer />
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { COMPETITORS, type CompetitorComparison } from '../../data/competitors';

export const prerender = false;

const { competitor } = Astro.params;
const compData: CompetitorComparison | undefined = competitor ? COMPETITORS[competitor] : undefined;

if (!compData) {
  return Astro.redirect('/');
}

const pageTitle = `SafeWebhook vs ${compData.name} — 100% Free ${compData.name} Alternative`;
const pageDescription = `Compare SafeWebhook vs ${compData.name}. Discover why SafeWebhook is 100% free with zero paywalls, sub-20ms edge latency, and private local storage at safewebhook.com.`;

const structuredSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: `SafeWebhook vs ${compData.name} Feature & Architecture Comparison`,
  description: pageDescription,
  author: { '@type': 'Organization', name: 'SafeWebhook' },
  datePublished: '2026-08-19',
  dateModified: '2026-08-19',
  mainEntityOfPage: Astro.url.href
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={Astro.url.href}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredSchema)} />

  <!-- Header -->
  <header class="sticky top-0 z-50 w-full border-b border-slate-800 bg-slate-950/85 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 group-hover:border-cyan-400 transition-colors shadow-sm shadow-cyan-500/10">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-bold tracking-tight text-white text-base font-sans">Safe<span class="text-cyan-400">Webhook</span></span>
          <span class="text-[10px] text-slate-400 -mt-1 font-mono">vs {compData.name}</span>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
        <a href="/" class="hover:text-cyan-300 transition-colors">Home</a>
        <a href="/docs" class="hover:text-cyan-300 transition-colors">Docs</a>
        <a href="/faq" class="hover:text-cyan-300 transition-colors">FAQ</a>
      </nav>

      <a
        href="/app"
        class="inline-flex items-center justify-center px-4 py-2 text-xs font-semibold rounded-lg text-slate-950 bg-gradient-to-r from-cyan-400 to-cyan-300 hover:from-cyan-300 hover:to-cyan-200 transition-all shadow-md shadow-cyan-500/20 active:scale-95"
      >
        Launch Workbench &rarr;
      </a>
    </div>
  </header>

  <main class="py-12 sm:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-mono text-slate-400">
        <a href="/" class="hover:text-cyan-300 transition-colors">Home</a>
        <span>/</span>
        <a href="#compare" class="hover:text-cyan-300 transition-colors">Comparison</a>
        <span>/</span>
        <span class="text-cyan-400 font-semibold">vs {compData.name}</span>
      </nav>

      <!-- Hero Section -->
      <div class="space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-500/30 text-cyan-300 text-xs font-mono">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
          <span>Competitive Comparison</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight">
          SafeWebhook vs {compData.name}
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
          {compData.summary}
        </p>
      </div>

      <!-- Core Differentiator Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 font-mono text-xs">
        <div class="p-5 rounded-2xl border border-slate-800 bg-slate-900/60 space-y-2">
          <div class="text-cyan-400 font-bold uppercase text-[11px]">Pricing Model</div>
          <p class="text-slate-300 text-[11px] leading-relaxed">{compData.pricingDifference}</p>
        </div>

        <div class="p-5 rounded-2xl border border-slate-800 bg-slate-900/60 space-y-2">
          <div class="text-emerald-400 font-bold uppercase text-[11px]">Data Privacy</div>
          <p class="text-slate-300 text-[11px] leading-relaxed">{compData.privacyDifference}</p>
        </div>

        <div class="p-5 rounded-2xl border border-slate-800 bg-slate-900/60 space-y-2">
          <div class="text-purple-400 font-bold uppercase text-[11px]">Edge Latency</div>
          <p class="text-slate-300 text-[11px] leading-relaxed">{compData.latencyDifference}</p>
        </div>
      </div>

      <!-- Advantages List -->
      <section class="space-y-6 pt-8 border-t border-slate-800">
        <h2 class="text-2xl font-bold text-white">Why Developers Choose SafeWebhook</h2>
        <div class="space-y-3 font-mono text-xs">
          {compData.advantages.map(adv => (
            <div class="flex items-center gap-3 p-4 rounded-xl border border-slate-800 bg-slate-900/40 text-slate-200">
              <div class="w-5 h-5 rounded bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 flex-shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-sm font-sans">{adv}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Comparison FAQs -->
      <section class="space-y-6 pt-8 border-t border-slate-800">
        <h2 class="text-2xl font-bold text-white">Comparison FAQ</h2>
        <div class="space-y-4">
          {compData.faqs.map(faq => (
            <div class="p-5 rounded-xl border border-slate-800 bg-slate-900/60 space-y-2">
              <h3 class="font-semibold text-white text-base">{faq.q}</h3>
              <p class="text-sm text-slate-300 leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Bottom Action CTA -->
      <div class="p-8 rounded-2xl border border-cyan-500/30 bg-slate-900/90 text-center space-y-4">
        <h3 class="text-2xl font-bold text-white">Experience faster, 100% free webhook testing</h3>
        <p class="text-sm text-slate-300 max-w-lg mx-auto">
          No signups or credit cards required. Get started in 3 seconds at safewebhook.com.
        </p>
        <div class="pt-2">
          <a
            href="/app"
            class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-bold text-sm shadow-md shadow-cyan-500/20 transition-all"
          >
            Launch SafeWebhook Free &rarr;
          </a>
        </div>
      </div>

    </div>
  </main>

  <!-- Footer -->
  <footer class="py-12 border-t border-slate-800 bg-slate-950 text-slate-400 text-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <div class="w-6 h-6 rounded bg-cyan-500/20 text-cyan-400 flex items-center justify-center text-xs font-bold font-mono">
          S
        </div>
        <span class="font-semibold text-slate-200">SafeWebhook</span>
        <span class="text-xs text-slate-400">&bull; safewebhook.com &bull; vs {compData.name}</span>
      </div>

      <div class="flex items-center gap-6 text-xs">
        <a href="/" class="hover:text-cyan-300 transition-colors">Home</a>
        <a href="/docs" class="hover:text-cyan-300 transition-colors">Docs</a>
        <a href="/faq" class="hover:text-cyan-300 transition-colors">FAQ</a>
        <a href="/app" class="text-cyan-400 hover:text-cyan-300 font-semibold transition-colors">Open App &rarr;</a>
      </div>
    </div>
  </footer>
</Layout>

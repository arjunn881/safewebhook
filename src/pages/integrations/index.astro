---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { PLATFORMS } from '../../data/platforms';

export const prerender = false;

const platforms = Object.values(PLATFORMS);
const categories = Array.from(new Set(platforms.map(p => p.category)));

const pageTitle = 'Webhook Integrations & Testing Guides — 24+ Platforms | SafeWebhook';
const pageDescription = 'Browse free webhook testing guides and HMAC signature verification recipes for Stripe, GitHub, Shopify, OpenAI, WhatsApp, Telegram, Supabase, Clerk, and 24+ developer platforms.';

const structuredSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: pageTitle,
      description: pageDescription,
      url: Astro.url.href,
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: platforms.map((p, idx) => ({
          '@type': 'ListItem',
          position: idx + 1,
          name: `${p.name} Webhooks`,
          url: `https://safewebhook.com/test/${p.slug}`
        }))
      }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://safewebhook.com/' },
        { '@type': 'ListItem', position: 2, name: 'Integrations', item: Astro.url.href }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={Astro.url.href}
  keywords="webhook integrations, test webhooks, stripe webhook tester, github webhook inspector, shopify webhook debugger, verify hmac signature online"
  schema={structuredSchema}
>
  <Header activeNav="integrations" subTitle="/ Integrations" />

  <main class="py-12 sm:py-16 flex-1 bg-developer-grid">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Hero -->
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-500/20 font-mono">
          <span>24+ Supported Developer Platforms</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white font-sans">
          Webhook Testing &amp; Verification Directory
        </h1>
        <p class="text-base sm:text-lg text-slate-600 dark:text-zinc-400 leading-relaxed font-normal">
          Comprehensive testing guides, live payload inspectors, and cryptographic HMAC verification recipes for every major developer platform.
        </p>
      </div>

      <!-- Categories & Cards -->
      {categories.map(category => {
        const catPlatforms = platforms.filter(p => p.category === category);
        return (
          <section class="space-y-5">
            <div class="flex items-center justify-between border-b border-slate-200 dark:border-zinc-800 pb-3">
              <h2 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <span>{category}</span>
                <span class="text-xs font-mono text-slate-500 dark:text-zinc-400 font-normal">({catPlatforms.length})</span>
              </h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
              {catPlatforms.map(p => (
                <a
                  href={`/test/${p.slug}`}
                  class="p-5 sm:p-6 rounded-xl border border-slate-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 hover:border-indigo-600 dark:hover:border-sky-500/50 hover:shadow-md transition-all group flex flex-col justify-between space-y-4"
                >
                  <div class="space-y-2">
                    <div class="flex items-center justify-between">
                      <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-sky-400 transition-colors">
                        {p.name}
                      </h3>
                      <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-slate-100 dark:bg-zinc-950 text-slate-700 dark:text-zinc-400 border border-slate-200 dark:border-zinc-800 truncate max-w-[140px]">
                        {p.signatureHeader}
                      </span>
                    </div>
                    <p class="text-xs text-slate-600 dark:text-zinc-400 leading-relaxed line-clamp-2 font-normal">
                      {p.tagline}
                    </p>
                  </div>

                  <div class="pt-3 border-t border-slate-100 dark:border-zinc-800/60 flex items-center justify-between text-xs font-mono text-slate-500 dark:text-zinc-400 group-hover:text-slate-900 dark:group-hover:text-zinc-200">
                    <span>Inspect Payload &amp; HMAC &rarr;</span>
                    <span class="text-[10px] text-emerald-600 dark:text-emerald-400 font-semibold">Zero Signup</span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        );
      })}

    </div>
  </main>

  <Footer />
</Layout>

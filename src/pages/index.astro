const structuredSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://safewebhook.com/#website",
      url: "https://safewebhook.com/",
      name: "SafeWebhook",
      description:

                    >
                      <span>GitHub &bull; 3.8 KB</span>
                      <span class="text-sky-400">X-Hub-Sig</span>
                    </div>
                  </button>

                  <!-- Shopify Tab -->
                  <button
                    type="button"
                    data-demo-key="shopify"
                    class="hero-demo-tab w-full p-2.5 rounded-lg text-left space-y-1 border transition-all cursor-pointer bg-[#0a0f1d] border-[#1b263b] text-slate-400 hover:border-slate-600 hover:text-white"
                  >
                    <div class="flex items-center justify-between">
                      <span
                        class="px-1.5 py-0.2 rounded text-[10px] bg-amber-500/10 text-amber-400 font-bold border border-amber-500/20"
                        >POST</span
                      >
                      <span class="text-[10px] text-slate-500">1m ago</span>
                    </div>
                    <div class="font-medium truncate text-xs text-slate-300">
                      orders/create (#1092)
                    </div>
                    <div
                      class="text-[10px] text-slate-500 flex items-center justify-between"
                    >
                      <span>Shopify &bull; 2.1 KB</span>
                      <span class="text-amber-400">HMAC-Base64</span>
                    </div>
                  </button>

                  <!-- Inbound Email Tab -->
                  <button
                    type="button"
                    data-demo-key="email"
                    class="hero-demo-tab w-full p-2.5 rounded-lg text-left space-y-1 border transition-all cursor-pointer bg-[#0a0f1d] border-[#1b263b] text-slate-400 hover:border-slate-600 hover:text-white"
                  >
                    <div class="flex items-center justify-between">
                      <span
                        class="px-1.5 py-0.2 rounded text-[10px] bg-purple-500/10 text-purple-400 font-bold border border-purple-500/20"
                        >EMAIL</span
                      >
                      <span class="text-[10px] text-slate-500">3m ago</span>
                    </div>
                    <div class="font-medium truncate text-xs text-slate-300">
                      Inbound Mail Delivery
                    </div>
                    <div
                      class="text-[10px] text-slate-500 flex items-center justify-between"
                    >
                      <span>SMTP &bull; 4.6 KB</span>
                      <span class="text-purple-400">DKIM / SPF</span>
                    </div>
                  </button>
                </div>
              </div>

              <!-- Right: Formatted JSON Payload Preview with Live Copy -->
              <div class="md:col-span-7 space-y-3 overflow-x-auto">
                <div
                  class="flex items-center justify-between text-[11px] text-slate-400 border-b border-[#1b263b] pb-2"
                >
                  <div class="flex items-center gap-2">
                    <span
                      id="hero-content-type"
                      class="text-slate-300 font-mono">application/json</span
                    >
                    <span
                      id="hero-sig-header"
                      class="text-[10px] text-slate-500 font-mono"
                      >Stripe-Signature: t=1614555800...</span
                    >
                  </div>
                  <button
                    id="hero-copy-json-btn"
                    type="button"
                    class="px-2 py-0.5 rounded bg-[#131d35] hover:bg-[#1b2849] text-slate-200 border border-[#1b263b] text-[10px] font-mono cursor-pointer transition-colors"
                  >
                    Copy JSON
                  </button>
                </div>
                <pre
                  class="text-slate-200 leading-relaxed font-mono text-[11px] max-h-64 overflow-y-auto"><code id="hero-json-display" set:html={`{\n  <span class="json-key">"id"</span>: <span class="json-str">"evt_3MtwLwLkdIwHu7ix28a3tqPa"</span>,\n  <span class="json-key">"object"</span>: <span class="json-str">"event"</span>,\n  <span class="json-key">"type"</span>: <span class="json-str">"payment_intent.succeeded"</span>,\n  <span class="json-key">"data"</span>: {\n    <span class="json-key">"object"</span>: {\n      <span class="json-key">"id"</span>: <span class="json-str">"pi_3MtwLwLkdIwHu7ix28a3tqPa"</span>,\n      <span class="json-key">"amount"</span>: <span class="json-num">4900</span>,\n      <span class="json-key">"currency"</span>: <span class="json-str">"usd"</span>,\n      <span class="json-key">"status"</span>: <span class="json-str">"succeeded"</span>,\n      <span class="json-key">"customer"</span>: <span class="json-str">"cus_NFFOp39eoFndd1"</span>,\n      <span class="json-key">"payment_method"</span>: <span class="json-str">"pm_card_visa"</span>\n    }\n  }\n}`} /></pre>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. THREE CORE PILLARS / ARCHITECTURAL GUARANTEE -->
    <section
      id="security"
      class="py-14 border-t border-slate-200 dark:border-zinc-850 bg-slate-50 dark:bg-zinc-950"

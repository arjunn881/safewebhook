                      <span class="text-[10px] text-slate-400">14ms ago</span>
                    </div>
                    <div class="text-white font-medium truncate text-xs">
                      payment_intent.succeeded
                    </div>
                    <div
                      class="text-[10px] text-slate-400 flex items-center justify-between"
                    >
                      <span>Stripe &bull; 1.4 KB</span>
                      <span class="text-sky-400">HMAC-SHA256</span>
                    </div>
                  </button>

                  <!-- GitHub Tab -->
                  <button
                    type="button"
                    data-demo-key="github"
                    class="hero-demo-tab w-full p-2.5 rounded-lg text-left space-y-1 border transition-all cursor-pointer bg-[#0a0f1d] border-[#1b263b] text-slate-400 hover:border-slate-600 hover:text-white"
                  >
                    <div class="flex items-center justify-between">
                      <span
                        class="px-1.5 py-0.2 rounded text-[10px] bg-sky-500/10 text-sky-400 font-bold border border-sky-500/20"
                        >POST</span
                      >
                      <span class="text-[10px] text-slate-500">42s ago</span>
                    </div>
                    <div class="font-medium truncate text-xs text-slate-300">
                      push (refs/heads/main)
                    </div>
                    <div

      potentialAction: {
        "@type": "SearchAction",
        target: "https://safewebhook.com/integrations?q={search_term_string}",
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "WebApplication",
      "@id": "https://safewebhook.com/#webapp",
      name: "SafeWebhook",
      url: "https://safewebhook.com/",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "All",
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: "4.9",
        reviewCount: "1420",
        bestRating: "5",
        worstRating: "1",
      },
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
    },
    {
      "@type": "FAQPage",
      mainEntity: homeFaqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<Layout
  title="SafeWebhook — Free Online Webhook Tester & No-Login Request Debugger"
  description="SafeWebhook is the instant free online webhook tester with zero signup. 100% client-side payload inspector, secure private request logger, and request bin alternative for developers."
  keywords="SafeWebhook, safewebhook.com, free webhook tester, online webhook debugger, test webhooks online, webhook listener online, inspect http requests, request bin alternative free, webhook tester no login, client side webhook inspector, secure private webhook tester, stripe webhook tester, shopify webhook debugger, github webhook payload"
  schema={structuredSchema}
>
  <!-- Full-Bleed Top Background Layer (Spanning Header + Gradient + Hero) -->
  <div class="landing-top-bg-wrapper" aria-hidden="true">
    <!-- Dark Mode Telemetry Mesh -->
    <img
      src="/images/landing-hero-bg.jpg"
      alt=""
      loading="eager"
      decoding="async"
      width="1920"
      height="1080"
      class="landing-top-bg-img dark-only-img"
    />
    <!-- Bright / Light Mode Telemetry Mesh -->
    <img
      src="/images/landing-hero-bg-light.jpg"
      alt=""
      loading="eager"
      decoding="async"
      width="1920"
      height="1080"
      class="landing-top-bg-img light-only-img"
    />
    <div class="landing-top-bg-glow"></div>
    <div class="landing-top-bg-mask"></div>
  </div>

  <Header activeNav="home" transparent={true} />

  <main class="relative z-10">
    <!-- 2. HERO SECTION -->
    <section
      id="hero"
      class="relative pt-12 pb-16 md:pt-20 md:pb-24 overflow-hidden bg-developer-grid"
    >
      <div
        class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-6"

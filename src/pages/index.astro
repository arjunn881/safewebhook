---
import Layout from '../layouts/Layout.astro';
import { USE_CASES } from '../data/usecases';

const homeFaqs = [
  {
    q: 'How can I test webhooks locally without ngrok?',
    a: 'You can test webhooks locally without installing Ngrok by generating a free endpoint on SafeWebhook (safewebhook.com), adding it as your provider delivery URL, and using our built-in 1-Click Request Replay to dispatch captured payloads straight to http://localhost:8000/api/webhook.'
  },
  {
    q: 'Are online webhook testers secure for internal keys?',
    a: 'Most traditional cloud webhook tools store your API keys and sensitive customer data on central disks. SafeWebhook is a 100% Client-Side Payload Inspector that streams events in memory and stores logs solely in your local browser storage, ensuring zero persistent server storage.'
  },
  {
    q: 'Where can I view incoming JSON webhook payloads in real-time?',
    a: 'Open our free online webhook workbench at safewebhook.com/app to get an instant temporary webhook URL. Incoming JSON, XML, and form payloads from Stripe, Shopify, and GitHub will appear live in your browser over sub-20ms Server-Sent Events.'
  },
  {
    q: 'What is the best alternative to webhook.site?',
    a: 'SafeWebhook (safewebhook.com) is the top free alternative to Webhook.site. Unlike Webhook.site which locks custom responses, search, and extended storage behind $15-$45/month subscriptions, SafeWebhook provides unlimited requests, custom status codes, simulated latency, and replay 100% free with no login.'
  },
  {
    q: 'How to safely inspect Stripe webhook signatures?',
    a: 'SafeWebhook automatically extracts the timestamp (t=...) and HMAC-SHA256 signature (v1=...) from the Stripe-Signature header, and provides copy-paste verification recipes in Node.js, Python, and Go without exposing your webhook signing secret.'
  }
];
---

<Layout
  title="SafeWebhook — Free Online Webhook Tester | No-Login Request Debugger"
  description="SafeWebhook is the Zero-Login Online Webhook Tester Built for Speed. 100% client-side payload inspector, secure private webhook tester, and request bin alternative to test webhooks online at safewebhook.com."
  keywords="SafeWebhook, safewebhook.com, free webhook tester, online webhook debugger, test webhooks online, webhook listener online, inspect http requests, request bin alternative free, webhook tester no login, free webhook tool without registration, client side webhook inspector, secure private webhook tester, temporary webhook url creator, webhook.site free alternative, unlimited free webhook logger, stripe webhook tester online, shopify webhook debugger tool, github webhook simulation payload, test slack outgoing webhooks, cloudflare workers webhook capture, paypal webhook listener free"
>
  <!-- Semantic Header & Navigation -->
  <header class="sticky top-0 z-50 w-full border-b border-slate-800/80 bg-slate-950/85 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-cyan-500/20 to-teal-500/20 border border-cyan-500/40 flex items-center justify-center text-cyan-400 group-hover:border-cyan-400 transition-all shadow-sm shadow-cyan-500/20">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-bold tracking-tight text-white text-base font-sans">Safe<span class="text-cyan-400">Webhook</span></span>
          <span class="text-[10px] text-slate-400 -mt-1 font-mono">safewebhook.com</span>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
        <a href="#features" class="hover:text-cyan-300 transition-colors">Features</a>
        <a href="#security" class="hover:text-cyan-300 transition-colors">Client-Side Security</a>
        <a href="#integrations" class="hover:text-cyan-300 transition-colors">Providers</a>
        <a href="#tools" class="hover:text-cyan-300 transition-colors">Use Cases</a>
        <a href="#compare" class="hover:text-cyan-300 transition-colors">Comparison</a>
        <a href="/docs" class="hover:text-cyan-300 transition-colors">Docs</a>
        <a href="/faq" class="hover:text-cyan-300 transition-colors">FAQ</a>
      </nav>

      <div class="flex items-center gap-3">
        <a
          href="/app"
          class="relative group inline-flex items-center justify-center px-4 py-2 text-xs sm:text-sm font-bold rounded-xl text-slate-950 bg-gradient-to-r from-cyan-400 via-cyan-300 to-teal-300 hover:from-cyan-300 hover:to-teal-200 transition-all shadow-lg shadow-cyan-500/25 active:scale-95 overflow-hidden"
        >
          <span class="relative z-10 flex items-center gap-1.5 font-sans">
            Launch Workbench
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- HERO SECTION (Primary High-Impact SEO Targeting) -->
    <section id="hero" class="relative pt-16 pb-24 md:pt-24 md:pb-32 overflow-hidden bg-hero-glow bg-mesh-pattern">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
        
        <!-- Animated Status Radar Pill -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-slate-900/90 border border-cyan-500/40 text-cyan-300 text-xs font-mono mb-8 shadow-inner shadow-cyan-500/10">
          <div class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-400"></span>
          </div>
          <span>SafeWebhook • 100% Free Forever • Zero Registration • Sub-20ms Edge SSE</span>
        </div>

        <!-- High-Impact H1 Targeting -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-white max-w-5xl mx-auto leading-[1.12]">
          The Zero-Login Online Webhook Tester <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-teal-300 to-sky-300">
            Built for Speed
          </span>
        </h1>

        <!-- Subtitle Paragraph with Blue Ocean Keywords -->
        <p class="mt-6 text-base sm:text-lg md:text-xl text-slate-300 max-w-3xl mx-auto font-normal leading-relaxed">
          <strong>SafeWebhook</strong> is the ultimate <strong>free webhook tester</strong> and <strong>online webhook debugger</strong>. Inspect HTTP requests, create temporary webhook URLs, and test webhooks online with <strong>zero registration</strong>.
        </p>

        <!-- CTA Action Buttons -->
        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5">
          <a
            href="/app"
            class="group relative w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-bold text-slate-950 bg-gradient-to-r from-cyan-400 via-cyan-300 to-teal-300 hover:from-cyan-300 hover:to-teal-200 transition-all shadow-2xl shadow-cyan-500/30 transform hover:-translate-y-0.5 active:translate-y-0 text-center overflow-hidden"
          >
            <span class="absolute inset-0 w-full h-full bg-white/20 transform -skew-x-12 -translate-x-full group-hover:translate-x-full transition-transform duration-1000"></span>
            <span class="relative z-10 flex items-center gap-2">
              Create Temporary Webhook URL
              <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </span>
          </a>
          <a
            href="/docs"
            class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-4 rounded-xl text-base font-semibold text-slate-200 bg-slate-900/80 hover:bg-slate-850 border border-slate-700/80 hover:border-slate-600 transition-all text-center gap-2"
          >
            <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            Read Integration Guides &rarr;
          </a>
        </div>

        <!-- HERO VISUAL SHOWCASE: 3D Workstation Visualization with Floating Telemetry HUD -->
        <div class="mt-14 md:mt-18 max-w-5xl mx-auto relative group">
          
          <!-- Outer Ambient Shimmer Glow -->
          <div class="absolute -inset-1.5 rounded-3xl bg-gradient-to-r from-cyan-500/30 via-purple-500/20 to-teal-500/30 opacity-75 blur-xl group-hover:opacity-100 transition-all duration-700"></div>

          <!-- Main Container Frame -->
          <div class="relative rounded-2xl border border-slate-800 bg-slate-950 overflow-hidden shadow-2xl">
            
            <!-- Window Title Bar -->
            <div class="flex items-center justify-between px-4 py-3 border-b border-slate-800/80 bg-slate-900/80 backdrop-blur-md">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
                <span class="ml-3 text-xs font-mono text-slate-400">edge-router.safewebhook.com &bull; Live Telemetry</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="px-2.5 py-0.5 rounded text-[11px] font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  200 OK
                </span>
                <span class="text-xs font-mono text-slate-500 hidden sm:inline">&lt; 18ms Latency</span>
              </div>
            </div>

            <!-- High-Resolution Graphic with Telemetry HUD -->
            <div class="relative aspect-video w-full overflow-hidden bg-slate-950">
              <img
                src="/images/hero-telemetry.jpg"
                alt="SafeWebhook — Free Online Webhook Tester & Payload Inspector"
                class="w-full h-full object-cover object-center filter brightness-90 hover:scale-102 transition-transform duration-700"
                loading="eager"
              />

              <!-- Floating Animated Telemetry Card 1 (Top Left) -->
              <div class="absolute top-6 left-6 max-w-xs p-3.5 rounded-xl border border-cyan-500/40 bg-slate-950/85 backdrop-blur-md shadow-xl text-left font-mono text-xs space-y-1.5 animate-float hidden sm:block">
                <div class="flex items-center justify-between">
                  <span class="px-1.5 py-0.5 rounded text-[10px] bg-emerald-500/20 text-emerald-400 font-bold">POST</span>
                  <span class="text-[10px] text-cyan-400">12ms ago</span>
                </div>
                <div class="text-slate-200 font-semibold text-[11px] truncate">customer.subscription.created</div>
                <div class="text-[10px] text-slate-400">Stripe &bull; 1.4 KB &bull; Verified</div>
              </div>

              <!-- Floating Animated Telemetry Card 2 (Bottom Right) -->
              <div class="absolute bottom-6 right-6 max-w-xs p-3.5 rounded-xl border border-purple-500/40 bg-slate-950/85 backdrop-blur-md shadow-xl text-left font-mono text-xs space-y-1.5 animate-float-reverse hidden sm:block">
                <div class="flex items-center justify-between">
                  <span class="px-1.5 py-0.5 rounded text-[10px] bg-purple-500/20 text-purple-400 font-bold">WORKFLOW</span>
                  <span class="text-[10px] text-purple-300">Auto-Forward</span>
                </div>
                <div class="text-slate-200 text-[11px] truncate">localhost:8000/api/webhook</div>
                <div class="text-[10px] text-slate-400">Status 200 &bull; Roundtrip 16ms</div>
              </div>
            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- CONTENT BLOCK: OPTIMIZED FOR LOCAL CLIENT SECURITY (Semantic Blueprint) -->
    <section id="security" class="py-20 border-t border-slate-850 bg-slate-900/40">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="p-8 sm:p-12 rounded-3xl border border-cyan-500/30 bg-slate-950/80 shadow-2xl space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-mono">
            <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span>SafeWebhook — Secure Private Webhook Tester</span>
          </div>

          <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-white">
            Why a 100% Client-Side Webhook Listener?
          </h2>

          <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
            Unlike other tools that store private API logs on a cloud database, this <strong>free webhook tool without registration</strong> caches intercepted data streams directly inside your local browser storage. It is the ultimate <strong>request bin alternative</strong> to securely <strong>test webhooks online</strong> from <strong>Stripe, Shopify, and GitHub</strong> at <strong>safewebhook.com</strong>.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 font-mono text-xs text-slate-300">
            <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-1">
              <div class="text-cyan-400 font-bold">Client-Side Storage</div>
              <p class="text-[11px] text-slate-400">Logs remain strictly in your browser LocalStorage.</p>
            </div>
            <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-1">
              <div class="text-emerald-400 font-bold">Unlimited Free Logging</div>
              <p class="text-[11px] text-slate-400">Zero artificial request throttling or caps.</p>
            </div>
            <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-1">
              <div class="text-purple-400 font-bold">Zero Registration</div>
              <p class="text-[11px] text-slate-400">No passwords, emails, or signups required.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ARCHITECTURE & EDGE PIPELINE SECTION -->
    <section id="architecture" class="py-24 border-t border-slate-850 bg-slate-950/90 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          <div class="lg:col-span-6 space-y-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-mono">
              <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
              <span>Cloudflare Workers Webhook Capture</span>
            </div>
            
            <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white leading-tight">
              Global Edge Ingestion with Instant Localhost Forwarding
            </h2>
            
            <p class="text-slate-300 text-base leading-relaxed">
              When webhooks hit our 300+ global Cloudflare edge points, payloads are processed in memory and streamed directly down into your browser over native Server-Sent Events (SSE).
            </p>

            <div class="space-y-3 font-mono text-xs text-slate-300">
              <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-900/60 border border-slate-800">
                <div class="w-6 h-6 rounded-lg bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 flex-shrink-0">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                </div>
                <span>Sub-20ms worldwide edge delivery with zero disk writes</span>
              </div>

              <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-900/60 border border-slate-800">
                <div class="w-6 h-6 rounded-lg bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-purple-400 flex-shrink-0">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                </div>
                <span>Automated proxy replay to localhost:8000 with live latency metrics</span>
              </div>

              <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-900/60 border border-slate-800">
                <div class="w-6 h-6 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 flex-shrink-0">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                </div>
                <span>End-to-end TLS 1.3 encryption and automatic signature validation</span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-6">
            <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-2 overflow-hidden shadow-2xl">
              <img
                src="/images/edge-pipeline.jpg"
                alt="SafeWebhook Edge Webhook Routing Pipeline"
                class="rounded-xl w-full h-auto object-cover"
                loading="lazy"
              />
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- PROVIDER-SPECIFIC INTEGRATIONS GRID (Targeted Integration Keywords) -->
    <section id="integrations" class="py-24 border-t border-slate-850 bg-slate-950/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
          <div class="text-cyan-400 text-xs font-mono uppercase tracking-widest font-semibold">Dedicated Testing Portals</div>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">
            Tested &amp; Verified for Major API Providers
          </h2>
          <p class="text-slate-300 text-base">
            Inspect payloads, verify cryptographic signatures, and simulate provider events.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          
          <!-- Stripe -->
          <a href="/test/stripe" class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-cyan-500/40 transition-all glow-card group block space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-cyan-400 font-bold uppercase">Stripe Integration</span>
              <span class="text-[10px] font-mono text-slate-500">Stripe-Signature</span>
            </div>
            <h3 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors">Stripe Webhook Tester Online</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Test Stripe payments, verify HMAC signatures, and simulate charge events locally without Stripe CLI.</p>
          </a>

          <!-- Shopify -->
          <a href="/test/shopify" class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-cyan-500/40 transition-all glow-card group block space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-emerald-400 font-bold uppercase">Shopify Integration</span>
              <span class="text-[10px] font-mono text-slate-500">X-Shopify-Hmac</span>
            </div>
            <h3 class="text-lg font-bold text-white group-hover:text-emerald-300 transition-colors">Shopify Webhook Debugger Tool</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Debug orders/create and fulfillment webhooks with Base64 HMAC validation and zero rate limits.</p>
          </a>

          <!-- GitHub -->
          <a href="/test/github" class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-cyan-500/40 transition-all glow-card group block space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-purple-400 font-bold uppercase">GitHub Integration</span>
              <span class="text-[10px] font-mono text-slate-500">X-Hub-Signature-256</span>
            </div>
            <h3 class="text-lg font-bold text-white group-hover:text-purple-300 transition-colors">GitHub Webhook Simulation Payload</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Inspect push, pull request, and release triggers with instant SHA256 verification recipes.</p>
          </a>

          <!-- Slack -->
          <a href="/test/slack" class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-cyan-500/40 transition-all glow-card group block space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-amber-400 font-bold uppercase">Slack Integration</span>
              <span class="text-[10px] font-mono text-slate-500">X-Slack-Signature</span>
            </div>
            <h3 class="text-lg font-bold text-white group-hover:text-amber-300 transition-colors">Test Slack Outgoing Webhooks</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Inspect slash commands, block actions, and respond to URL verification challenges effortlessly.</p>
          </a>

          <!-- PayPal -->
          <a href="/test/paypal" class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-cyan-500/40 transition-all glow-card group block space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-sky-400 font-bold uppercase">PayPal Integration</span>
              <span class="text-[10px] font-mono text-slate-500">PAYPAL-AUTH-ALGO</span>
            </div>
            <h3 class="text-lg font-bold text-white group-hover:text-sky-300 transition-colors">PayPal Webhook Listener Free</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Simulate IPN and Checkout capture events with certificate transmission validation.</p>
          </a>

          <!-- Discord -->
          <a href="/test/discord" class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-cyan-500/40 transition-all glow-card group block space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-teal-400 font-bold uppercase">Discord Integration</span>
              <span class="text-[10px] font-mono text-slate-500">Ed25519 Signature</span>
            </div>
            <h3 class="text-lg font-bold text-white group-hover:text-teal-300 transition-colors">Discord Interaction Debugger</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Inspect Bot slash commands and channel webhooks with Ed25519 cryptographic validation.</p>
          </a>

        </div>
      </div>
    </section>


            class="w-full sm:w-auto inline-flex items-center justify-center px-5 py-3 rounded-xl text-sm font-medium text-slate-700 dark:text-zinc-300 bg-white dark:bg-zinc-900 hover:bg-slate-100 dark:hover:bg-zinc-800 border border-slate-200 dark:border-zinc-800 hover:border-slate-300 dark:hover:border-zinc-700 transition-colors shadow-sm"
          >
            <span>Browse 24+ Integrations</span>

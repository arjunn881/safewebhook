            >
              Developer Utilities
            </div>
            <h2
              class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white"
            >
              Built for Modern Webhook Workflows
            </h2>
            <p class="text-slate-600 dark:text-zinc-400 text-sm">
              Explore purpose-built tools to test, simulate, and verify webhooks
              locally and in staging.
            </p>
          </div>
          <a
            href="/tools"
            class="text-xs font-mono text-indigo-600 dark:text-sky-400 hover:underline flex items-center gap-1 font-semibold"
          >
            <span>View All 12 Tools &rarr;</span>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {
            featuredTools.map((tool) => (
              <a

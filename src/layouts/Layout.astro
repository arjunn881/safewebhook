---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  robots?: string;
  schema?: Record<string, unknown> | Array<unknown>;
  googleSiteVerification?: string;
}

const {
  title = 'SafeWebhook — Free Online Webhook Tester & No-Login Request Debugger',
  description = 'SafeWebhook is the instant free online webhook tester with zero signup. 100% client-side payload inspector, secure private webhook tester, and request bin alternative to test webhooks online.',
  keywords = 'SafeWebhook, safewebhook.com, free webhook tester, online webhook debugger, test webhooks online, webhook listener online, inspect http requests, request bin alternative free, webhook tester no login, client side webhook inspector, secure private webhook tester, temporary webhook url creator, webhook.site free alternative, unlimited free webhook logger, stripe webhook tester online, shopify webhook debugger tool, github webhook simulation payload, test slack outgoing webhooks, cloudflare workers webhook capture, paypal webhook listener free',
  canonicalURL,
  ogImage = '/images/hero-telemetry.jpg',
  ogType = 'website',
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  schema,
  googleSiteVerification = import.meta.env.GOOGLE_SITE_VERIFICATION || '',
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : (Astro.url ? Astro.url.origin : 'https://safewebhook.com');
const canonical = canonicalURL || new URL(Astro.url.pathname, siteUrl).toString();
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

const defaultStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'SafeWebhook',
      description: description,
      inLanguage: 'en',
      publisher: { '@id': `${siteUrl}/#organization` },
      potentialAction: {
        '@type': 'SearchAction',
        target: `${siteUrl}/integrations?q={search_term_string}`,
        'query-input': 'required name=search_term_string'
      },
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['.speakable-answer', '.speakable-description']
      }
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'SafeWebhook',
      url: siteUrl,
      logo: `${siteUrl}/favicon.svg`,
      foundingDate: '2026',
      email: 'support@safewebhook.com',
      description: 'SafeWebhook is the zero-login, privacy-first developer platform for testing, debugging, and simulating inbound HTTP webhooks in real time at the Cloudflare edge.',
      knowsAbout: [
        'Webhook Testing',
        'HMAC Signature Verification',
        'HTTP Payload Inspection',
        'Cryptographic Security',
        'Developer Tools',
        'Cloudflare Workers',
        'Server-Sent Events'
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'technical support',
        email: 'support@safewebhook.com',
        availableLanguage: 'English'
      },
      sameAs: [
        'https://github.com/safewebhook',
        'https://twitter.com/safewebhook',
        'https://www.linkedin.com/company/safewebhook'
      ]
    },
    {
      '@type': 'WebApplication',
      '@id': `${siteUrl}/#webapp`,
      name: 'SafeWebhook',
      alternateName: 'SafeWebhook — Zero-Login Request Debugger & Client-Side Webhook Listener',
      url: siteUrl,
      description: description,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'All',
      keywords: keywords,
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: '4.9',
        reviewCount: '1240',
        bestRating: '5',
        worstRating: '1'
      },
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD'
      },
      featureList: [
        'SafeWebhook Free Online Webhook Tester with zero signup required',
        'No-Login Webhook Debugger for Stripe, GitHub, Shopify, and OpenAI',
        '100% Client-Side Payload Inspector with live header breakdown',
        'Private Local-Only Request Logging with zero persistent server storage',
        'Custom HTTP Status Code & Response Simulator (200, 201, 400, 500)',
        'Simulated Latency Engine (0-5000ms delay)',
        '1-Click Request Replay to Localhost without Ngrok',
        'Inbound Email Webhook Ingestion & Parser'
      ]
    }
  ]
};

const finalStructuredData = schema || defaultStructuredData;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-00WEF01D0Z"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-00WEF01D0Z');
    </script>

    <!-- Resource Hints & Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- Essential Meta Tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="generator" content={Astro.generator} />
    <!-- Favicon & Touch Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="alternate" type="application/rss+xml" title="SafeWebhook Feed" href="/feed.xml" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="SafeWebhook" />
    <meta name="robots" content={robots} />
    <meta name="rating" content="general" />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}

    <!-- Generative Engine Optimization (GEO) & AEO Meta Hints -->
    <meta name="ai-content-declaration" content="developer-documentation" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Mobile & Display Configurations -->
    <meta name="theme-color" content="#070a12" />
    <meta name="color-scheme" content="dark" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="SafeWebhook" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- JSON-LD Structured Data Schema -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(finalStructuredData)} />

    <!-- Immediate Theme Initialization Script (Zero-Flicker) -->
    <script is:inline>
      (function() {
        try {
          var theme = localStorage.getItem('safewebhook_theme') || 'obsidian';
          document.documentElement.setAttribute('data-theme', theme);
          if (theme === 'bright' || theme === 'light') {
            document.documentElement.classList.remove('dark');
            document.documentElement.classList.add('light');
          } else {
            document.documentElement.classList.add('dark');
            document.documentElement.classList.remove('light');
          }
        } catch(e) {}
      })();
    </script>
  </head>
  <body class="font-sans antialiased min-h-screen flex flex-col overflow-x-hidden" style="background-color: var(--bg-base); color: var(--text-primary);">
    <slot />
  </body>
</html>

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "safewebhook",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },

  // ─── Custom Domain Routes for Production ─────────────────────────────────────
  "routes": [
    {
      "pattern": "safewebhook.com",
      "custom_domain": true
    },
    {
      "pattern": "www.safewebhook.com",
      "custom_domain": true
    }
  ],

  // ─── Cloudflare D1 SQLite Database ──────────────────────────────────────────
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "safewebhook-db",
      "database_id": "59d0d05a-024a-43b8-9dd8-61731614c71d"
    }
  ],

  // ─── Cloudflare KV Namespace ─────────────────────────────────────────────────
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "b4178d2148c8422ea809894403de21b8"
    }
  ],

  // ─── Environment Variables ───────────────────────────────────────────────────
  "vars": {
    "APP_ENV": "production",
    "APP_VERSION": "1.0.0"
  }
}

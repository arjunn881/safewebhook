# =========================================================================
# SafeWebhook - Comprehensive Git Ignore
# =========================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs & Generated Assets
dist/
build/
out/
.astro/

# Cloudflare Workers & Wrangler Local State
.wrangler/
.mf/

# Environment Variables & Private Credentials
.env
.env.*
!.env.example
.dev.vars

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Diagnostic & Test Coverage
coverage/
.nyc_output/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Specific Folders
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.tmp
*.bak

# Optional VS Code config (ignore workspace user state, keep recommended configs)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
